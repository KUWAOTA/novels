  <diagram id="v7-1" name="01｜因果・価値・サブプロット">
    <mxGraphModel dx="1840" dy="2110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="2110" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
