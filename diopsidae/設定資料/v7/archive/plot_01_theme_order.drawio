                </mxCell>
                <mxCell id="n39" parent="n38" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#3D1F5C;align=left;verticalAlign=middle;spacing=8;fontStyle=1;fillColor=none;strokeColor=none;" value="女性二人案｜退けず、試してよい" vertex="1">
