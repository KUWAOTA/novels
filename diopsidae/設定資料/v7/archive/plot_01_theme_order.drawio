                    <mxGeometry height="32" width="631" x="12" y="7" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="beat-2" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#1B3A5C;align=left;verticalAlign=middle;spacing=8;fillColor=none;strokeColor=none;" value="社会人になっても説明が伝わらず、評価されない。&#xa;理論を学ぶと、曖昧な人の振る舞いが読める。" vertex="1">
