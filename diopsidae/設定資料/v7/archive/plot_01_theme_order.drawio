                <mxCell id="n9" parent="beat-0" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#1B3A5C;align=left;verticalAlign=middle;spacing=8;fontStyle=1;fillColor=none;strokeColor=none;" value="00｜論理で世界がほどける〈先出し〉" vertex="1">
                    <mxGeometry height="32" width="631" x="12" y="7" as="geometry"/>
