                <mxCell id="n39" parent="n37" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="頷きには、承認を守る働きもあった。&#xa;樹の親切も、相手には圧力だった。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e40" edge="1" parent="1" source="n31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#D99032;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n34">
