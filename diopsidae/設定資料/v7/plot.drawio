                <mxCell id="n1" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=32;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="wを、人物の欲求と出来事の因果に乗せる" vertex="1">
