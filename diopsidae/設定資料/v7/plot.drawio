                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n36" parent="n34" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="単独試行に来ず、秀斗が指導を止める。&#xa;評価を失う恐れと望みが言葉になる。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n37" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
