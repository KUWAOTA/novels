                <mxCell id="n29" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="140" width="600" x="60" y="720" as="geometry"/>
                </mxCell>
                <mxCell id="n30" parent="n29" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="言葉のハシゴで、世界が開けた" vertex="1">
                    <mxGeometry height="40" width="572" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n31" parent="n29" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="体系だった言葉を得ると、仕事が通った。&#xa;再現できることと、見通せることに救われた。" vertex="1">
                    <mxGeometry height="75" width="572" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n32" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="言葉が見通しと行動を変える。&#xa;発見そのものにも、楽しさがある。" vertex="1">
                    <mxGeometry height="140" width="580" x="720" y="720" as="geometry"/>
                </mxCell>
                <UserObject label="w02｜言葉で霧が晴れる&#xa;w03・w04・w12｜使う・試す・楽しむ" link="data:page/id,yxw-03" id="n33">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" vertex="1">
