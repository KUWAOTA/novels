                </mxCell>
                <mxCell id="n52" parent="n50" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="思考しか頼れない自分の条件が見える。&#xa;怒りや傷も抱え、要求を作り直す。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e53" edge="1" parent="1" source="n44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#9270B3;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n47">
