                <mxCell id="n42" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="C｜分析の目が自分にも返る〈S07〉" vertex="1">
                    <mxGeometry height="40" width="1320" x="60" y="1065" as="geometry"/>
                </mxCell>
                <mxCell id="n43" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w08・w09" vertex="1">
                    <mxGeometry height="40" width="430" x="1390" y="1065" as="geometry"/>
                </mxCell>
                <mxCell id="n44" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="60" y="1125" as="geometry"/>
                </mxCell>
                <mxCell id="n45" parent="n44" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="自分には当然の要求" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n46" parent="n44" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="考えれば済むのに、と樹は憤る。&#xa;自分を救った道を、全員に求める。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n47" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="660" y="1125" as="geometry"/>
                </mxCell>
                <mxCell id="n48" parent="n47" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="違う条件が、行動に現れる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n49" parent="n47" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="秀斗は考え込まずに現場を調整できる。&#xa;樹には難しいやり方が、相手には楽。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n50" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="1260" y="1125" as="geometry"/>
                </mxCell>
                <mxCell id="n51" parent="n50" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="自分の意味も変わる" vertex="1">
