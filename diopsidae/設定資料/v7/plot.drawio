                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#344456;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DBE3;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="48" width="238" x="1325" y="130" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="07 配置表" link="data:page/id,yxw-07" id="n9">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#344456;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DBE3;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="48" width="238" x="1578" y="130" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="n10" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#264D32;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E9F4ED;strokeColor=#6B9F7A;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="220" width="560" x="60" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#264D32;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="創作する動機Y〈合意した起点〉" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#264D32;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="自分の空想が形になること、&#xa;その世界が誰かの楽しみにもなること自体が&#xa;嬉しい。&#xa;&#xa;作ること・楽しまれることへの喜び。" vertex="1">
                    <mxGeometry height="155" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n13" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#264D32;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E9F4ED;strokeColor=#6B9F7A;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="220" width="560" x="660" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#264D32;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="このWを選ぶ動機〈今回の補足〉" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#264D32;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="自分の経てきた経験や、獲得した価値観だから、&#xa;この世界を、他の空想より強く伝えたい。&#xa;&#xa;作者の補足を要約した表現。" vertex="1">
                    <mxGeometry height="155" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n16" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="220" width="560" x="1260" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="n16" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="X → Wの選択に働く理由" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n18" parent="n16" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="創作の喜びと、この視界への強い思いが重なる。&#xa;経験を通って獲得した見え方を、&#xa;読者が冒険できる世界として作る。&#xa;&#xa;W・w・出来事の採否にも、この理由を通す。" vertex="1">
                    <mxGeometry height="155" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n19" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="作者の経験・獲得した価値観〈要約〉" vertex="1">
                    <mxGeometry height="40" width="600" x="60" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="n20" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="そこから作りたい、世界の性質" vertex="1">
                    <mxGeometry height="40" width="580" x="720" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="n21" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="具体的な体験wへ" vertex="1">
                    <mxGeometry height="40" width="460" x="1360" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="n22" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="s" vertex="1">
                    <mxGeometry height="140" width="600" x="60" y="550" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="n22" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="空気を読めず、やり方も教わらない" vertex="1">
                    <mxGeometry height="40" width="572" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n24" parent="n22" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="反応の理由がわからず、困っていた。&#xa;見えていない規則を、自分で探してきた。" vertex="1">
                    <mxGeometry height="75" width="572" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n25" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="表面だけでは、仕組みが見えない。&#xa;観測と仮説で、少しずつ探れる。" vertex="1">
                    <mxGeometry height="140" width="580" x="720" y="550" as="geometry"/>
                </mxCell>
                <UserObject label="w01｜理由のわからない教室&#xa;w04｜規則を試す楽しさ" link="data:page/id,yxw-03" id="n26">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="140" width="460" x="1360" y="550" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="e27" edge="1" parent="1" source="n22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A7FB5;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n25">
