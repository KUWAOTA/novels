                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n50" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="140" width="600" x="60" y="1230" as="geometry"/>
                </mxCell>
                <mxCell id="n51" parent="n50" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="考えない相手への怒りが、自分に返る" vertex="1">
                    <mxGeometry height="40" width="572" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n52" parent="n50" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="相手を思考の放棄だと責めたくなる。&#xa;自分は、思考以外の道を見られていなかった。" vertex="1">
                    <mxGeometry height="75" width="572" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n53" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="判断する自分も、世界の内側にいる。&#xa;価値判断にも、その人の条件がある。" vertex="1">
                    <mxGeometry height="140" width="580" x="720" y="1230" as="geometry"/>
                </mxCell>
                <UserObject label="w08｜分析する自分も見える&#xa;w09｜怒る自分のままならなさ" link="data:page/id,yxw-03" id="n54">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="140" width="460" x="1360" y="1230" as="geometry"/>
                    </mxCell>
                </UserObject>
