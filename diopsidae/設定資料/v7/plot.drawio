                </mxCell>
                <mxCell id="n55" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="D｜見取り図を使って選ぶ〈S08 → S09〉" vertex="1">
                    <mxGeometry height="40" width="1320" x="60" y="1375" as="geometry"/>
                </mxCell>
                <mxCell id="n56" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w06・w10・w11" vertex="1">
                    <mxGeometry height="40" width="430" x="1390" y="1375" as="geometry"/>
                </mxCell>
                <mxCell id="n57" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="60" y="1435" as="geometry"/>
                </mxCell>
                <mxCell id="n58" parent="n57" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="目標の範囲が変わる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n59" parent="n57" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="速く移管する、に加え、品質・負荷・&#xa;二人の望みを同じ見取り図へ載せる。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n60" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="660" y="1435" as="geometry"/>
                </mxCell>
                <mxCell id="n61" parent="n60" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="試して、代価を知る" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n62" parent="n60" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="役割を分ければ動くが、検証に時間が要る。&#xa;二つの案が、異なる利益を守る。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n63" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="1260" y="1435" as="geometry"/>
                </mxCell>
                <mxCell id="n64" parent="n63" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="視界が、選択を変える" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n65" parent="n63" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="樹も秀斗も望みを言い、案を選ぶ。&#xa;言葉で見えた条件が、仕事の形になる。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e66" edge="1" parent="1" source="n57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n60">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e67" edge="1" parent="1" source="n60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n63">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n68" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="160" width="850" x="60" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="n69" parent="n68" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="全編で繰り返す小さな冒険" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n70" parent="n68" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="観測 → 仮説 → 予測 → 行動 → 結果 → 修正。&#xa;何が事実で、どこからが仮説かを言葉で分ける。&#xa;読者が次の場面で使える区別を、一つずつ渡す。" vertex="1">
                    <mxGeometry height="95" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n71" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="160" width="850" x="970" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="n72" parent="n71" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="結末でも、世界の解像度は保つ" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n73" parent="n71" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="S10でも、違いを見分けて確かめる楽しさを描く。&#xa;相手の事情を知っても、過去の傷と責任は残る。&#xa;怒りや不明点も含めて、人と世界を面白がれる。" vertex="1">
                    <mxGeometry height="95" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="yxw-06" name="06｜副線・危機・不可逆な決着">
        <mxGraphModel dx="5100" dy="2221" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="2280" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=32;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="二人の欲求が衝突し、二人の選択で決着する" vertex="1">
                    <mxGeometry height="52" width="1760" x="60" y="24" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="この仕事・進路の設定は仮例。wを実現する機能を保ちながら、別の出来事へ差し替えられる。" vertex="1">
                    <mxGeometry height="33" width="1760" x="60" y="80" as="geometry"/>
