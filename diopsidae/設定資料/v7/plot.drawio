                <mxCell id="n10" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="60" y="215" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="主人公の欲求〈仮〉" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="人間の規則を解き、居場所を守る。&#xa;進学 → 職場の信頼 → 移管の成功。&#xa;局面ごとの目標を追って行動する。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n13" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="660" y="215" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="価値と統制概念〈因果形の仮説〉" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="価値軸〈仮〉｜孤立 − ⇄ 協働 ＋&#xa;自他の条件を受け取り、働き方を共に作ると、&#xa;孤立が、望みを言える協働へ変わる。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n16" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="1260" y="215" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="n16" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="対立する考えにも、成功を与える" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n18" parent="n16" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="自分を救った方法なら、他人にも渡せる。&#xa;実際に、成果と信頼を得る。&#xa;相手の条件を読まずに要求すると破綻する。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n19" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="S00｜短い分析ノートで見方を予告 → 本編は中学から時系列。成人場面の先出し・時間バックは置かない。" vertex="1">
                    <mxGeometry height="80" width="1760" x="60" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="n20" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="マッキー上の役割" vertex="1">
                    <mxGeometry height="38" width="190" x="60" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="n21" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="行動 → 相手・世界の反応 → 次の行動" vertex="1">
                    <mxGeometry height="38" width="930" x="280" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="n22" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="価値の変化／読者が経験するw" vertex="1">
                    <mxGeometry height="38" width="550" x="1270" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="第1幕&#xa;契機事件" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="S01" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="n25" parent="S01" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S01｜父の死で、居場所を守る課題が生まれる" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n26" parent="S01" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="教室の反応が読めず、父とだけは一緒に考えられた。&#xa;父を失い、人間の規則を自分で解こうとする。&#xa;相談の足場を失った樹は、分析ノートを使い始める。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n27" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="n28" parent="n27" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="父とのつながり＋ → 孤立−" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n29" parent="n27" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w01・w04・w07・w12&#xa;問い：一人で、どう生きていく？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n30" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="だから、仮説を教室で試す。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="758" as="geometry"/>
                </mxCell>
                <mxCell id="n31" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="第1幕末&#xa;最初の転換" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="786" as="geometry"/>
                </mxCell>
                <mxCell id="S02" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="786" as="geometry"/>
                </mxCell>
                <mxCell id="n33" parent="S02" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S02｜仮説が人を傷つけ、学力へ逃げ道を求める" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n34" parent="S02" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="秀斗の怒りを説明すると、見下しと受け取られる。&#xa;秀斗は教室での優位を使い、樹をさらに傷つける。&#xa;樹は母の支援を使って進学し、新しい所属を得る。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n35" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="786" as="geometry"/>
                </mxCell>
                <mxCell id="n36" parent="n35" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="教室で孤立− → 進学の所属＋" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n37" parent="n35" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w01・w04・w07・w09&#xa;問い：賢くなれば、居場所は守れる？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e38" edge="1" parent="1" source="S01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A7FB5;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S02">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n39" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="成功した方法を職場でも使う。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="944" as="geometry"/>
                </mxCell>
                <mxCell id="n40" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="第2幕&#xa;対立の再燃" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="972" as="geometry"/>
                </mxCell>
                <mxCell id="S03" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="972" as="geometry"/>
                </mxCell>
                <mxCell id="n42" parent="S03" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S03｜正解を出しても、職場では伝わらない" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n43" parent="S03" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="正しい内容を出すが、「話が論理的でない」と退けられる。&#xa;勉強を軽く見る相手に腹を立て、さらに説明を重ねる。&#xa;反応が悪化し、通じる条件を学び直さざるを得ない。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n44" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="972" as="geometry"/>
                </mxCell>
                <mxCell id="n45" parent="n44" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="所属への期待＋ → 不信・孤立−" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n46" parent="n44" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w01・w02・w04・w08&#xa;問い：同じ内容なのに、何が違う？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e47" edge="1" parent="1" source="S02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A7FB5;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S03">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n48" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="伝わらない理由を分けて試す。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="1130" as="geometry"/>
                </mxCell>
                <mxCell id="n49" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="第2幕末&#xa;本物の獲得" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="1158" as="geometry"/>
                </mxCell>
                <mxCell id="S04" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="1158" as="geometry"/>
                </mxCell>
                <mxCell id="n51" parent="S04" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S04｜論理のメガネで、仕事と世界が変わる" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n52" parent="S04" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="内容・意図・相手の前提を分け、同じ報告を作り直す。&#xa;判断を引き出せるようになり、協働と成果を得る。&#xa;再現できる喜びから、他人にもこの方法を渡そうとする。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n53" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="1158" as="geometry"/>
                </mxCell>
                <mxCell id="n54" parent="n53" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="不全− → 成果・協働＋" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n55" parent="n53" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w02・w03・w04・w10・w12&#xa;問い：この見方で、もっと進める？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e56" edge="1" parent="1" source="S03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A7FB5;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S04">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n57" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="成功により、指導する側へ進む。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="1316" as="geometry"/>
                </mxCell>
                <mxCell id="n58" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="第3幕&#xa;副線との合流" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="1344" as="geometry"/>
                </mxCell>
                <mxCell id="S05" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="1344" as="geometry"/>
                </mxCell>
                <mxCell id="n60" parent="S05" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S05｜秀斗と再会し、自分を救った方法を渡す" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n61" parent="S05" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="移管責任者として、秀斗の単独担当化を引き受ける。&#xa;秀斗も昇進を望み、指導の下でチームの成果が上がる。&#xa;頷きを習得と読み、説明と訓練をさらに増やす。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n62" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="1344" as="geometry"/>
                </mxCell>
                <mxCell id="n63" parent="n62" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="警戒− → 見かけの協力＋" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n64" parent="n62" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w03・w05・w07・w08・w10&#xa;問い：あの相手とも、うまく働ける？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e65" edge="1" parent="1" source="S04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#D99032;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S05">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n66" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="習得したと考え、責任を渡す。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="1502" as="geometry"/>
                </mxCell>
                <mxCell id="n67" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="第3幕末&#xa;期待の破裂" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="1530" as="geometry"/>
                </mxCell>
                <mxCell id="S06" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="1530" as="geometry"/>
                </mxCell>
                <mxCell id="n69" parent="S06" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S06｜「わかった」はずの相手が、来ない" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n70" parent="S06" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="共同作業ではできた秀斗が、単独試行に来ない。&#xa;秀斗は「この指導は続けられない」と、自分から止める。&#xa;移管と異動が危うくなり、従来の教え方では進めなくなる。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n71" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="1530" as="geometry"/>
                </mxCell>
                <mxCell id="n72" parent="n71" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="順調＋ → 関係・案件の停止−" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n73" parent="n71" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w05・w06・w07・w09&#xa;問い：助けていたつもりが、何だった？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e74" edge="1" parent="1" source="S05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S06">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n75" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="観測し直し、本人の望みを聞く。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="1688" as="geometry"/>
                </mxCell>
                <mxCell id="n76" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="最終幕&#xa;認識の転換" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="1716" as="geometry"/>
                </mxCell>
                <mxCell id="S07" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="1716" as="geometry"/>
                </mxCell>
                <mxCell id="n78" parent="S07" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S07｜相手を説明していた言葉が、自分に返る" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n79" parent="S07" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="秀斗の恐れ・得意・望みを聞き、頷きの意味が変わる。&#xa;樹は、思考しか頼れない自分の条件にも気づく。&#xa;怒りや傷を抱えたまま、双方の望みを言葉にする。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n80" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="1716" as="geometry"/>
                </mxCell>
                <mxCell id="n81" parent="n80" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="断絶− → 話し合える関係＋" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n82" parent="n80" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w05・w06・w07・w08・w09&#xa;問い：双方が続けられる方法はある？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e83" edge="1" parent="1" source="S06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#9270B3;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S07">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n84" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="双方の条件を使い、別案を試す。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="1874" as="geometry"/>
                </mxCell>
                <mxCell id="n85" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="最終幕&#xa;危機へ到達" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="1902" as="geometry"/>
                </mxCell>
                <mxCell id="S08" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="1902" as="geometry"/>
                </mxCell>
                <mxCell id="n87" parent="S08" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S08｜仕事は動く。しかし両案に、代価がある" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n88" parent="S08" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="樹の技術判断と秀斗の現場調整に分け、試行が成功する。&#xa;品質を守る全体検証には延長と樹の残留が必要になる。&#xa;予定どおりの移管か、今回の異動を失う再設計かが残る。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n89" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="1902" as="geometry"/>
                </mxCell>
                <mxCell id="n90" parent="n89" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="協働の可能性＋／進路の見通し−" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n91" parent="n89" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w02・w03・w04・w06・w08・w10&#xa;問い：どちらの利益と代価を選ぶ？" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e92" edge="1" parent="1" source="S07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S08">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n93" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="承認可能な二案を、期限前に選ぶ。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="2060" as="geometry"/>
                </mxCell>
                <mxCell id="n94" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="クライマックス&#xa;行動で決着" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="2088" as="geometry"/>
                </mxCell>
                <mxCell id="S09" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="2088" as="geometry"/>
                </mxCell>
                <mxCell id="n96" parent="S09" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S09｜双方が公に選び、機会と責任を変える" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n97" parent="S09" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="樹は延長案に署名し、今回の研究開発枠を手放す。&#xa;秀斗は単独責任者候補を辞退し、自ら新しい役割を申請する。&#xa;関係者が承認し、人事・移管の約束・確認体制が変わる。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n98" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="2088" as="geometry"/>
                </mxCell>
                <mxCell id="n99" parent="n98" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="能力で保つ所属 → 望みを言える協働＋" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n100" parent="n98" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w07・w09・w10・w11&#xa;今回の機会は、元に戻らない。" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e101" edge="1" parent="1" source="S08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S09">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n102" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=16;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="選んだ結果を、日常で生きる。" vertex="1">
                    <mxGeometry height="28" width="420" x="790" y="2246" as="geometry"/>
                </mxCell>
                <mxCell id="n103" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="解決&#xa;変化の確認" vertex="1">
                    <mxGeometry height="156" width="190" x="60" y="2274" as="geometry"/>
                </mxCell>
                <mxCell id="S10" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="930" x="280" y="2274" as="geometry"/>
                </mxCell>
                <mxCell id="n105" parent="S10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S10｜同じ世界を、別の意味で面白がる" vertex="1">
                    <mxGeometry height="40" width="902" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n106" parent="S10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="分けた役割で働き、「わからない」と言って確かめ合う。&#xa;樹の精密な分析も、秀斗の不得手も、怒りの芽も残る。&#xa;ノートとシュモクバエを巡る笑いで、更新された視界を味わう。" vertex="1">
                    <mxGeometry height="91" width="902" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n107" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="156" width="550" x="1270" y="2274" as="geometry"/>
                </mxCell>
                <mxCell id="n108" parent="n107" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="失敗への不安 → 続けられる関係＋" vertex="1">
                    <mxGeometry height="40" width="522" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n109" parent="n107" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w02・w03・w04・w09・w11・w12&#xa;同じ不得手や造形が、もう違って見える。" vertex="1">
                    <mxGeometry height="91" width="522" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e110" edge="1" parent="1" source="S09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="S10">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n111" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="165" width="1120" x="60" y="2485" as="geometry"/>
                </mxCell>
                <mxCell id="n112" parent="n111" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="全編の契機と、社会人編の転換" vertex="1">
                    <mxGeometry height="40" width="1092" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n113" parent="n111" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="全編の契機事件＝父の死。序盤で、父との足場を先に体験する。&#xa;学力の成功 → 職場の失敗 → 言葉の獲得が、指導する立場を生む。&#xa;秀斗との再会は合流点、指導拒否は最終幕へ押す大きな転換。" vertex="1">
                    <mxGeometry height="100" width="1092" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n114" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="165" width="580" x="1240" y="2485" as="geometry"/>
                </mxCell>
                <mxCell id="n115" parent="n114" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="仮配置の成立条件" vertex="1">
                    <mxGeometry height="40" width="552" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n116" parent="n114" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="仕事・異動・期限は、新設した仮設定。&#xa;対立が増すのは、樹と秀斗の選択の結果。&#xa;論理の有効さはS04から結末まで続く。" vertex="1">
                    <mxGeometry height="100" width="552" x="14" y="53" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="yxw-05" name="05｜見え方が変わる仕掛け">
