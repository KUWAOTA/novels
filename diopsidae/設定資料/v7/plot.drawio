                <mxCell id="n57" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="140" width="600" x="60" y="1400" as="geometry"/>
                </mxCell>
                <mxCell id="n58" parent="n57" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="効率と、人が生きられる条件を考える" vertex="1">
                    <mxGeometry height="40" width="572" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n59" parent="n57" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="何を最適化するかで、よい方法は変わる。&#xa;弱さを責めるより、動ける条件を作りたい。" vertex="1">
                    <mxGeometry height="75" width="572" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n60" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="願い・負荷・役割を言葉にできる。&#xa;見取り図を使って、選択と仕組みを変える。" vertex="1">
                    <mxGeometry height="140" width="580" x="720" y="1400" as="geometry"/>
                </mxCell>
                <UserObject label="w06｜条件で仕事が変わる&#xa;w10・w11｜目的と幸福を選択へ" link="data:page/id,yxw-03" id="n61">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" vertex="1">
