                </UserObject>
                <UserObject label="06 危機・決着" link="data:page/id,yxw-06" id="n8">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#344456;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DBE3;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="48" width="238" x="1325" y="130" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="07 配置表" link="data:page/id,yxw-07" id="n9">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#344456;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DBE3;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="48" width="238" x="1578" y="130" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="n10" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="世界が見える｜w₁–w₄" vertex="1">
                    <mxGeometry height="48" width="560" x="60" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#69400E;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="自他が見え直す｜w₅–w₈" vertex="1">
                    <mxGeometry height="48" width="560" x="660" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="選択と余韻｜w₉–w₁₂" vertex="1">
                    <mxGeometry height="48" width="560" x="1260" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="w01" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="60" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="w01" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w01｜理由のわからない教室" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="w01" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜正しい訂正で、場が凍る。&#xa;主人公にも読者にも理由がわからない。&#xa;成立｜反応と困惑を先に体験する。&#xa;根拠｜空気が読めなかった経験。&#xa;配置｜S01・S02・S03" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w02" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="60" y="605" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="w02" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w02｜言葉を得ると、霧が晴れる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n18" parent="w02" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜同じ報告が、区別を得て通る。&#xa;内容・意図・相手の前提が分かれる。&#xa;成立｜獲得の前後で差を確かめる。&#xa;根拠｜社会人編の論理のメガネ。&#xa;配置｜S03 → S04、S08・S10" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w03" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="60" y="900" as="geometry"/>
                </mxCell>
                <mxCell id="n20" parent="w03" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w03｜論理が本当に自分を助ける" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n21" parent="w03" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜手順と伝え方を変え、仕事が動く。&#xa;成果も、他人と働ける喜びも得る。&#xa;成立｜成功の手触りを十分に味わう。&#xa;根拠｜再現性と学習に救われた経験。&#xa;配置｜S04・S05・S08・S10" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w04" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="60" y="1195" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="w04" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w04｜人間の規則を試したくなる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n24" parent="w04" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜手掛かりから反応を予測し、試す。&#xa;当たる喜びと、外れた謎を追う。&#xa;成立｜仮説が次の行動につながる。&#xa;根拠｜仮説検証・分析する楽しさ。&#xa;配置｜S02・S04・S08を軸に全編" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w05" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="660" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="n26" parent="w05" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w05｜同じ「わかった」が反転する" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n27" parent="w05" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜習得だと思った頷きが、&#xa;評価を失わないための返事と見え直す。&#xa;成立｜先に違和感の手掛かりを置く。&#xa;根拠｜立場によって意味が変わる実感。&#xa;配置｜S05 → S06 → S07" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w06" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="660" y="605" as="geometry"/>
                </mxCell>
                <mxCell id="n29" parent="w06" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w06｜「できない」の構造が見える" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n30" parent="w06" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜理解はしても、一人では動けない。&#xa;負荷や役割を変えると仕事が動く。&#xa;成立｜理解・実行・条件を分ける。&#xa;根拠｜自制よりシステムを作る価値観。&#xa;配置｜S06 → S07 → S08" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w07" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="660" y="900" as="geometry"/>
                </mxCell>
                <mxCell id="n32" parent="w07" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w07｜相手にも、相手の人生がある" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n33" parent="w07" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜秀斗が望みを言い、支援も拒む。&#xa;親の承認や仕事への願いが行動を生む。&#xa;成立｜樹に都合のよい反応に固定しない。&#xa;根拠｜相手の立場から意味が変わる経験。&#xa;配置｜S02・S05・S06・S07・S09" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w08" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="660" y="1195" as="geometry"/>
                </mxCell>
                <mxCell id="n35" parent="w08" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w08｜分析する自分も、見え直す" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n36" parent="w08" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜「考えないのは怠慢」と憤る。&#xa;自分こそ思考以外の道が見えていない。&#xa;成立｜相手と自分の条件を同じ目で見る。&#xa;根拠｜今回補足された、思考への偏見。&#xa;配置｜S03・S05 → S07・S08" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w09" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="1260" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="n38" parent="w09" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w09｜怒る自分も、ままならない" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n39" parent="w09" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜相手の事情を知っても傷は残る。&#xa;怒りを抱えたまま、次の行動を選ぶ。&#xa;成立｜怒りの消失を到達条件にしない。&#xa;根拠｜怒ってしまう自分も受け取る。&#xa;配置｜S02・S06 → S07・S09・S10" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w10" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="1260" y="605" as="geometry"/>
                </mxCell>
                <mxCell id="n41" parent="w10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w10｜目的が変わると、最適解が変わる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n42" parent="w10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜最短の移管だけで比べていた案を、&#xa;品質・続けやすさ・双方の願いで比べる。&#xa;成立｜代価も含め、実行可能な案を示す。&#xa;根拠｜効率と目的関数についての価値観。&#xa;配置｜S04・S05 → S08・S09" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w11" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="1260" y="900" as="geometry"/>
                </mxCell>
                <mxCell id="n44" parent="w11" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w11｜幸福を願うことが、行動になる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n45" parent="w11" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜自分の望みも相手の選択も聞き、&#xa;代価を承知で、働ける条件を作る。&#xa;成立｜双方が選び、結果を引き受ける。&#xa;根拠｜人が苦しまずに済む仕組みを願う。&#xa;配置｜S07・S08 → S09・S10" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="w12" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="270" width="560" x="1260" y="1195" as="geometry"/>
                </mxCell>
                <mxCell id="n47" parent="w12" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w12｜世界を、まだ面白がれる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n48" parent="w12" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="場面｜同じ不得手や虫の姿を、&#xa;今は二人で、観察し笑い合える。&#xa;成立｜精密に見る楽しさを最後まで残す。&#xa;根拠｜冒険・発見・シュモクバエの造形。&#xa;配置｜S01・S04 → S10" vertex="1">
                    <mxGeometry height="205" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n49" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="読者が知識を覚えたかに加え、「予測できた」「息が詰まった」「同じ人が違って見えた」を確認する。" vertex="1">
                    <mxGeometry height="65" width="1760" x="60" y="1530" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="yxw-04" name="04｜因果・価値：物語への仮配置">
        <mxGraphModel dx="2462" dy="1072" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="2720" background="#FFFFFF" math="0" shadow="0">
