                <mxCell id="n1" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=32;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="同じ出来事が、違う意味に見える仕掛け" vertex="1">
