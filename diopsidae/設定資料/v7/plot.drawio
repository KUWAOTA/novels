                <mxCell id="n25" parent="n24" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="結果で、使えるとわかる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n26" parent="n24" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="相手が判断でき、仕事が進む。&#xa;次は読者も反応を予測できる。" vertex="1">
