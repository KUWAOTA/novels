                </mxCell>
                <mxCell id="n21" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
