                <mxCell id="n19" parent="n18" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="問いが生まれる" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
