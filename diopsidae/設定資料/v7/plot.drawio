                    </mxCell>
                </UserObject>
                <mxCell id="n10" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="850" x="60" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="樹｜本筋の欲求" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="移管を終え、研究開発へ戻りたい。&#xa;自分の力で、居場所を守りたい。&#xa;「できない」を否定された恐れがある。" vertex="1">
                    <mxGeometry height="105" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n13" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="850" x="970" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="秀斗｜独立した副線の欲求" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="単独責任者になり、親に認められたい。&#xa;現場の人と働くことは続けたい。&#xa;不得手を認めると、価値を失うと思っている。" vertex="1">
                    <mxGeometry height="105" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n16" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="副線の意図｜樹の方法を揺さぶり、主題に共鳴する。秀斗自身の欲求が、本筋の行動と結果を変える。" vertex="1">
                    <mxGeometry height="45" width="1760" x="60" y="415" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="150" width="410" x="60" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="n18" parent="n17" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S02｜比較で承認を求める" vertex="1">
                    <mxGeometry height="40" width="382" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n19" parent="n17" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="勉強で負け、教室の優位を使う。&#xa;樹を傷つけ、進路選択を押す。" vertex="1">
                    <mxGeometry height="85" width="382" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n20" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="150" width="410" x="510" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="n21" parent="n20" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S05｜できないを隠す" vertex="1">
                    <mxGeometry height="40" width="382" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n22" parent="n20" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="昇進候補に残るため、頷く。&#xa;樹は習得と読み、責任を渡す。" vertex="1">
                    <mxGeometry height="85" width="382" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="150" width="410" x="960" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="n24" parent="n23" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S06｜自分から拒む" vertex="1">
                    <mxGeometry height="40" width="382" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n25" parent="n23" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="取り繕えず、指導を止める。&#xa;移管が止まり、樹も選び直す。" vertex="1">
                    <mxGeometry height="85" width="382" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n26" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="150" width="410" x="1410" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="n27" parent="n26" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S07–09｜自分の役割を選ぶ" vertex="1">
                    <mxGeometry height="40" width="382" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n28" parent="n26" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="望みを言い、分担案を提案する。&#xa;自ら候補を辞退し、役割を申請。" vertex="1">
                    <mxGeometry height="85" width="382" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e29" edge="1" parent="1" source="n17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#D99032;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n20">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e30" edge="1" parent="1" source="n20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#D99032;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n23">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e31" edge="1" parent="1" source="n23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#D99032;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n26">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n32" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S05〜S08で仕込む条件｜最終会議で突然、代価や逃げ道を追加しない" vertex="1">
                    <mxGeometry height="45" width="1760" x="60" y="670" as="geometry"/>
                </mxCell>
                <mxCell id="n33" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="60" y="740" as="geometry"/>
                </mxCell>
                <mxCell id="n34" parent="n33" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="期限と権限" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n35" parent="n33" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="移管審査と異動枠の確定日が重なる。&#xa;変更の承認者は、上司・顧客・人事。&#xa;樹一人では決められない。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n36" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="660" y="740" as="geometry"/>
                </mxCell>
                <mxCell id="n37" parent="n36" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="B案の実行可能性" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n38" parent="n36" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="樹が技術、秀斗が現場調整を担う。&#xa;共同試行で品質と負荷を確かめる。&#xa;秀斗自身が、この役割を望む。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n39" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="1260" y="740" as="geometry"/>
                </mxCell>
                <mxCell id="n40" parent="n39" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="両方を得る案の限界" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n41" parent="n39" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="代替要員なら既存方式を引き継げる。&#xa;新方式の全体検証には樹の残留が要る。&#xa;延長すると今回の異動枠は失う。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n42" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=26;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="クライシス｜どちらにも、選ぶ理由と引き受ける代価がある" vertex="1">
                    <mxGeometry height="48" width="1760" x="60" y="945" as="geometry"/>
                </mxCell>
                <mxCell id="n43" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="220" width="850" x="60" y="1020" as="geometry"/>
                </mxCell>
                <mxCell id="n44" parent="n43" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=25;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="A｜予定どおり、既存方式で移管する" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n45" parent="n43" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="守る｜品質・納期・チームの予定・樹の異動。&#xa;失う｜秀斗の単独候補資格と、共同再設計の機会。&#xa;理由｜現場を止めず、自分の望む進路へ進める。&#xa;結果｜秀斗の次の処遇は、会社の判断へ渡る。" vertex="1">
                    <mxGeometry height="155" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n46" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="220" width="850" x="970" y="1020" as="geometry"/>
                </mxCell>
                <mxCell id="n47" parent="n46" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=25;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="B｜役割を分け、新方式を検証して移管する" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n48" parent="n46" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="守る｜品質・秀斗の得意・双方が続けられる仕事。&#xa;失う｜樹の今回の異動枠・秀斗の単独責任者の地位。&#xa;理由｜試行で動くと確かめ、双方がこの案を望む。&#xa;条件｜延長と再編の責任を引き受け、承認を得る。" vertex="1">
                    <mxGeometry height="155" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n49" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=center;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="S08：二案と、双方の意思が揃う&#xa;S09：公に選んで実行する" vertex="1">
                    <mxGeometry height="70" width="580" x="650" y="1255" as="geometry"/>
                </mxCell>
                <mxCell id="n50" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="175" width="1760" x="60" y="1340" as="geometry"/>
                </mxCell>
                <mxCell id="n51" parent="n50" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=25;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="クライマックス〈S09〉｜公に選び、承認される" vertex="1">
                    <mxGeometry height="40" width="1732" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n52" parent="n50" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="樹：延長と追加担当を引き受ける案に署名し、自分の異動の見送りを申告する。&#xa;秀斗：単独責任者の候補を辞退し、自分の言葉で新しい役割を申請する。&#xa;上司・顧客・人事：事前に条件を確認した変更を承認し、機会と責任の配置を確定する。" vertex="1">
                    <mxGeometry height="110" width="1732" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="e53" edge="1" parent="1" source="n43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.24147727272727273;entryY=0;" target="n50">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e54" edge="1" parent="1" source="n46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.7585227272727273;entryY=0;" target="n50">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n55" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=25;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="その時点で、元には戻せない変更" vertex="1">
                    <mxGeometry height="45" width="1760" x="60" y="1550" as="geometry"/>
                </mxCell>
                <mxCell id="n56" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="60" y="1620" as="geometry"/>
                </mxCell>
                <mxCell id="n57" parent="n56" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="進路・地位" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n58" parent="n56" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="今回の研究開発枠は、別の人に確定。&#xa;秀斗も今回の単独昇進候補を辞退。&#xa;心変わりしても同じ機会には戻れない。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n59" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="660" y="1620" as="geometry"/>
                </mxCell>
                <mxCell id="n60" parent="n59" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="案件の責任" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n61" parent="n59" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="単独移管の約束を正式に変更する。&#xa;期限・担当・確認者を文書に残す。&#xa;新体制を、他者への約束にする。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n62" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="560" x="1260" y="1620" as="geometry"/>
                </mxCell>
                <mxCell id="n63" parent="n62" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="二人の関係に残る事実" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n64" parent="n62" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="互いに不得手と望みを公にする。&#xa;指導・判定を樹一人へ集中させない。&#xa;自分を隠していた関係には戻れない。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n65" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="190" width="850" x="60" y="1840" as="geometry"/>
                </mxCell>
                <mxCell id="n66" parent="n65" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="価値の決着｜孤立から、望みを言える協働へ" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n67" parent="n65" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="主題｜裁く → 不完全さの受容 → 幸福を願う。&#xa;双方が失うものを知って、自分の案を選ぶ。&#xa;樹は相手の幸福を願い、自分の希望も言葉にする。&#xa;秀斗も自分の役割を選び、結果を引き受ける。" vertex="1">
                    <mxGeometry height="125" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n68" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FBE8EB;strokeColor=#C96B82;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="180" width="850" x="970" y="1840" as="geometry"/>
                </mxCell>
                <mxCell id="n69" parent="n68" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="Wとwが、決着に働いているか" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n70" parent="n68" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#6B2B3B;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="w06・w08：双方の条件が見えている。&#xa;w10：目的と代価を精密に比べられる。&#xa;w11：その視界の上で、双方の選択が変わる。" vertex="1">
                    <mxGeometry height="115" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n71" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="170" width="1760" x="60" y="2070" as="geometry"/>
                </mxCell>
                <mxCell id="n72" parent="n71" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="今回の仮設定と、次に確かめる点" vertex="1">
                    <mxGeometry height="40" width="1732" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n73" parent="n71" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="既存素材：父の死／進学／論理の獲得／秀斗との再会／試行・会議への欠勤。&#xa;新設候補：異動枠と期限／既存・新方式／試行による検証／役割と承認経路。&#xa;次工程：具体業務と品質基準、代替要員で両立できない事情、選ぶ代価の自然さ。" vertex="1">
                    <mxGeometry height="105" width="1732" x="14" y="53" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
