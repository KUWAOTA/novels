                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n159" parent="n157" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="⑤ 05：同じものが見え直す体験が起きるか。&#xa;⑥ 06：実行できる二案と、選択の代価があるか。&#xa;⑦ 07：大切なwが、説明だけで済んでいないか。" vertex="1">
                    <mxGeometry height="125" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
