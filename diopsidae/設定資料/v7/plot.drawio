                <mxCell id="n43" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="140" width="600" x="60" y="1060" as="geometry"/>
                </mxCell>
                <mxCell id="n44" parent="n43" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="相手の事情や立場で、意味が変わる" vertex="1">
                    <mxGeometry height="40" width="572" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n45" parent="n43" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="不快な言動にも、相手の事情があった。&#xa;別の立場を知ると、関係の見方が変わった。" vertex="1">
                    <mxGeometry height="75" width="572" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n46" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" value="一つの言動に、見えない事情がある。&#xa;本人の願いが、その人の行動を生む。" vertex="1">
                    <mxGeometry height="140" width="580" x="720" y="1060" as="geometry"/>
                </mxCell>
                <UserObject label="w05｜同じ言葉の意味が反転&#xa;w07｜相手にも相手の人生" link="data:page/id,yxw-03" id="n47">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#69400E;align=left;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFF0DB;strokeColor=#D99032;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="140" width="460" x="1360" y="1060" as="geometry"/>
