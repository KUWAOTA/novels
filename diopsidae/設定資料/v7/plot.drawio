                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e63" edge="1" parent="1" source="n60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#C96B82;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n61">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n64" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="190" width="850" x="60" y="1600" as="geometry"/>
                </mxCell>
                <mxCell id="n65" parent="n64" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="この動機が、設計を変えるところ" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n66" parent="n64" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="論理で救われる成功を、十分な楽しさで描く。&#xa;観察する主人公自身にも、同じ条件の目を向ける。&#xa;獲得した視界を、読者の発見・困惑・選択として渡す。" vertex="1">
                    <mxGeometry height="125" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n67" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="190" width="850" x="970" y="1600" as="geometry"/>
                </mxCell>
                <mxCell id="n68" parent="n67" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="経験を、作品へ組み直す基準" vertex="1">
                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n69" parent="n67" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="経験で得た構造と感触を、人物や出来事に組み直す。&#xa;出来事の変更は、その視界が伝わるかで判断する。&#xa;自分が作りたいことと、読者が楽しめることを確かめる。" vertex="1">
                    <mxGeometry height="125" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="yxw-03" name="03｜w₁–w₁₂：体験の候補">
        <mxGraphModel dx="3104" dy="1352" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1660" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=32;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w₁–w₁₂｜読者に、具体的に起きてほしいこと" vertex="1">
                    <mxGeometry height="52" width="1760" x="60" y="24" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="全項目が今回の候補。場面例は差し替え可能。根拠は作者の経験・価値観、配置先はシート04。" vertex="1">
                    <mxGeometry height="33" width="1760" x="60" y="80" as="geometry"/>
                </mxCell>
                <UserObject label="01 目的・世界" link="data:page/id,yxw-01" id="n3">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#344456;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DBE3;strokeWidth=1.5;" vertex="1">
