                    <mxGeometry height="40" width="822" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n156" parent="n154" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#264D32;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="① 01：Y・X・Wは、作りたいものを捉えているか。&#xa;② 02：なぜこのWを選ぶかが、設計に働いているか。&#xa;③ 03：wの不足・余分・重複はないか。&#xa;④ 04：欲求と因果で進み、価値が動いているか。" vertex="1">
                    <mxGeometry height="125" width="822" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n157" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#E7F0FA;strokeColor=#4A7FB5;strokeWidth=1.5;" value="" vertex="1">
