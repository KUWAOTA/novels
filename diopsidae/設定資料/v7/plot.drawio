                <mxCell id="n32" parent="n31" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="一度は、習得と読める" vertex="1">
                    <mxGeometry height="40" width="532" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n33" parent="n31" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#69400E;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="「わかった」と頷き、共同作業はできる。&#xa;単独では止まる違和感も先に見せる。" vertex="1">
                    <mxGeometry height="105" width="532" x="14" y="53" as="geometry"/>
                </mxCell>
