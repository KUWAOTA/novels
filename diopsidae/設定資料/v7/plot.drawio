                <mxCell id="n30" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#69400E;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w05・w06・w07" vertex="1">
