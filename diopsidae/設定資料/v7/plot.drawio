                <mxCell id="n36" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="140" width="600" x="60" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="n37" parent="n36" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="自分も他人の「できない」を責めていた" vertex="1">
                    <mxGeometry height="40" width="572" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n38" parent="n36" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#513368;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="自分の不得手は責められて苦しかった。&#xa;他人の不得手には、自分も腹を立てていた。" vertex="1">
                    <mxGeometry height="75" width="572" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n39" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" value="相手も自分も、条件を持つ人間。&#xa;同じ目で見ると、自他が見え直す。" vertex="1">
                    <mxGeometry height="140" width="580" x="720" y="890" as="geometry"/>
                </mxCell>
                <UserObject label="w06｜できないの構造&#xa;w08・w09｜自分の条件と怒り" link="data:page/id,yxw-03" id="n40">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#513368;align=left;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#F0E8F7;strokeColor=#9270B3;strokeWidth=1.5;" vertex="1">
                        <mxGeometry height="140" width="460" x="1360" y="890" as="geometry"/>
