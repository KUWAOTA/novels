                <mxCell id="n11" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="S00｜分析ノートの短い抜粋〈案〉" vertex="1">
                    <mxGeometry height="40" width="972" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="n10" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="観測：訂正の内容には、反論されなかった。&#xa;結果：僕の態度を叱られた。&#xa;仮説：内容への評価と、人への評価は別に動く。" vertex="1">
                    <mxGeometry height="115" width="972" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n13" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=10;rounded=1;arcSize=8;fillColor=#F4F6F8;strokeColor=#BBC5D0;strokeWidth=1.5;" value="" vertex="1">
                    <mxGeometry height="180" width="700" x="1120" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=23;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="この入口が約束する楽しさ" vertex="1">
                    <mxGeometry height="40" width="672" x="14" y="9" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="n13" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="数行で、観察と仮説の見方を予告する。&#xa;直後に教室の出来事へ入り、理由を追う。&#xa;大きな答えは、行動の結果から発見する。" vertex="1">
                    <mxGeometry height="115" width="672" x="14" y="53" as="geometry"/>
                </mxCell>
                <mxCell id="n16" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=24;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="A｜区別を得て、仕事が通る〈S03 → S04〉" vertex="1">
                    <mxGeometry height="40" width="1320" x="60" y="445" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183B60;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fillColor=none;strokeColor=none;" value="w02・w03・w04" vertex="1">
