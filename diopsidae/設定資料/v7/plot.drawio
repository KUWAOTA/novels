                <mxCell id="n20" parent="n18" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183B60;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="正しい内容なのに、報告を退けられる。&#xa;読者も「何が通じない？」を抱える。" vertex="1">
