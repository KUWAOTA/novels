                <UserObject label="06 危機・決着" link="data:page/id,yxw-06" id="n8">
                    <mxCell parent="1" style="whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=18;fontColor=#264D32;align=center;verticalAlign=middle;spacing=10;fontStyle=1;rounded=1;arcSize=8;fillColor=#E9F4ED;strokeColor=#6B9F7A;strokeWidth=1.5;" vertex="1">
