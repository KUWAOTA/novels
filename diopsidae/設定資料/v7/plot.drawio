                <mxCell id="n153" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Hiragino Sans;fontSize=20;fontColor=#344456;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" value="S01–02：中学／S03–04：社会人の失敗と獲得／S05–06：再会と破綻／S07–08：更新と危機／S09–10：決着と余韻" vertex="1">
