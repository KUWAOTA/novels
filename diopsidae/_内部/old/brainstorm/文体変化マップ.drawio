    <!-- Key insight box -->
    <mxCell id="insight" value="&lt;b&gt;タカヤさんの指摘との対応&lt;/b&gt;&lt;hr&gt;① 文体の統制 = 各ACTに明確なルールと導入理由がある&lt;br&gt;② 文体の効果 = 物語上は善意でも文体上は暴力（ACT4）&lt;br&gt;③ 一貫性 ≠ 同じ文章 = 成長に伴い変化していく&lt;br&gt;④ 作者の言葉を出さない = キャラの語彙・認知に縛られた文体&lt;br&gt;⑤ 文体で年齢の成長を描く = ACT1→EPILOGUEの語彙・構文変化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;fontSize=10;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
      <mxGeometry x="80" y="820" width="500" height="130" as="geometry"/>
    </mxCell>

    <!-- Core theme annotation -->
    <mxCell id="theme" value="&lt;b&gt;文体のアーク（全体像）&lt;/b&gt;&lt;hr&gt;&lt;b&gt;樹:&lt;/b&gt; 平坦→揺れ→精密→報告書→崩壊→成熟簡素&lt;br&gt;（精密さの獲得と放棄の物語）&lt;br&gt;&lt;br&gt;&lt;b&gt;あんず:&lt;/b&gt; 不在→間接的存在→言語不可能の爆発&lt;br&gt;（「言葉で救える」の反証）&lt;br&gt;&lt;br&gt;&lt;b&gt;秀斗:&lt;/b&gt; 比較嫉妬→不可視→借り物崩壊&lt;br&gt;（条件付き愛が生む「自分の言葉のなさ」）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;fontSize=10;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
      <mxGeometry x="650" y="820" width="400" height="160" as="geometry"/>
    </mxCell>

