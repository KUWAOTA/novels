    <!-- ==================== 秀斗 ROW ==================== -->
    <mxCell id="shuto_label" value="&lt;b&gt;秀斗 視点&lt;/b&gt;" style="text;html=1;align=right;fontSize=14;fontColor=#E67E22;" vertex="1" parent="1">
      <mxGeometry x="0" y="640" width="80" height="30" as="geometry"/>
    </mxCell>

    <!-- FB1 秀斗 child -->
    <mxCell id="s_fb1" value="&lt;b&gt;FB1: 比較嫉妬体&lt;/b&gt;&lt;br&gt;「あいつは〜なのに、僕は〜」&lt;br&gt;母の言葉が地の文に混入&lt;br&gt;「ちゃんとしなさい」括弧なし&lt;br&gt;怒りと悲しみが未分化&lt;br&gt;「ずるい」が最頻出&lt;br&gt;&lt;i&gt;句読点少・一気書き&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="260" y="580" width="200" height="130" as="geometry"/>
    </mxCell>

    <!-- ACT4 秀斗（樹越し） -->
    <mxCell id="s_a4_indirect" value="&lt;b&gt;樹の文体越しの存在&lt;/b&gt;&lt;br&gt;「改善すべき同僚」&lt;br&gt;「期待に応えられていない」&lt;br&gt;秀斗の苦痛は見えない&lt;br&gt;&lt;i&gt;→ 樹の盲点を文体が表現&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1120" y="580" width="220" height="100" as="geometry"/>
    </mxCell>

    <!-- FB3 秀斗 adult -->
    <mxCell id="s_fb3" value="&lt;b&gt;FB3: 仮面崩壊体&lt;/b&gt;&lt;br&gt;借り物のビジネス語彙&lt;br&gt;最初は整然→徐々に崩壊&lt;br&gt;FB1の比較構文が大人語彙で再出現&lt;br&gt;「彼には〜があるのに、自分には」&lt;br&gt;「大丈夫」「できる」の反復&lt;br&gt;→説得力が落ちていく&lt;br&gt;母の声と樹の声が重なる&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;20年変わらない構造&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1420" y="560" width="220" height="160" as="geometry"/>
    </mxCell>

    <!-- 秀斗 edges -->
    <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E67E22;strokeWidth=2;dashed=1;" edge="1" source="s_fb1" target="s_a4_indirect" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=3;dashed=1;" edge="1" source="s_a4_indirect" target="s_fb3" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- FB1→FB3 structural echo -->
    <mxCell id="se_echo" value="構造の反復" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E67E22;strokeWidth=1;dashed=1;curved=1;" edge="1" source="s_fb1" target="s_fb3" parent="1">
