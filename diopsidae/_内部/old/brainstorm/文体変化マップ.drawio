    <!-- ACT2 S3 あんずの内面（樹の文体を通して間接的に） -->
    <mxCell id="a_a2_indirect" value="&lt;b&gt;樹の文体越しの存在&lt;/b&gt;&lt;br&gt;樹の文にだけ質感が生まれる&lt;br&gt;あんず自身の声は聞こえない&lt;br&gt;&lt;i&gt;→ 読者の想像に委ねられる&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAF0;strokeColor=#7B4F9E;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="480" y="370" width="200" height="90" as="geometry"/>
    </mxCell>

    <!-- FB2 あんず直接視点 -->
    <mxCell id="a_fb2" value="&lt;b&gt;FB2: 過呼吸体&lt;/b&gt;&lt;br&gt;語彙が極端に限定&lt;br&gt;「痛い」「やめて」「大丈夫」反復&lt;br&gt;短い断片↔止まらない長文&lt;br&gt;「助けて」が毎回組み立て失敗&lt;br&gt;「あの、」「えっと、」で途切れ&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;言語化不可能の証明&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="730" y="340" width="210" height="140" as="geometry"/>
    </mxCell>

    <!-- あんず edge -->
    <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7B4F9E;strokeWidth=2;dashed=1;" edge="1" source="a_a2_indirect" target="a_fb2" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- あんず → 樹の結論への反証 -->
    <mxCell id="a_counter" value="&lt;i&gt;あんずの文体が証明するもの:&lt;br&gt;「精密な言葉があれば救えた」は誤り&lt;br&gt;→ 言葉にすること自体が不可能だった&lt;/i&gt;" style="text;html=1;align=center;fontSize=10;fontColor=#C0392B;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="730" y="490" width="210" height="50" as="geometry"/>
