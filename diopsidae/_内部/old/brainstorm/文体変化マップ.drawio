    <!-- PROLOGUE -->
    <mxCell id="i_pro" value="&lt;b&gt;回想体&lt;/b&gt;&lt;br&gt;大人の語彙+子供の感覚&lt;br&gt;物・自然だけ精密&lt;br&gt;人間関係は曖昧&lt;br&gt;&lt;i&gt;静謐なリズム&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="80" y="150" width="160" height="100" as="geometry"/>
    </mxCell>

    <!-- ACT1 -->
    <mxCell id="i_a1" value="&lt;b&gt;観察記録体&lt;/b&gt;&lt;br&gt;短文羅列・感情語ゼロ&lt;br&gt;空間を計測する視点&lt;br&gt;父との会話だけリズム変化&lt;br&gt;&lt;b&gt;S5 父の死:&lt;/b&gt; 平坦が&lt;br&gt;壊れない＝異常" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="260" y="150" width="170" height="110" as="geometry"/>
    </mxCell>

    <!-- ACT2 -->
    <mxCell id="i_a2" value="&lt;b&gt;揺れ始める体&lt;/b&gt;&lt;br&gt;あんず描写だけ質感変化&lt;br&gt;身体感覚が漏れ始める&lt;br&gt;&lt;b&gt;S3 デート:&lt;/b&gt; 初の「美しい」&lt;br&gt;&lt;b&gt;S4b 取調室:&lt;/b&gt; 壊れかけ→&lt;br&gt;論理で修復&lt;br&gt;&lt;b&gt;S5:&lt;/b&gt; 防衛的平坦に硬化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="480" y="140" width="200" height="130" as="geometry"/>
    </mxCell>

    <!-- ACT3 -->
    <mxCell id="i_a3" value="&lt;b&gt;学術精密体&lt;/b&gt;&lt;br&gt;長文・従属節・断定増加&lt;br&gt;感覚描写が減少&lt;br&gt;人を能力値で評価&lt;br&gt;あんずの名で微揺れ→即修復&lt;br&gt;&lt;i&gt;読者も「正しい」と思い始める&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="830" y="140" width="200" height="120" as="geometry"/>
    </mxCell>

    <!-- ACT4 -->
    <mxCell id="i_a4" value="&lt;b&gt;報告書体（善意の暴力）&lt;/b&gt;&lt;br&gt;ビジネス語で人間関係を処理&lt;br&gt;感覚描写ほぼ消滅&lt;br&gt;&lt;b&gt;S2:&lt;/b&gt; 文が長くなりすぎる&lt;br&gt;&lt;b&gt;S3 鏡像:&lt;/b&gt; 主語が混乱&lt;br&gt;初の本心「わからない」&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;崩壊開始&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1120" y="130" width="220" height="140" as="geometry"/>
    </mxCell>

    <!-- ACT5 -->
    <mxCell id="i_a5" value="&lt;b&gt;断片→再生体&lt;/b&gt;&lt;br&gt;語彙の急速簡素化&lt;br&gt;&lt;b&gt;S1:&lt;/b&gt; 身体動作の羅列&lt;br&gt;「走った。掴んだ。引いた。」&lt;br&gt;&lt;b&gt;S2:&lt;/b&gt; 不完全だが温かい文&lt;br&gt;「しんどかったな」&lt;br&gt;&lt;font color=&quot;#28A745&quot;&gt;&lt;b&gt;新しい文体の誕生&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1420" y="130" width="220" height="140" as="geometry"/>
    </mxCell>

    <!-- EPILOGUE -->
    <mxCell id="i_ep" value="&lt;b&gt;成熟簡素体&lt;/b&gt;&lt;br&gt;選んで簡素にした文体&lt;br&gt;感覚描写が豊かに回帰&lt;br&gt;「きれいだった」「笑った」&lt;br&gt;分析→共有へ&lt;br&gt;&lt;font color=&quot;#28A745&quot;&gt;&lt;i&gt;精密さの放棄＝成熟&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1720" y="140" width="200" height="120" as="geometry"/>
    </mxCell>

