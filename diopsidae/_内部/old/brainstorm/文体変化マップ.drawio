    <!-- ==================== あんず ROW ==================== -->
    <mxCell id="anzu_label" value="&lt;b&gt;あんず 視点&lt;/b&gt;" style="text;html=1;align=right;fontSize=14;fontColor=#7B4F9E;" vertex="1" parent="1">
      <mxGeometry x="0" y="420" width="80" height="30" as="geometry"/>
