<mxfile host="65bd71144e">
    <diagram id="act1-s1" name="S1 ASD傾向で孤立 — シーン分析">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="ACT1-S1「ASD傾向で孤立」— シーン分析マップ（物語の出発点）" style="text;html=1;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="2100" height="36" as="geometry"/>
                </mxCell>

                <!-- SEC1: 機能 -->
                <mxCell id="s1t" value="1. このシーンが果たすべき機能 — 物語の全土台を敷く" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#28A745;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="【機能A】樹のキャラ確立&#xa;&#xa;ASD傾向の具体：&#xa;・目を合わせない&#xa;・比喩が通じない&#xa;・感覚過敏（音・光）&#xa;・パターン認識が異常に鋭い&#xa;・「なぜ」を問い続ける&#xa;&#xa;★ 悪意ゼロ。接続方法を知らないだけ。&#xa;読者に「この子は嫌な奴ではない」&#xa;と最初の3行で伝える必要がある。" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="330" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="【機能B】「普通」の世界を設定&#xa;&#xa;三碓小学校の日常。&#xa;クラスメイトは悪い子ではない。&#xa;ただ「空気」で動く世界。&#xa;&#xa;樹はその「空気」が読めない。&#xa;→ 浮くのは必然。&#xa;→ いじめは悪意ではなく&#xa;　「理解不能なものへの排除反応」&#xa;&#xa;★ 社会の側も悪くない。&#xa;ズレているだけ。この「ズレ」が全幕の核。" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="390" y="120" width="330" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="【機能C】シュモクバエの導入&#xa;&#xa;樹がシュモクバエの話をする（or考える）。&#xa;「目の位置が離れているほどモテる。&#xa;　人間にとっては意味不明。&#xa;　でもシュモクバエにとっては法律」&#xa;&#xa;→ 社会ルールの恣意性への違和感。&#xa;→ PROLOGUE(日記)からの接続。&#xa;→ EPILOGUE(ケニア)への伏線。&#xa;&#xa;★ この比喩が物語全体を貫く中核イメージ。" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="740" y="120" width="330" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="f4" value="【機能D】value_change実現&#xa;&#xa;axis: つながり⇔孤立&#xa;from: 浮いていない（見えない存在）&#xa;to: クラスから距離を置かれる&#xa;&#xa;★ 「いじめ」の前段階。&#xa;まだ攻撃はない。無視に近い。&#xa;&#xa;樹は「仲良くしたい」のに&#xa;方法がわからないだけ。&#xa;このwantの表出が不可欠。" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="120" width="330" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="【機能E】伏線の埋設&#xa;&#xa;・パターン観察 → ACT2-S2（いじめ分析）&#xa;  → ACT4（コードレビュー）&#xa;・「なぜ」への執着 → 父の仮説思考&#xa;  → ACT4「なぜこう設計した？」&#xa;・感覚過敏 → S3デート（電車の音）&#xa;・目を合わせない → 秀斗「見下し」誤読&#xa;&#xa;★ S1の全要素が後のACTで再利用される。" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1440" y="120" width="330" height="210" as="geometry"/>
                </mxCell>

                <!-- SEC2: ビート案 -->
                <mxCell id="s2t" value="2. ビート構造案 — ピロティの昼休み" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#4A7FB5;" parent="1" vertex="1">
                    <mxGeometry x="40" y="370" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="Beat 1: 観察者としての樹&#xa;&#xa;昼休み。ピロティ。&#xa;クラスメイトが遊んでいる。&#xa;樹は隅で虫を観察している（or本を読む）。&#xa;&#xa;誰かが「須藤くんも来いや！」&#xa;樹「何をするの？」&#xa;「ドッジボール」&#xa;樹「ボールを当てる目的は何？」&#xa;&#xa;→ 空気が凍る。悪気なし。純粋な疑問。" style="rounded=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="410" width="340" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="Beat 2: ズレの蓄積&#xa;&#xa;授業中。先生「この問題わかる人？」&#xa;樹が即答。正しい。でも答え方が長い。&#xa;先生「……そうだね。もっと短く言える？」&#xa;クラスメイトが笑う。樹は何がおかしいか&#xa;わからない。&#xa;&#xa;★ 樹の内語：&#xa;「正しく説明したのに、なぜ笑うんだろう」&#xa;&#xa;→ ACT4のプロトタイプ：&#xa;「正しいのに、なぜ人が傷つくんだろう」" style="rounded=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="420" y="410" width="340" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="Beat 3: シュモクバエ&#xa;&#xa;放課後。樹が一人で帰る。&#xa;図鑑を開いている（or 虫を見つける）。&#xa;&#xa;内語 or 独白：&#xa;「シュモクバエは目が離れているほど&#xa;　モテる。人間にとって意味不明。&#xa;　でもシュモクバエは困っていない。&#xa;　困っているのは、ルールがわからない&#xa;　僕だけだ」&#xa;&#xa;→ 孤独の言語化。だが悲壮感はない。&#xa;→ 「ルールがわからない」＝テーマの種。" style="rounded=1;fillColor=#E8DAF0;strokeColor=#7B4F9E;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="800" y="410" width="340" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="Beat 4: 微かな欲求&#xa;&#xa;帰路。前を歩くクラスメイト数人が&#xa;楽しそうに話している。&#xa;樹は少し速足で近づく。&#xa;でも何を言えばいいかわからない。&#xa;速度を落とす。距離が開く。&#xa;&#xa;★ 読者にとって最も重要なビート：&#xa;「この子は人と繋がりたいんだ」&#xa;→ 冷たい人間ではない。接続方法がない。&#xa;→ この欲求がACT5の「走る」に至る原点。" style="rounded=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="410" width="340" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="ba1" style="strokeWidth=1;" parent="1" source="b1" target="b2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ba2" style="strokeWidth=1;" parent="1" source="b2" target="b3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ba3" style="strokeWidth=1;" parent="1" source="b3" target="b4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>

                <!-- SEC3: 接続・問い -->
                <mxCell id="s3t" value="3. 他シーンとの接続 + 設計問い" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#E67E22;" parent="1" vertex="1">
                    <mxGeometry x="40" y="650" width="600" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="→ S3 いじめの開始&#xa;&#xa;S1の「距離を置かれる」が&#xa;S3で「攻撃される」に変わる。&#xa;トリガー：秀斗の登場。&#xa;&#xa;秀斗はS1で樹を観察している？&#xa;→ FB1で「参観日」を見ている秀斗と&#xa;　接続するなら、S1に秀斗の影を&#xa;　入れておくべきか。" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="690" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="→ ACT1-S4 父から仮説を学ぶ&#xa;&#xa;S1で孤立した樹の「唯一の逃げ場」が&#xa;S4の父との面会。&#xa;&#xa;S1の孤独が深いほど、&#xa;S4の父の温かさが際立つ。&#xa;→ S1-S4のコントラスト設計が重要。" style="rounded=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="420" y="690" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="→ ACT5 + EPILOGUE&#xa;&#xa;S1のシュモクバエ → EPILOGUEで実物を見る。&#xa;S1の「繋がりたいが方法がない」&#xa;→ ACT5「わからないけど走る」。&#xa;&#xa;S1のBeat4（速足で近づいて止まる）と&#xa;ACT5（走って止まらない）の対比。" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="800" y="690" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="q1" value="【設計問い】書きやすさ評価&#xa;&#xa;✅ キャラ確立＝具体的行動で描ける&#xa;✅ シュモクバエ＝独白で書ける&#xa;✅ 短いビート4つで構成可能&#xa;△ 「空気が読めない」の描写粒度&#xa;△ 小6男子の言葉遣いのリアリティ&#xa;&#xa;★ 書きやすさ：中～高&#xa;外的事件が明確で、1000字に収まる。" style="rounded=1;fillColor=#FCF3CF;strokeColor=#d6b656;fontSize=9;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="690" width="340" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
