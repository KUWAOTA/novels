                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane5_title" value="&lt;b&gt;秀斗の内面（3層の矛盾）&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#E67E22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="530" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="shuto_surface" value="&lt;b&gt;表面: 殺意&lt;/b&gt;&lt;br&gt;「お前が俺を壊した」&lt;br&gt;「お前を殺しに来た」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontColor=#6E3B0A;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="570" width="140" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="shuto_mid" value="&lt;b&gt;中層: 嫉妬&lt;/b&gt;&lt;br&gt;「お前の家には別の法律があった」&lt;br&gt;「愛され方が違った」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontColor=#6E3B0A;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="570" width="140" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="shuto_deep" value="&lt;b&gt;深層: 承認欲求&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C0392B&quot;&gt;「この人に認められれば&lt;br&gt;父を超えられる」&lt;/font&gt;&lt;br&gt;= 止めてほしい" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#C0392B;strokeWidth=2;fontColor=#5C1B1B;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="660" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="shuto_s_m" style="strokeColor=#E67E22;strokeWidth=1;exitX=0.5;exitY=1;entryX=0;entryY=0;" parent="1" source="shuto_surface" target="shuto_deep" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="shuto_m_d" style="strokeColor=#E67E22;strokeWidth=1;exitX=0.5;exitY=1;entryX=1;entryY=0;" parent="1" source="shuto_mid" target="shuto_deep" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="shuto_note" value="&lt;i&gt;秀斗は連絡が樹に届くルートを&lt;br&gt;無意識に残している&lt;br&gt;= 止めてほしいから&lt;br&gt;だが本人は気づいていない&lt;/i&gt;" style="text;html=1;align=center;fontSize=9;fontColor=#6E3B0A;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="745" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lane6_title" value="&lt;b&gt;S1 Before/After 対比（scene-mastery）&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#1B3A5C;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="920" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="before_box" value="&lt;b&gt;BEFORE&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;br&gt;&lt;b&gt;樹:&lt;/b&gt; 鏡像認識後、立ちすくんでいる&lt;br&gt;（ACT4末の延長。思考の中にいる）&lt;br&gt;&lt;br&gt;&lt;b&gt;秀斗:&lt;/b&gt; 橋の欄干の外側にいる&lt;br&gt;（靴だけ揃えて来た。設定012）&lt;br&gt;&lt;br&gt;&lt;b&gt;関係:&lt;/b&gt; 加害者—被害者&lt;br&gt;（樹は加害を自覚しているが&lt;br&gt;どうしていいかわからない）&lt;br&gt;&lt;br&gt;&lt;b&gt;言葉:&lt;/b&gt; まだ機能すると信じている&lt;br&gt;（正しい言葉を探している）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="30" y="960" width="280" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="after_box" value="&lt;b&gt;AFTER&lt;/b&gt;&lt;br&gt;━━━━━━━━━━&lt;br&gt;&lt;br&gt;&lt;b&gt;樹:&lt;/b&gt; 体が先に動いた（走った）&lt;br&gt;→ だが言葉は出なかった&lt;br&gt;→ 体で止めたが心では止められてない&lt;br&gt;&lt;br&gt;&lt;b&gt;秀斗:&lt;/b&gt; 欄干の内側に引き戻された&lt;br&gt;→ だが呪詛は止まっていない&lt;br&gt;→ むしろ矛盾が露呈して混乱&lt;br&gt;&lt;br&gt;&lt;b&gt;関係:&lt;/b&gt; 加害者—被害者のまま&lt;br&gt;（ただし物理的には繋がっている）&lt;br&gt;&lt;br&gt;&lt;b&gt;言葉:&lt;/b&gt; &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;無力であることが証明された&lt;/b&gt;&lt;/font&gt;&lt;br&gt;（正しい言葉は存在しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontColor=#6E3B0A;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="430" y="960" width="280" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="ba_arrow" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="before_box" target="after_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ba_label" value="&lt;b&gt;S1の変換&lt;/b&gt;&lt;br&gt;理性 → 本能&lt;br&gt;（だが不完全。S2で完結）" style="text;html=1;align=center;fontSize=10;fontColor=#C0392B;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="320" y="1050" width="100" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="place_title" value="&lt;b&gt;場所の選択&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;fontColor=#1B3A5C;fontStyle=1;" parent="1" vertex="1">
