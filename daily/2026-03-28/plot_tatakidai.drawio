    </mxCell>

    <!-- ACT4 -->
    <mxCell id="act4" value="ACT 4 — 社会人" style="swimlane;startSize=26;fillColor=#FDEBD0;strokeColor=#E67E22;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="820" y="200" width="230" height="250" as="geometry"/>
    </mxCell>
    <mxCell id="a4_1" value="Google Japan就職&#xa;主人公：実力。A男：コミュ力" style="rounded=1;fillColor=#ffffff;strokeColor=#E67E22;fontSize=10;" vertex="1" parent="act4">
      <mxGeometry x="10" y="35" width="210" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="a4_2" value="主人公が先に昇進→A男が部下に&#xa;善意の「厳密な指導」開始" style="rounded=1;fillColor=#ffffff;strokeColor=#E67E22;fontSize=10;" vertex="1" parent="act4">
      <mxGeometry x="10" y="85" width="210" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="a4_3" value="A男が崩壊→出社不能&#xa;主人公：「自分がA男と同じことをしている」気づき" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="act4">
      <mxGeometry x="10" y="135" width="210" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="a4_turn" value="転換点：鏡像認識&#xa;→ 価値観の瓦解" style="rounded=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontStyle=1;fontSize=10;" vertex="1" parent="act4">
      <mxGeometry x="10" y="200" width="210" height="40" as="geometry"/>
    </mxCell>

    <!-- ACT5 -->
    <mxCell id="act5" value="ACT 5 — クライマックス" style="swimlane;startSize=26;fillColor=#FFE0E0;strokeColor=#C0392B;strokeWidth=2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1080" y="200" width="260" height="250" as="geometry"/>
    </mxCell>
    <mxCell id="a5_1" value="A男が自殺を企図&#xa;（B子の自殺トラウマが呼応）" style="rounded=1;fillColor=#FFE0E0;strokeColor=#C0392B;fontSize=10;" vertex="1" parent="act5">
      <mxGeometry x="10" y="35" width="240" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="a5_2" value="⚠️ 未設計：&#xa;主人公はどう行動するか？&#xa;具体場面・台詞なし" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="act5">
      <mxGeometry x="10" y="90" width="240" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="a5_3" value="結末：「理解できなくても寄り添う」&#xa;= 厳密さ + 曖昧さの統合" style="rounded=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=10;" vertex="1" parent="act5">
      <mxGeometry x="10" y="158" width="240" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="a5_turn" value="転換点：不可逆な価値変化&#xa;（統制概念の体現）" style="rounded=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontStyle=1;fontSize=10;" vertex="1" parent="act5">
      <mxGeometry x="10" y="212" width="240" height="30" as="geometry"/>
    </mxCell>

    <!-- ACT間の矢印 -->
    <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="act1" target="act2">
