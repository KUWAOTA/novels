    <!-- === 悩みポイント === -->
    <mxCell id="worry_title" value="悩みポイント・未解決事項" style="text;html=1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="490" width="300" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="w1" value="⚠️ ACT3の転換点が弱い&#xa;（内的確信のみ、外的事件なし）&#xa;→ 何か外部イベントを足すか？&#xa;→ それとも内的変化で十分か？" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="40" y="530" width="260" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="w2" value="⚠️ ACT5の具体場面が未設計&#xa;McKee必要条件：&#xa;□ 中央価値軸が決着&#xa;□ 不可逆な価値変化&#xa;□ 期待と結果の最大ギャップ&#xa;→ 黒田に相談したい" style="rounded=1;fillColor=#f8cecc;strokeColor=#C0392B;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="320" y="530" width="260" height="105" as="geometry"/>
    </mxCell>
    <mxCell id="w3" value="⚠️ 大きなプロット vs 幼少期から書く問題&#xa;（0309 伊庭指摘）&#xa;・大→小ブレイクダウンだとキャラが動くたびに矛盾する&#xa;・羅針盤程度にとどめて、幼少期から書く方が正解では？&#xa;・幼少期の虐めパートだけ短編として先に完成させるのもあり&#xa;→ 今の自分の方針：大枠は羅針盤、ACT1から書き始める&#xa;→ 黒田はどう思う？" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="600" y="530" width="380" height="115" as="geometry"/>
    </mxCell>
    <mxCell id="w4" value="❓ B子の知的障害設定が重い&#xa;→ 伝わるか？受け入れられるか？&#xa;→ 黒田の反応を確認したい" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="1000" y="530" width="260" height="75" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
