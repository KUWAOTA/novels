                <mxCell id="sec_fb" value="&lt;b&gt;FBのスタンス・スタイル（①の実現方法）&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#2E7D32;align=left;" parent="1" vertex="1">
                    <mxGeometry x="30" y="370" width="400" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="fb_style" value="&lt;ul style=&quot;margin:2px 0;padding-left:16px;text-align:left;font-size:11px&quot;&gt;&lt;li&gt;&lt;b style=&quot;color: rgb(198, 40, 40);&quot;&gt;「なぜダメか」の言語化&lt;/b&gt; — 感想でなく機能不全の理由を説明してほしい&lt;/li&gt;&lt;li&gt;&lt;b&gt;できている部分も言語化&lt;/b&gt; — 何が効いているかも知りたい&lt;/li&gt;&lt;li&gt;&lt;b&gt;論理的な指導スタイルがうれしい:&lt;/b&gt;&lt;br&gt;　現状「〇〇」→ 望む方向「△△」→ 不足「□□」→ 必要スキル「＊＊」&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;書籍の処方&lt;/b&gt; — 課題に対して「これを読め」→ 自走で勉強する型&lt;/li&gt;&lt;li&gt;&lt;b&gt;心理的安全性&lt;/b&gt;があると嬉しい。傷つきやすいので。&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingTop=4;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="30" y="398" width="560" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sec2" value="&lt;b&gt;FB形式（毎回相談して決める）&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#2E7D32;align=left;" parent="1" vertex="1">
                    <mxGeometry x="30" y="590" width="350" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="fb1" value="&lt;b&gt;原稿への赤入れ&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;Word/Docs等で&lt;br&gt;該当箇所に直接コメント&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="30" y="618" width="175" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="fb2" value="&lt;b&gt;総評&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;全体の印象・方向性を&lt;br&gt;文章でまとめる&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="225" y="618" width="175" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="fb3" value="&lt;b&gt;口頭ディスカッション&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;通話や対面で&lt;br&gt;やりとり（理想）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="420" y="618" width="175" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="fb_note" value="※ どの形式がいいかのディスカッション・コンサル自体もお願いしたい&lt;br&gt;※ 最初はプロット・サンプルシーンが多い想定（いきなり全文ではない）" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#888;align=left;" parent="1" vertex="1">
                    <mxGeometry x="30" y="693" width="500" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="sec3" value="&lt;b&gt;対象範囲（毎回スコープを決める）&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#E65100;align=left;" parent="1" vertex="1">
                    <mxGeometry x="660" y="370" width="350" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="scope" value="&lt;ul style=&#39;margin:2px 0;padding-left:16px;text-align:left;font-size:11px&#39;&gt;&lt;li&gt;完成原稿のFB&lt;/li&gt;&lt;li&gt;プロット・構成の相談（書く前の段階）&lt;/li&gt;&lt;li&gt;アイデア出し・ブレスト&lt;/li&gt;&lt;li&gt;読書案内（「この課題ならこれを読め」）&lt;/li&gt;&lt;li&gt;他作品の分析（「この小説のここはなぜ効くか」）&lt;/li&gt;&lt;li&gt;McKee理論の適用が正しいかの確認&lt;/li&gt;&lt;li&gt;AI×人間の役割分担の相談&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;fontSize=11;align=left;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="660" y="398" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="scope_note" value="何を強化し何を自分で進められるかを毎回相談" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#888;align=left;" parent="1" vertex="1">
                    <mxGeometry x="660" y="593" width="340" height="16" as="geometry"/>
