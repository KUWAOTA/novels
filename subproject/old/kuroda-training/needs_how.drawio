                <mxCell id="price" value="&lt;ul style=&quot;margin:2px 0;padding-left:16px;text-align:left;font-size:11px&quot;&gt;&lt;li&gt;&lt;b style=&quot;font-size:13px&quot;&gt;月2万台まで&lt;/b&gt;&lt;/li&gt;&lt;li&gt;参考: ムラマサ 55,000円/10回添削&lt;/li&gt;&lt;li&gt;月額 or 回数制は要相談&lt;/li&gt;&lt;li&gt;期間の目安も要相談&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#BA68C8;fontSize=11;align=left;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
