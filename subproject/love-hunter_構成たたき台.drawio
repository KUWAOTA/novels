<mxfile host="65bd71144e">
    <diagram id="arc" name="01_短編の骨格">
        <mxGraphModel dx="1898" dy="2304" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="970" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0" value="Love Hunter"/>
                <object label="&lt;b&gt;LOVE HUNTER｜仮ルート&lt;/b&gt;&lt;br&gt;相手を受け入れる人まで惚れさせ、&lt;br&gt;対等な関係を支配関係に変える。" tooltip="このページは三幕での因果のたたき台。男になる展開は、このルートには置かない。登場人物名、場所、年齢は未設定。" id="title">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;話の価値軸&lt;/b&gt;&lt;br&gt;相互的なつながり&lt;br&gt;⇄ 狩る側／獲物の非対称" tooltip="物語全体の価値変化は「対等なつながりの欠如 → 一度は手に入りそうになる → 主人公が支配関係を選び失う」。別の軸として、自己認識は「王子を探していると思う → 狩る快感が欲しいと認める」へ進む。" id="axis">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;主人公の思い違い&lt;/b&gt;&lt;br&gt;憧れの王子様に出会えば&lt;br&gt;性的な嫌悪も消えるはず" tooltip="主人公は自分の性的な欲求や反応をまだ理解していない。恋の話についていけない不安から「理想の人に選ばれたい」と願う。" id="misread">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;狩りの快感&lt;/b&gt;&lt;br&gt;性行為より、振り向かせ&lt;br&gt;特別扱いさせる瞬間" tooltip="相手に惚れられる予感、視線を独占する感覚、相手がこちらを優先する変化を快感として描く。主人公が本人の中で「本能」と呼ぶ欲求。性欲や性行為への欲求と同じものにしない。" id="prize">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;第1幕・始まり&lt;/b&gt;&lt;br&gt;王子様への憧れ" tooltip="各段階の起きたことと、主人公の見方の変化を短く記録する。" id="row0">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;恋の会話に入れない&lt;/b&gt;&lt;br&gt;恋の話が分からず&lt;br&gt;劣等感と不安を抱える" tooltip="恋愛の話題で自分だけ反応できず、他の子と違うという不安を抱く。本人は理由をまだ知らず、安心させてくれる「王子様」を求める。恋愛感情の有無や種類は未決定。" id="a11">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="40" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;初めての王子様&lt;/b&gt;&lt;br&gt;憧れのイケメンが近づき&lt;br&gt;「選ばれた」と浮き立つ" tooltip="主人公がイケメンを狙って近づき、相手からも好意を示される。手に入りかけた期待に高揚し、「やっと理想の恋が始まる」と思う。" id="a12">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="350" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;契機事件：カエル化&lt;/b&gt;&lt;br&gt;性的な関係を求められ&lt;br&gt;一転して気持ちが冷める" tooltip="彼が性的な関係へ進もうとすることをきっかけに、主人公は気持ちが冷え、相手をカエルのように感じる。これは主人公の反応として描く。彼の性欲が間違いだと作品全体が断定する必要はない。契機事件はこの落差で、次の相手を追う欲求を生む。" id="a13">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="660" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;次こそ理想の人&lt;/b&gt;&lt;br&gt;「彼が違っただけ」と考え&lt;br&gt;次のイケメンを自ら狙う" tooltip="主人公は一度の冷めを「相手選びの失敗」と誤解し、もっと条件のいいイケメンなら恋ができると次を探す。追いかけ、特別扱いを引き出す最中に高揚を覚え、ハントを繰り返す。" id="a14">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="970" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;第2幕・拡大&lt;/b&gt;&lt;br&gt;獲物の格を上げる" tooltip="各段階の起きたことと、主人公の見方の変化を短く記録する。" id="row1">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;転：芸能人も王子ではない&lt;/b&gt;&lt;br&gt;接触を迫られ、またカエル化&lt;br&gt;狩る快感は消えず強まる" tooltip="最高格の芸能人を獲得したと思っても、性的な関係を望まれれば再び気持ちが冷える。主人公は「正しい王子様探し」では解決しないと気づく一方、相手を振り向かせたい欲求がさらに広がっている。転は「どんな相手なら恋が叶うか」から「自分は何を狩っているか」への問いの反転。" id="a24">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="970" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;YouTuberから芸能人へ&lt;/b&gt;&lt;br&gt;肩書きと難度を上げて&lt;br&gt;「今度こそ」を追い続ける" tooltip="募集ツイートからYouTuberなど手が届きそうな有名人へ接触する。規模の反復にせず「特別な人に選ばれる」証拠を更新しようとする場面にする。" id="a23">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="660" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;外見と接点&lt;/b&gt;&lt;br&gt;資金を使って魅力を磨き&lt;br&gt;次の標的へ近づく" tooltip="外見を整える費用に資金を回す。変化は標的へ近づくための投資として描く。整形の具体的な内容、必要性、身体観は未決定。" id="a22">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="350" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;資金と手段&lt;/b&gt;&lt;br&gt;おじさんに貢がせるが&lt;br&gt;高揚より金策とリスク" tooltip="「おじさんに貢がせる」は資金を得る手段。相手を口説き落とす達成感は薄く、返礼や秘密の露見などのリスクが先に立つ。主人公は金をより理想に近い標的へ届く手段とみなす。" id="a21">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="40" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;第3幕・選択&lt;/b&gt;&lt;br&gt;受容者との関係" tooltip="各段階の起きたことと、主人公の見方の変化を短く記録する。" id="row2">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;対等さを求める人&lt;/b&gt;&lt;br&gt;主人公の境界を尊重し&lt;br&gt;対等な関係を望む" tooltip="主人公を攻略対象ではなく一人の人間として見て、性的な境界も尊重しながら対等さを望む人物が近づく。性別や人物像は未設定。" id="a31">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="40" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;受け入れられる&lt;/b&gt;&lt;br&gt;初めて安堵する一方&lt;br&gt;相手の好意を意識する" tooltip="この人となら恋愛や性行為を装わずにいられる、という安堵を主人公が感じる。安堵が恋愛感情を意味するかは決めず、受容される心地よさを行動で表す。" id="a32">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="350" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;相手を惚れさせていく&lt;/b&gt;&lt;br&gt;主人公が主導権を握り&lt;br&gt;相手は主人公を優先する" tooltip="主人公は相手の好意に応えないまま、好意を独占しようとする。返事を待たせ、相手が主人公の予定や機嫌を優先するようになる。相手がいつ変わるか、主人公がいつ自覚するかを場面で組み立てる。" id="a33">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="660" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;危機：両立しない願い&lt;/b&gt;&lt;br&gt;対等な相手を選ぶか&lt;br&gt;支配する快感を選ぶか" tooltip="主人公の「等しい相手に受け入れられたい」という願いと、「自分を求め続ける人を支配したい」という快感がぶつかる。どちらを取るかの選択が、クライマックスを呼ぶ。" id="a34">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="142" width="280" x="970" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;クライマックス&lt;/b&gt;&lt;br&gt;支配を選び、本能を認める" tooltip="結末案の具体化。第2ページで、同じ危機から分かれる別ルートと比較する。" id="finish-head">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="760" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;選択を言葉にする&lt;/b&gt;&lt;br&gt;対等な恋は返せない&lt;br&gt;それでも好意を手元に置く" tooltip="yellow" id="f1">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="760" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;関係が傾く&lt;/b&gt;&lt;br&gt;相手は主人公を選び&lt;br&gt;自分を合わせ始める" tooltip="yellow" id="f2">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="760" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;余波：狩る側を選ぶ&lt;/b&gt;&lt;br&gt;自分の欲求を認める&lt;br&gt;対等さは失われる" tooltip="yellow" id="f3">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="760" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;最後の像&lt;/b&gt;&lt;br&gt;相手が返事を待つ&lt;br&gt;主人公はその視線を味わう" tooltip="yellow" id="f4">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="760" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;未決：相手が残る理由&lt;/b&gt;&lt;br&gt;なぜ対等さを譲る？&lt;br&gt;何に惚れている？" tooltip="相手が対等な関係から支配される関係へ移るには、相手自身の欲求と代償も要る。主人公が求めるもの、相手が受け取るもの、相手が失うものを分けて決める。未決欄。" id="open1">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="-110" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;未決：関係の合意&lt;/b&gt;&lt;br&gt;相互に選んだ非対称？&lt;br&gt;一方的に利用する？" tooltip="「支配・被支配」を二人の合意した役割として描くか、主人公だけが得をする関係として描くか。どちらにするかで結末の受け取り方が変わる。" id="open2">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="-110" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;未決：主人公の自覚&lt;/b&gt;&lt;br&gt;いつ狩猟欲に気づく？&lt;br&gt;アセクの理解は？" tooltip="性行為への嫌悪、性的な惹かれの乏しさ、好意を求めること、相手を支配したい欲求をどう区別して自覚するか。本人が呼ぶ言葉と、物語が示す事実を分けて検討する。" id="open3">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="-110" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;未決：転の一撃&lt;/b&gt;&lt;br&gt;芸能人の何がだめ？&lt;br&gt;受容者は何を変える？" tooltip="芸能人の接近が王子様願望をどう終わらせるか。受容者が現れるだけでなく、主人公の中に膨らんだ狩猟欲をどんな行動で際立たせるか。" id="open4">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="-110" as="geometry"/>
                    </mxCell>
                </object>
