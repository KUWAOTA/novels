    </diagram>
    <diagram id="choice" name="02_危機・クライマックス・分岐">
        <mxGraphModel dx="1266" dy="890" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="800" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0" value="Love Hunter"/>
                <object label="&lt;b&gt;選択の設計&lt;/b&gt;&lt;br&gt;本能を受け入れる結末を主案に&lt;br&gt;対等を選ぶ分岐と比べる" tooltip="クライマックスと余波の二案。どちらも主人公が行動して結末を変える。Aがユーザーの今回の希望に沿う主案。" id="qtitle">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;価値の二層&lt;/b&gt;&lt;br&gt;関係：相互性 → 非対称&lt;br&gt;自覚：思い違い → 自認" tooltip="Aは自分への理解が進む一方で、相手との対等なつながりを失う。自己受容を単純な幸福・善とせず、何が得られ何を失うかを両方見せる。" id="qaxis">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;転の候補&lt;/b&gt;&lt;br&gt;最高の相手でも解決せず&lt;br&gt;受容者の愛を支配する" tooltip="一撃の反転案：相手の好意が深まるほど、主人公は安堵より「自分なしでいられない人を作れた」高揚に気づく。芸能人の不発をきっかけにするか、受容者との関係の進展をきっかけにするか、短編に残す場面を決める。" id="qtrigger">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;混同しない&lt;/b&gt;&lt;br&gt;性行為を嫌がることと&lt;br&gt;人を惚れさせたい欲求" tooltip="性的な惹かれと、人を惚れさせて優越感を得る欲求を別々に設計する。王子様願望、恋愛感情、受容されたい気持ちも同じとは限らない。" id="qready">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="36" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;危機：二者択一&lt;/b&gt;&lt;br&gt;高揚を取れば、&lt;br&gt;相互性を失う。" tooltip="主人公は両方が欲しい。相手の愛を自分への忠誠へ変えれば支配の高揚を得る一方、対等な愛情を返せない事実が残る。相手を解放すれば相手の自由を尊重できる一方、狩る喜びと自分を必要とする視線を失う。" id="qcrisis">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;A｜本能を選ぶ&lt;/b&gt;&lt;br&gt;好きになれないと知りつつ&lt;br&gt;相手の好意を手放さない" tooltip="主案。主人公は相手の愛を返せない事実を認めたうえで、自分に尽くしてほしいと伝える。駆け引きを続け、相手の好意を主導権に変える。人を支配したい欲求を、自分の本能として受け入れて生きる。" id="A1">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;B｜相手を自由にする&lt;/b&gt;&lt;br&gt;自分の好意は同じでないと伝え&lt;br&gt;相手を引き留めない" tooltip="別の決着。愛情を装って相手を従わせることをやめる。相手を失う可能性と、勝利・支配の高揚を得られない代償がある。自己理解を保ちながら、相互性を選ぶ。" id="B1">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;選択を迫る前の事実&lt;/b&gt;&lt;br&gt;相手が望む関係&lt;br&gt;主人公が返せるもの" tooltip="二人の望みのずれを具体化する。相手は何を求めるか。主人公は恋愛・性・一緒にいること・独占のどれを望むか。主人公が相手を惚れさせる過程に、どの程度の意図があるか。" id="qtruth">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="205" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;絶頂の行動&lt;/b&gt;&lt;br&gt;選択を実行する" tooltip="結末を決めるのは気づきだけでなく、主人公の行動。どちらの道を進んだか一目で分かる動作を置く。" id="qact">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;A｜関係を支配する&lt;/b&gt;&lt;br&gt;本心を告げて残るよう求める&lt;br&gt;相手の服従を受け入れる" tooltip="主人公は「恋人として同じように好きにはなれない。それでもあなたの好意を手元に置きたい」と明かし、相手が残ることを選ぶ。主人公は対等でない関係が成立した瞬間に、高揚を味わう。告白への返答と、二人が何に合意したかを描く。" id="A2">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;B｜対等を諦めない&lt;/b&gt;&lt;br&gt;欲求のずれを告げて手放す&lt;br&gt;相手の返事を尊重する" tooltip="主人公は同じ恋愛を返せないことと、支配したくなる自分の欲求を明かし、相手を引き留めない。相手が去るか、対等でない形を選ぶかは相手にも決定権を残す。" id="B2">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;選んだ代償&lt;/b&gt;&lt;br&gt;A：相互性を失い&lt;br&gt;B：狩りの高揚を失う" tooltip="両案とも主人公が何かを得て何かを失う。Aをただの解放や幸福に、Bを無傷の正しさにしない。" id="qcost">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="390" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;余波で示す&lt;/b&gt;&lt;br&gt;価値がどう変わったか" tooltip="クライマックス後の一動作で、決着を読者に見せる。" id="qend">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="40" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;A｜支配関係の継続&lt;/b&gt;&lt;br&gt;相手は主人公の返事を待ち&lt;br&gt;主人公はその視線に満たされる" tooltip="主案の着地。相手は対等な関係を求めて近づいたが、主人公の好意を得るために自分を合わせ始める。主人公はその非対称を理解している。性的な欲求が満たされる結末にはせず、狩りの充足を残す。" id="A3">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="350" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;B｜相互性を守る&lt;/b&gt;&lt;br&gt;相手は自分の道へ戻る&lt;br&gt;主人公は狩猟欲を自覚する" tooltip="分岐の着地。相手を手元に置けない結末でも、主人公は自分が何を欲していたか理解する。孤独が残る一方で、相手を獲物にしなかった選択は保たれる。" id="B3">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="660" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;本案の結末の意味&lt;/b&gt;&lt;br&gt;自己理解 ＋&lt;br&gt;相互性 −" tooltip="主人公は自分の欲求を認め、自分の生き方を選ぶ。しかし人を惚れさせ、従わせることを選んだため、対等なつながりを失う。この両面を保って終える。男になる展開はない。" id="qlast">
                    <mxCell parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6c7a89;fontColor=#172b4d;fontFamily=Yu Gothic UI;fontSize=14;spacing=8;verticalAlign=middle;align=center;" vertex="1">
                        <mxGeometry height="138" width="280" x="970" y="575" as="geometry"/>
                    </mxCell>
                </object>
                <mxCell id="e0" edge="1" parent="1" source="A1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#77808a;strokeWidth=1.5;endArrow=block;" target="A2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="1" source="A2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#77808a;strokeWidth=1.5;endArrow=block;" target="A3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" edge="1" parent="1" source="B1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#77808a;strokeWidth=1.5;endArrow=block;" target="B2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" edge="1" parent="1" source="B2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#77808a;strokeWidth=1.5;endArrow=block;" target="B3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
