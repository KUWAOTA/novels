    <diagram id="page2_questions" name="p.2 相談したい未解決箇所">
        <mxGraphModel dx="789" dy="287" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title_p2" value="相談したい未解決箇所" style="text;html=1;align=left;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle_p2" value="このページは「面談で相談したい論点」だけを示す。確定済の変更は p.1。" style="text;html=1;align=left;fontSize=11;fontColor=#555;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="55" width="800" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c1_head" value="① ACT3 の外的イベント不足" style="rounded=0;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="580" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c1_body" value="【現状】v5 plot に「構造上の弱点：外的イベント不足・要検討」と明記。&#xa;誤信念の強化が内面描写に偏り、外から信念を試す出来事が薄い。&#xa;&#xa;【聞きたいこと】&#xa;・外的イベントを足すべきか、内面主導のまま通すべきか。&#xa;・足すなら灘高校／東大のどちらのレイヤーに置くか。&#xa;・誤信念が強化される「成功体験」をどう物語化するか。" style="rounded=0;fillColor=#FDEDEC;strokeColor=#F5B7B1;fontSize=11;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="40" y="136" width="580" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c2_head" value="② FB（フラッシュバック）の配置" style="rounded=0;fillColor=#7B4F9E;strokeColor=#5B337E;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="660" y="100" width="580" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c2_body" value="【現状】FB_フラッシュバック／ 候補複数あり。特にFB2の位置と必要性が未決。&#xa;&#xa;【聞きたいこと】&#xa;・FBで提示したい情報は本筋中に溶かせないか。&#xa;・FBを残す場合、どのACTに埋め込むのが効果的か。&#xa;・「あんず生前」の情報をどこまで遅延開示するか。" style="rounded=0;fillColor=#E8DAF0;strokeColor=#D7BDE2;fontSize=11;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="660" y="136" width="580" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c3_head" value="③ ACT5-S2 父の台詞" style="rounded=0;fillColor=#4A7FB5;strokeColor=#2E5A85;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="370" width="580" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c3_body" value="【現状】クライマックス直後、父の台詞で主人公（樹）の価値軸を締めたい。&#xa;候補案はあるが、説教化／作者の言葉化するリスクあり。&#xa;&#xa;【聞きたいこと】&#xa;・父の視点から「導出可能な語彙」で着地させる方法。&#xa;・台詞ではなく沈黙／行動で代替できないか。&#xa;・30_style-discipline の「作者混入排除」観点で検証してもらいたい。" style="rounded=0;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=11;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="40" y="406" width="580" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c4_head" value="④ 文体設計の妥当性" style="rounded=0;fillColor=#2C3E50;strokeColor=#1B2631;fontColor=#ffffff;fontStyle=1;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="660" y="370" width="580" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c4_body" value="【現状】ACT1・ACT2で文体設計を作成済み（main/ACT1/文体設計.md 等）。&#xa;年齢推移＋誤信念の変質に応じた evolution_schedule の妥当性を見てほしい。&#xa;&#xa;【聞きたいこと】&#xa;・語り手（樹）の voice_identity は安定しているか。&#xa;・ACT1の小学生期→ACT4の社会人期の文体推移は自然か。&#xa;・1次審査通過の観点で改善点はあるか。" style="rounded=0;fillColor=#ECF0F1;strokeColor=#BDC3C7;fontSize=11;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="660" y="406" width="580" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="legend_p2" value="凡例　①赤=構造上の弱点　②紫=情報設計　③青=主人公/父　④灰=文体総括" style="text;html=1;align=left;fontSize=10;fontColor=#666;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="640" width="800" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
