    <!-- ========== 右：比較まとめ ========== -->
    <mxCell id="compare_label" value="【比較まとめ】" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="730" y="350" width="300" height="30" as="geometry" />
    </mxCell>

    <mxCell id="compare" value="比較項目　　　　|　内的独白　　|　自由間接文体&#xa;───────────────────────────&#xa;人称　　　　　　| 一・三人称　|　三人称&#xa;語り手の存在　　| ほぼなし　　|　薄くあり（溶け込む）&#xa;進行の速さ　　　| 遅い　　　　|　比較的速い&#xa;没入の強さ　　　| 非常に強い　|　強い（自然な形で）&#xa;フィルタ　　　　| なし（生の意識）|　薄いフィルタあり&#xa;読みやすさ　　　| 難しい場合あり|　読みやすい&#xa;断片性・非論理　| 高い　　　　|　中程度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=default;fontSize=11;align=left;fontFamily=monospace;" vertex="1" parent="1">
      <mxGeometry x="730" y="390" width="560" height="190" as="geometry" />
    </mxCell>

    <!-- コンパイラへの組み込み示唆 -->
    <mxCell id="compiler_label" value="【コンパイラへの組み込み示唆】" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="730" y="610" width="400" height="30" as="geometry" />
    </mxCell>

    <mxCell id="compiler" value="① 内的独白を使用中 → 進行速度低下の警告&#xa;　（27_show-vs-tell.yaml と連動：描写の密度チェック）&#xa;&#xa;② 自由間接文体を使用中 → 声の境界チェック&#xa;　「これは語り手の声か、キャラの意識か」が&#xa;　曖昧になっているかを確認する&#xa;&#xa;③ 28_pov.yaml との連動&#xa;　POVが first_person / free_indirect_discourse の場合、&#xa;　意識の流れモジュールを自動で有効化&#xa;&#xa;④ どちらも使わずに内面を説明口調で書いている場合&#xa;　→ INFO：意識の流れ手法の適用を検討してください" style="rounded=1;whiteSpace=wrap;html=1;fillColor=default;strokeColor=default;fontSize=11;align=left;" vertex="1" parent="1">
