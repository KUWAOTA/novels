<mxGraphModel adaptiveColors="auto" dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- タイトル -->
    <mxCell id="title" value="意識の流れ（Stream of Consciousness）— 概念と2つの表現手法" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="20" width="900" height="40" as="geometry" />
    </mxCell>

    <!-- ========== 上段：意識の流れとは何か ========== -->
    <mxCell id="concept_label" value="【意識の流れとは何か】" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="60" y="80" width="300" height="30" as="geometry" />
    </mxCell>

    <!-- 意識の流れ本体 -->
    <mxCell id="soc" value="意識の流れ&#xa;（Stream of Consciousness）&#xa;&#xa;人間の内側で時刻とともに&#xa;絶え間なく変化し続けている&#xa;思考・感覚・感情の連続体。&#xa;論理的ではなく、断片的で、&#xa;連想的に流れる。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="120" width="260" height="140" as="geometry" />
    </mxCell>

    <!-- 小説との関係 -->
    <mxCell id="relation" value="小説における役割&#xa;&#xa;意識の流れを描くことで、&#xa;読者をキャラクターの&#xa;主観的体験の中に「引きずり込む」。&#xa;外部の出来事より&#xa;内的体験を中心に据える手法。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="120" width="260" height="140" as="geometry" />
    </mxCell>

    <!-- soc → relation -->
    <mxCell id="e_sr" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="soc" target="relation" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 2つの表現手法 -->
    <mxCell id="methods_label" value="【文章での表現手法（2種類）】" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="60" y="310" width="400" height="30" as="geometry" />
    </mxCell>

    <!-- ========== 左：内的独白 ========== -->
    <mxCell id="im_header" value="① 内的独白&#xa;（Interior Monologue）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="60" y="350" width="260" height="60" as="geometry" />
    </mxCell>

    <mxCell id="im_what" value="何をするか&#xa;&#xa;キャラクターの意識を&#xa;フィルタなしで直接読者に流し込む。&#xa;「私は〜と思った」ではなく、&#xa;思考そのものを文章にする。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="430" width="260" height="100" as="geometry" />
    </mxCell>

    <mxCell id="im_person" value="人称：一人称 or 三人称限定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="550" width="260" height="40" as="geometry" />
    </mxCell>

    <mxCell id="im_effect" value="効果&#xa;• 深い内面への没入感&#xa;• 読者がキャラと一体化する&#xa;• 断片的・非論理的な表現が可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="60" y="610" width="260" height="80" as="geometry" />
    </mxCell>

    <mxCell id="im_cost" value="⚠ コスト&#xa;描写が細かくなるため&#xa;物語の進行が遅くなる（大きなデメリット）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#cc0000;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="710" width="260" height="60" as="geometry" />
    </mxCell>

    <mxCell id="im_example" value="例（内的独白）&#xa;「腹が減った。いや、違う。腹じゃない。&#xa;あの顔だ。また出てきた。消えろ。&#xa;消えるわけない。ずっとここにいる。」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffefc1;strokeColor=#d6b656;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="60" y="790" width="260" height="80" as="geometry" />
    </mxCell>

    <!-- 内的独白フロー矢印 -->
    <mxCell id="e_im1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="im_header" target="im_what" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_im2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="im_what" target="im_person" parent="1">
