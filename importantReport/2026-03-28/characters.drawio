                <mxCell id="bko" value="B子（故人・第2幕）" style="swimlane;startSize=26;fillColor=#E8DAF0;strokeColor=#7B4F9E;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="740" y="265" width="290" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="b_role" value="物語での装置としての役割" style="swimlane;startSize=20;fillColor=#d5b8ed;strokeColor=#6B4F9E;fontSize=10;fontStyle=1;" parent="bko" vertex="1">
                    <mxGeometry x="10" y="35" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b_role_a" value="主人公に「厳密な言葉があれば救えた」という&#xa;誤った信念を植え付けた人物。&#xa;実際は苦しみの果てではなく、幸せの絶頂で&#xa;自分の意志で死んだ。&#xa;→ この主人公の誤解が物語全体を動かす" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="b_role" vertex="1">
                    <mxGeometry x="5" y="22" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="属性" style="swimlane;startSize=20;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;" parent="bko" vertex="1">
                    <mxGeometry x="10" y="165" width="270" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b1a" value="知的障害（空気が読めない ≠ ASD）&#xa;非常に優しく自己肯定感が低い&#xa;主人公のきつい言い方を「優しい」と感じる&#xa;母：知的障害気味、娘をお荷物扱い&#xa;母の交際相手から性的虐待（「優しいふり」で洗脳）&#xa;→「優しさ＝性的な関係」と刷り込まれている" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="b1" vertex="1">
                    <mxGeometry x="5" y="22" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="この人物がいる理由（主人公との関係）" style="swimlane;startSize=20;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;" parent="bko" vertex="1">
                    <mxGeometry x="10" y="265" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="b2a" value="主人公と同じく「空気が読めない」タイプ&#xa;→主人公とは違い、知的障害起因&#xa;→ 主人公が自分を重ねて感情移入する&#xa;→ B子の死が主人公の人生の根拠になる" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="b2" vertex="1">
                    <mxGeometry x="5" y="22" width="260" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="自殺の構造（ここが核心）" style="swimlane;startSize=20;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;" parent="bko" vertex="1">
                    <mxGeometry x="10" y="355" width="270" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="b3a" value="【確定】母の交際相手による性的虐待&#xa;母：知的障害気味（望まぬ出産）、娘をお荷物扱い&#xa;交際相手：「優しいふり」で洗脳し性的搾取&#xa;→ B子は「優しさ＝性的な関係」と刷り込まれている&#xa;&#xa;デートでB子が主人公を性的に誘う&#xa;→ 主人公「大切な人とするのは付き合ってから」と断る&#xa;→ 初めて搾取のない優しさを知り、虐待の異常さに気づく&#xa;→ デート帰りの電車に飛び込み（「帰りたくない」）&#xa;&#xa;※ 主人公はこの真実を知らず誤信念を確立" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="b3" vertex="1">
                    <mxGeometry x="5" y="22" width="260" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="aman" value="広瀬こうすけ〈A男〉（第1幕→第4幕→第5幕）" style="swimlane;startSize=26;fillColor=#FDEBD0;strokeColor=#E67E22;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="265" width="280" height="580" as="geometry"/>
