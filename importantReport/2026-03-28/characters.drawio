                </mxCell>
                <mxCell id="f3" value="代表台詞&#xa;「百点取れなくても、お前はいい子なんだよ」&#xa;→ A男が一生引きずる言葉" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="father" vertex="1">
