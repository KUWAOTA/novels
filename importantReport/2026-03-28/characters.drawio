                <mxCell id="am_role" value="物語での装置としての役割" style="swimlane;startSize=20;fillColor=#f8d4a0;strokeColor=#C06010;fontSize=10;fontStyle=1;" parent="aman" vertex="1">
                    <mxGeometry x="10" y="35" width="260" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="am_role_a" value="主人公の「善意の厳しい指導」が&#xa;実は虐待の再演だったことを証明する人物。&#xa;A男が崩壊することで、主人公は&#xa;「自分の行いが暴力だった」と突きつけられる。" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="am_role" vertex="1">
                    <mxGeometry x="5" y="22" width="250" height="85" as="geometry"/>
