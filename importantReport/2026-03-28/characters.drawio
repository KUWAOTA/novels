                <mxCell id="am2" value="背景・傷" style="swimlane;startSize=20;fillColor=#fef3e2;strokeColor=#d79b00;fontSize=10;" parent="aman" vertex="1">
                    <mxGeometry x="10" y="250" width="260" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="am2a" value="教育虐待（母による）：&#xa;　母は短大出で学歴コンプレックスが強い&#xa;　100点を取っても「今まで何回負けた」と叩く&#xa;　泣きながら「お母さんのために頑張って」とすがる&#xa;主人公への嫉妬の核心：&#xa;　「百点取れなくてもいい子」という&#xa;　無条件の愛を自分は知らない&#xa;才能型の主人公への「努力って何だったんだ」感" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="am2" vertex="1">
                    <mxGeometry x="5" y="22" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="am3" value="いじめの手口" style="swimlane;startSize=20;fillColor=#fef3e2;strokeColor=#d79b00;fontSize=10;" parent="aman" vertex="1">
                    <mxGeometry x="10" y="375" width="260" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="am3a" value="評判の操作・孤立・精神攻撃が中心&#xa;物理的な暴力は少ないが、&#xa;親にされた暴力だけは主人公にもしてしまう" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="am3" vertex="1">
                    <mxGeometry x="5" y="22" width="250" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="am4" value="第4幕での展開" style="swimlane;startSize=20;fillColor=#fef3e2;strokeColor=#d79b00;fontSize=10;" parent="aman" vertex="1">
                    <mxGeometry x="10" y="470" width="260" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="am4a" value="主人公の「厳密な指導」が&#xa;A男の幼少期の虐待と同じ体験として刺さる&#xa;→ 崩壊・出社不能・自殺企図&#xa;→「自分の厳密さは暴力だった」を主人公に突きつける" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="am4" vertex="1">
