                    <mxGeometry x="10" y="160" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="am1a" value="努力型エリート（東工大卒）&#xa;コミュニケーション能力が高い&#xa;（親のご機嫌をうかがって育った）" style="text;strokeColor=none;fillColor=none;fontSize=10;align=left;spacingLeft=6;" parent="am1" vertex="1">
