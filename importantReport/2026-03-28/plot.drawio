                <mxCell id="sl0" value="各幕の役割" style="rounded=0;fillColor=#2C3E50;strokeColor=#2C3E50;fontColor=#ffffff;fontStyle=1;fontSize=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="102" width="90" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="主人公の弱点・信念・喪失の起源を描く。&#xa;「なぜこの人物がこうなったか」を&#xa;読者が体感する幕。A男の嫉妬の種もここで撒かれる。" style="rounded=0;fillColor=#ECF0F1;strokeColor=#BDC3C7;fontSize=10;align=left;spacingLeft=8;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="130" y="102" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="物語の最大の引き金が発射される幕。&#xa;B子の自殺によって主人公の誤信念が確立し、&#xa;以後の全行動の根拠になる。" style="rounded=0;fillColor=#FDEDEC;strokeColor=#F5B7B1;fontSize=10;align=left;spacingLeft=8;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="450" y="102" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="誤信念が証拠によって強化され確信に至る幕。&#xa;外から見える出来事が少なく内的変化が中心&#xa;（構造上の弱点あり・要相談）。" style="rounded=0;fillColor=#ECF0F1;strokeColor=#BDC3C7;fontSize=10;align=left;spacingLeft=8;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="770" y="102" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="誤信念が現実に敗北し崩壊が始まる幕。&#xa;主人公が「自分はA男と同じことをしている」&#xa;と気づく転換点がここ。" style="rounded=0;fillColor=#FEF5E7;strokeColor=#FAD7A0;fontSize=10;align=left;spacingLeft=8;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="102" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="全ての伏線が一点に交わる最高潮。&#xa;B子の死（引き金）とA男の崩壊（転換点）が重なり、&#xa;主人公が「理解できなくても愛する」を選択する。" style="rounded=0;fillColor=#FDEDEC;strokeColor=#F5B7B1;fontSize=10;align=left;spacingLeft=8;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="102" width="310" height="90" as="geometry"/>
                </mxCell>
