                <mxCell id="rl3" value="B子&#xa;（サブ）" style="rounded=0;fillColor=#8E44AD;strokeColor=#8E44AD;fontColor=#ffffff;fontStyle=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
