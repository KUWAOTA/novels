                <mxCell id="sep4" value="" style="line;strokeColor=#C0392B;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="42" width="1" height="1340" as="geometry"/>
                </mxCell>
                <mxCell id="m1a" value="&lt;b&gt;ASD傾向で孤立&lt;/b&gt;&lt;br&gt;感情・空気が読めずクラスに馴染めない&lt;br&gt;なぜ浮いているかも分からないまま&lt;br&gt;一方的にいじめられる&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 読者が主人公に共感する入口&lt;/font&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="140" y="202" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m1b" value="&lt;b&gt;父から「仮説を立てること」を学ぶ&lt;/b&gt;&lt;br&gt;月1回の病院面会&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;トラブルにあった際に、「空気読めるようになろうね」ではなく、&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;「相手がなぜ攻撃してくるのか」を言葉で説明してくれる&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;そして、本を読み相手のふるまいに対する仮説を立て、&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;それを踏まえて行動する重要さを主人公に伝える。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;そして、母やクラスメイトと違い、主人公のことを異質で&lt;/div&gt;&lt;div&gt;「感情に配慮してくれない存在」だと見なして排斥しない。&lt;/div&gt;&lt;div&gt;唯一自分のことを同じ人間として受容してくれる存在&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 厳密さ信仰の起源&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="140" y="322" width="300" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="m1t" value="★ 父の死（中1直後）&#xa;「来月も来る」約束を残して死去&#xa;唯一の理解者を失う&#xa;孤立がさらに深まる&#xa;&#xa;↳ ACT2誤信念確立の土台" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="140" y="532" width="300" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="am1ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86C1;strokeWidth=1.5;" parent="1" source="m1a" target="m1b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="am1bt" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=1.5;" parent="1" source="m1b" target="m1t" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m2a" value="&lt;b&gt;保健室でB子と出会う&lt;/b&gt;&lt;br&gt;父の死後、孤立した状態で保健室通い&lt;br&gt;論理的でキツい言い方を&lt;br&gt;B子は「優しい」と感じる&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 実は言語が噛み合っていない&lt;/font&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="460" y="202" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m2b" value="&lt;b&gt;論理でいじめをかわす&lt;/b&gt;&lt;br&gt;A男の攻撃パターンを記録・分析して対処&lt;br&gt;「仮説と検証で身を守れる」と確信する&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 誤信念が機能しているように見える場面&lt;/font&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="460" y="322" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m2t" value="★ 引き金：B子の自殺&#xa;デートの翌日にB子が自殺&#xa;主人公は「苦しみの末に死んだ」と誤解&#xa;「厳密な言語があれば救えた」&#xa;という誤信念を確立する&#xa;&#xa;↳ 物語全体を動かす最大の引き金&#xa;この誤解が全悲劇の根本" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="460" y="442" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="am2ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86C1;strokeWidth=1.5;" parent="1" source="m2a" target="m2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="am2bt" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=1.5;" parent="1" source="m2b" target="m2t" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m3a" value="&lt;b&gt;灘・東大で「証明」される&lt;/b&gt;&lt;br&gt;論理が通じる集団に初めて入る&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;居心地のいいコミュニケーションが成立し、初めて社会に適応&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;出来る成功体験をする。&lt;br&gt;&lt;/font&gt;「厳密な言語が通じる世界は実在する」&lt;br&gt;という体験が積み上がる&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 誤信念が「正しい」と思い込む実証が増える&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="780" y="202" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3b" value="&lt;b&gt;「B子をここに連れてこれれば」という後悔&lt;/b&gt;&lt;br&gt;「この環境にいれば死ななかった」&lt;br&gt;「厳密な言語を社会に広めることが使命」&lt;br&gt;という確信が固まる&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 誤信念に使命感という燃料が加わる&lt;/font&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="780" y="332" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3w" value="&lt;b&gt;⚠️ 構造上の課題&lt;/b&gt;&lt;br&gt;外から見える出来事がなく&lt;br&gt;物語が止まって見える可能性がある&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#7D6608&quot;&gt;→ 外的事件を追加するか黒田に相談したい&lt;/font&gt;" style="rounded=1;fillColor=#FEF9E7;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="780" y="462" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="am3ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86C1;strokeWidth=1.5;" parent="1" source="m3a" target="m3b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m4a" value="&lt;div&gt;&lt;b&gt;A男と共に外資系トップIT企業に入社&lt;/b&gt;&lt;/div&gt;&lt;b&gt;昇進 → A男が部下になる&lt;/b&gt;&lt;br&gt;「善意」から明確な言葉で報告するように指導を開始する&lt;br&gt;加害の自覚はない&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 誤信念が他者への行動として現れる&lt;/font&gt;" style="rounded=1;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="202" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m4b" value="&lt;b&gt;正しく説明したのに人が壊れた&lt;/b&gt;&lt;br&gt;A男が崩壊・出社不能になる&lt;br&gt;「正しく説明すれば理解できる」&lt;br&gt;という信念が初めて現実に敗北する&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1A5276&quot;&gt;↳ 信仰の崩壊が始まる&lt;/font&gt;" style="rounded=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="322" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m4t" value="★ 転換点：鏡像認識&#xa;自分がA男にしてきたことは&#xa;かつてA男が自分にしてきた&#xa;いじめと同じ構造だと気づく&#xa;&#xa;↳ 善意の正しさが暴力になりうると自覚" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="452" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="am4ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E86C1;strokeWidth=1.5;" parent="1" source="m4a" target="m4b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="am4bt" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=1.5;" parent="1" source="m4b" target="m4t" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m5a" value="★★ A男の自殺未遂&#xa;B子の死のトラウマが呼び起こされる&#xa;「また自分のせいで人が死ぬ」&#xa;「厳密さを捨てれば救えるのか」という問いに直面&#xa;&#xa;↳ 物語の最高潮" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="202" width="290" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m5b" value="&lt;b&gt;「理解できなくても愛する」選択&lt;/b&gt;&lt;br&gt;「厳密さを捨てる」でも「諦める」でもない&lt;br&gt;理解できなくても関わり続けるという&lt;br&gt;第三の選択をする&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1E8449&quot;&gt;↳ テーマが行動として現れる。旅の完結&lt;/font&gt;" style="rounded=1;fillColor=#D4EFDF;strokeColor=#28A745;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="342" width="290" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="m5w" value="&lt;b&gt;⚠️ 最重要未解決課題&lt;/b&gt;&lt;br&gt;具体的にどんな行動をとるか未設計&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#7D6608&quot;&gt;→ 黒田への最大の相談事項&lt;/font&gt;" style="rounded=1;fillColor=#FEF9E7;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="482" width="290" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="am5ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#28A745;strokeWidth=1.5;" parent="1" source="m5a" target="m5b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a1a" value="&lt;b&gt;嫉妬の核心：二重の羨望【更新】&lt;/b&gt;&lt;br&gt;才能型の瀬野たくやが努力せず良い成績を取る&lt;br&gt;父から無条件の愛を受けている&lt;br&gt;広瀬こうすけは母（短大出・学歴コンプ）から&lt;br&gt;100点でも「瀬野君に何回負けた」と叩かれ&lt;br&gt;泣きながら「おかあさんのために頑張って」とすがられる&lt;br&gt;→ 暴力＋罪悪感の二重束縛&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#784212&quot;&gt;↳ A男は悪役でなく傷ついた人間&lt;br&gt;読者がA男の側にも苦しめる設計&lt;br&gt;↳ ACT1時点ではいじめはまだない可能性あり&lt;/font&gt;" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="140" y="652" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="a1b" value="&lt;b&gt;いじめを開始&lt;/b&gt;&lt;br&gt;評判操作・孤立・精神攻撃が中心&lt;br&gt;親から受けた暴力だけは主人公にも再現してしまう&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#784212&quot;&gt;↳ 受けた暴力が次の人間に連鎖する構造&lt;/font&gt;" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="140" y="812" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="aa1ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E67E22;strokeWidth=1.5;" parent="1" source="a1a" target="a1b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2a" value="&lt;b&gt;教育虐待の加速&lt;/b&gt;&lt;br&gt;中学に入り家庭での暴力がさらに激化&lt;br&gt;「学年1位でなければ価値がない」&lt;br&gt;という信念が刻み込まれる" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="460" y="652" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a2b" value="&lt;b&gt;いじめが過激化（双方が苦しい）&lt;/b&gt;&lt;br&gt;主人公への攻撃が激化する一方&lt;br&gt;A男自身も家庭で暴力を受けている&lt;br&gt;加害者でありながら被害者でもある&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#784212&quot;&gt;↳ どちらの側に立っても苦しい設計&lt;/font&gt;" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="460" y="772" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="aa2ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E67E22;strokeWidth=1.5;" parent="1" source="a2a" target="a2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3a" value="&lt;b&gt;連敗の蓄積&lt;/b&gt;&lt;br&gt;灘落ち → 二番手高校&lt;br&gt;東大落ち → 東工大&lt;br&gt;「努力の正義が通じない」怒りと屈辱が積み重なる&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#784212&quot;&gt;↳ ACT4での追跡行動の動機を準備する&lt;/font&gt;" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="780" y="652" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="a4a" value="&lt;b&gt;主人公を追いGoogle Japan入社&lt;/b&gt;&lt;br&gt;「今度こそ勝つ」という動機で入社&lt;br&gt;しかし昇進できず主人公の部下になる&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#784212&quot;&gt;↳ 追跡が最悪の形で終わる&lt;/font&gt;" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="652" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a4b" value="&lt;b&gt;「厳密な指導」が虐待の再現として刺さる&lt;/b&gt;&lt;br&gt;「なぜ理解できないのか」という詰めが&lt;br&gt;母からの「なぜ百点でないのか」&lt;br&gt;と同じ暴力として体験される&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#784212&quot;&gt;↳ 同じ行動が立場で全く異なる意味を持つ&lt;/font&gt;" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="772" width="300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="a4t" value="⚡ 崩壊・出社不能" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;spacingTop=6;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="912" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="aa4ab" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E67E22;strokeWidth=1.5;" parent="1" source="a4a" target="a4b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="aa4bt" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=1.5;" parent="1" source="a4b" target="a4t" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a5t" value="★★ 自殺を企図&#xa;父への怒り・主人公への嫉妬・&#xa;職場での再虐待体験が重なり限界を迎える&#xa;&#xa;↳ B子の死と呼応し&#xa;主人公のトラウマを呼び覚ます" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="652" width="290" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="b1e" value="（登場なし）" style="text;strokeColor=none;fillColor=none;fontSize=10;fontColor=#aaaaaa;" parent="1" vertex="1">
                    <mxGeometry x="140" y="1060" width="300" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="b2a" value="&lt;b&gt;保健室で主人公と出会う【設定更新】&lt;/b&gt;&lt;br&gt;知的障害により周りの空気が読めず、孤立した存在&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;学校ではいじめ、家庭では性的虐待を受けている&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;知的障害のため虐待を「異常」と認識できていない&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;主人公のキツい言い方を「優しい」と感じる&lt;br&gt;（「けなされて当然」という自己観から）&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4A235A&quot;&gt;↳ 通じ合っているように見えて実はズレている&lt;br&gt;↳ 学校以外のB子の側面（家庭）が自殺の核心&lt;br&gt;主人公の誤信念の穴を体現する存在&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1032" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b2t" value="★ デート後の自殺【確定】&#xa;母の交際相手による性的虐待（「優しいふり」で洗脳）&#xa;B子は「優しさ＝性的な関係」と刷り込まれている&#xa;デートでB子が主人公を性的に誘う&#xa;→ 主人公「大切な人とするのは付き合ってから」と断る&#xa;→ 初めて搾取のない優しさを知り虐待の異常さに気づく&#xa;→ デート帰りの電車に飛び込み（「帰りたくない」）&#xa;&#xa;↳「偽の優しさ」vs「本当の優しさ」の対比が核心&#xa;↳ 主人公は真実を知らず誤信念を確立" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1200" width="300" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="ab2at" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8E44AD;strokeWidth=1.5;" parent="1" source="b2a" target="b2t" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="b3g" value="（故人 — 回想のみ）" style="rounded=1;fillColor=#F5EEF8;strokeColor=#D7BDE2;fontSize=10;fontColor=#aaaaaa;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="780" y="1060" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="b4g" value="（故人 — 回想のみ）" style="rounded=1;fillColor=#F5EEF8;strokeColor=#D7BDE2;fontSize=10;fontColor=#aaaaaa;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="1060" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="&lt;b&gt;A男の自殺未遂でB子が想起される&lt;/b&gt;&lt;br&gt;「またあの時と同じことが起きる」&lt;br&gt;トラウマが主人公の行動を突き動かす&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4A235A&quot;&gt;↳ ACT2の引き金がACT5で回収される&lt;br&gt;物語の円環が閉じる瞬間&lt;/font&gt;" style="rounded=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=10;align=left;spacingLeft=8;spacingTop=8;spacingBottom=8;html=1;verticalAlign=top;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="1032" width="290" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="cross1" value="誤信念の根拠として機能" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8E44AD;strokeWidth=2;dashed=1;fontSize=9;fontColor=#8E44AD;" parent="1" source="b2t" target="m2t" edge="1">
                    <mxGeometry x="-0.1653" y="40" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="770" y="1274.5"/>
                            <mxPoint x="770" y="517"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cross2" value="ACT2の引き金が回収される" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8E44AD;strokeWidth=2;dashed=1;fontSize=9;fontColor=#8E44AD;" parent="1" source="b2t" target="b5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="wt" value="⚠️ 悩みポイント・黒田への相談" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1410" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="w1" value="ACT3：外的出来事がなく&#xa;物語が止まって見える&#xa;何か事件を加えるか？" style="rounded=1;fillColor=#FEF9E7;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1442" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="w2" value="ACT5：「理解できなくても愛する」を&#xa;具体的にどんな行動で示すか未設計&#xa;最重要課題" style="rounded=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=10;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="345" y="1442" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="w3" value="B子の自殺【設定更新済】：&#xa;家庭内性的虐待＋デートの対比で&#xa;「もう帰りたくない」→ 死を選ぶ&#xa;旧設定「幸せの頂点で自殺」より自然" style="rounded=1;fillColor=#D5F5E3;strokeColor=#28A745;fontSize=10;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="650" y="1442" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="w4" value="大きなプロット vs ACT1から書く問題：&#xa;大枠は羅針盤、ACT1から書き始める方針&#xa;でいいか黒田に確認したい" style="rounded=1;fillColor=#EBF5FB;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="955" y="1442" width="310" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="今は、時系列順で書くことを想定していたが、&#xa;ACT3から書いたほうがいいのでは？の意見ももらっている。&#xa;書き始める時系列についても相談したい。" style="rounded=1;fillColor=#EBF5FB;strokeColor=#2E86C1;fontSize=10;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1530" width="290" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="他の方から、受けたアドバイス" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1626" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="表層的な面白さと、内面的な面白さがストーリーにはあるのではと考えている。&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;前者は出来事で、後者は心理描写。&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;いきなり後者に没入させるのは困難であるので、出来事としてのインパクトの強い、B子の死から書き始めてはどうか&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;とのアドバイスをもらった。&lt;br&gt;&lt;/font&gt;&lt;div&gt;アドバイス① 書いてみなきゃわからない要素が多すぎるので、まず書いた方がいい気がする&amp;nbsp;&lt;/div&gt;&lt;div&gt;アドバイス② 間違ってたと思っていたことが、実は正しいということがわかるようなエピソードがあってもいいのではないか&lt;/div&gt;&lt;div&gt;その方がテーマをよく示すことができるのではないか&amp;nbsp;&lt;/div&gt;&lt;div&gt;アドバイス③ 書くとしたら、クライマックスか、エピローグを書いた方がいい気がする&amp;nbsp;&lt;/div&gt;&lt;div&gt;読後感の設計ができるので、 そこから逆算していける&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="30" y="1660" width="700" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="A男が主人公をいじめるという設定が生きていない気がする。&#xa;B子の死が重要なのであってそこに埋もれている気がする。" style="rounded=1;fillColor=#FEF9E7;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="350" y="1530" width="290" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>