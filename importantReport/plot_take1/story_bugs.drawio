                </mxCell>
                <mxCell id="leg1" value="CRITICAL（矛盾・論理破綻）" style="rounded=1;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontSize=9;" parent="legend" vertex="1">
                    <mxGeometry x="5" y="26" width="145" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="leg2" value="WARNING（設定の弱点）" style="rounded=1;fillColor=#E67E22;strokeColor=#A04000;fontColor=#ffffff;fontSize=9;" parent="legend" vertex="1">
                    <mxGeometry x="155" y="26" width="140" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="leg3" value="OPPORTUNITY（深掘り候補）" style="rounded=1;fillColor=#2E86C1;strokeColor=#1B4F72;fontColor=#ffffff;fontSize=9;" parent="legend" vertex="1">
                    <mxGeometry x="300" y="26" width="155" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="crit_header" value="CRITICAL — 矛盾・論理破綻（放置すると物語が壊れる）" style="rounded=0;fillColor=#C0392B;strokeColor=#922B21;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="1180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="BUG-01：B子の死亡タイミングが矛盾" style="swimlane;startSize=22;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="380" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="c1a" value="【矛盾箇所】&#xa;・主人公メモ：「デートの翌日にB子が自殺」&#xa;・B子メモ：「デート帰りの電車で飛び込み」&#xa;&#xa;【影響】&#xa;翌日なら主人公は「なぜ？」と思うだけ。&#xa;デート帰りの電車なら「別れた直後」になり、&#xa;主人公の罪悪感の質が全く変わる。&#xa;&#xa;【推奨】デート帰りの電車に統一。&#xa;主人公は「自分と別れた後すぐ」と知る&#xa;→ 誤解の方向が決まる。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="c1" vertex="1">
                    <mxGeometry x="5" y="24" width="370" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="BUG-02：主人公が「苦しみの末」と誤解する根拠が弱い" style="swimlane;startSize=22;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="150" width="390" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="c2a" value="【問題】&#xa;デート帰りの電車で飛び込んだなら、主人公は&#xa;「楽しいデートの直後になぜ？」と考えるのが自然。&#xa;「苦しみの末に死んだ」と誤解するには根拠が必要。&#xa;&#xa;【深掘り候補】&#xa;① 主人公はデート帰りだと知らない（別の日と思っている）&#xa;② 学校のいじめ情報だけが主人公に届く&#xa;③ 「デート帰り」の事実が隠蔽される（警察→学校→噂）&#xa;④ ASD特性で「楽しかったのに死んだ」を処理できず、&#xa;  「実は苦しんでいたのに自分が気づけなかった」&#xa;  と解釈してしまう&#xa;&#xa;→これあり" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="c2" vertex="1">
                    <mxGeometry x="5" y="24" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="BUG-03：ACT1のA男いじめ開始が自己矛盾" style="swimlane;startSize=22;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="150" width="390" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="c3a" value="【矛盾箇所】&#xa;・ACT1エピソード「A男_いじめを開始」が存在&#xa;・A男エピソードメモ内に「この時点ではA男の&#xa;  主人公に対するいじめなくてもいいかもな」&#xa;&#xa;【構造的問題（story-compiler）】&#xa;ACT1でいじめを始めると、A男が「悪役」として&#xa;固定されやすく、読者が共感する余地が狭まる。&#xa;McKee理論：敵対力の人間性が浅い = warning&#xa;&#xa;【推奨】ACT1ではA男の嫉妬だけを描き、&#xa;いじめ開始はACT2（父の死後・環境変化後）に移す。&#xa;→ A男も「追い詰められた結果の加害」になる&#xa;→それでいいと思う" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="c3" vertex="1">
                    <mxGeometry x="5" y="24" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="warn_header" value="WARNING — 設定の弱点・不自然さ（修正すればストーリーが深まる）" style="rounded=0;fillColor=#E67E22;strokeColor=#A04000;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="360" width="1180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="w1" value="BUG-04：B子の「優しさの刷り込み」と&#xa;「主人公を優しいと感じる」の整合性" style="swimlane;startSize=32;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="400" width="380" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="w1a" value="【問題】&#xa;・旧設定：「けなされて当然」だから主人公のキツい&#xa;  言い方を退けない → 受動的な理由&#xa;・新設定：「優しさ＝性的な関係」と刷り込まれている&#xa;&#xa;この2つは矛盾する。性的でない主人公の態度を&#xa;B子が「優しい」と感じる理由が曖昧になった。&#xa;&#xa;【クリティカルヒット候補】&#xa;B子は主人公を「優しくない人」と最初は思う。&#xa;なぜなら性的に近づいてこないから。&#xa;でも「なんか居心地がいい」と混乱する。&#xa;→ 刷り込みが壊れていく過程そのものを描ける" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="w1" vertex="1">
                    <mxGeometry x="5" y="34" width="370" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="w2" value="BUG-05：A男のGoogle入社が&#xa;「偶然の過剰使用」に見える" style="swimlane;startSize=32;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="400" width="390" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="w2a" value="【story-compiler基準：偶然の制約違反】&#xa;偶然は物語の開始には使えるが、解決には使えない。&#xa;A男が主人公と同じGoogle Japanに入る＝偶然。&#xa;A男の追跡の結果なら偶然ではないが、&#xa;「追跡してまで入社する動機」が嫉妬だけでは弱い。&#xa;&#xa;【深掘り候補】&#xa;① A男は主人公を「追っている」のではなく&#xa;  「逃げられない」（主人公が自分の価値基準）&#xa;② 母が「瀬野くんと同じ会社に入れ」と&#xa;  直接圧力をかけている&#xa;③ コミュ力で入社 → 結局「母に植え付けられた&#xa;  能力」で入社してしまう皮肉&#xa;&#xa;→そのつもりで行こうと思っていました。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="w2" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="w3" value="BUG-06：ACT3に外的イベントがない&#xa;（構造的空白）" style="swimlane;startSize=32;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="400" width="390" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="w3a" value="【story-compiler基準：孤立イベント / 横ばいシーン】&#xa;ACT3は「誤信念の強化」だが、内的変化のみ。&#xa;McKee理論：価値が横ばいのシーン = 無効なシーン&#xa;&#xa;【深掘り候補】&#xa;① 灘/東大で「B子に似た人」と出会い&#xa;  助けようとして失敗する&#xa;  → 誤信念の強化が行動で示される&#xa;② A男の連敗をACT3内でもっと描く&#xa;  → 二人の距離が広がる外的イベント&#xa;③ 主人公が「厳密な言語コミュニティ」を&#xa;  作ろうとして、排他的になるエピソード&#xa;  → 誤信念が暴力に変わる予兆をACT3に配置" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="w3" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="w4" value="BUG-07：ACT5「理解できなくても愛する」&#xa;の具体的行動が未設計" style="swimlane;startSize=32;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="380" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="w4a" value="【story-compiler基準：クライマックスの必須条件違反】&#xa;不可逆的価値変化が「行動」で体現されていない。&#xa;「抱きしめる」だけでは「理解を超えた愛」が&#xa;示せない可能性がある。&#xa;&#xa;【深掘り候補】&#xa;① A男を助けるために主人公が&#xa;  「厳密さ」を武器として使えない場面を作る&#xa;  → 論理が通じない相手に対して&#xa;  「それでも手を離さない」選択&#xa;② B子の真実がACT5で判明し、&#xa;  主人公が「自分の善意が殺した」と知る&#xa;  → それでもA男に手を伸ばす＝二重の贖罪" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="w4" vertex="1">
                    <mxGeometry x="5" y="34" width="370" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="w5" value="BUG-08：主人公がB子の家庭環境を&#xa;全く知らないのは不自然" style="swimlane;startSize=32;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="610" width="390" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="w5a" value="【問題】&#xa;恋人同士（デートする関係）なのに、B子の&#xa;家庭について主人公が何も知らないのは不自然。&#xa;&#xa;【ただし成立する条件】&#xa;・B子：知的障害のため言語化できない&#xa;・主人公：ASDのため相手の状況を察せない&#xa;・B子は虐待を「普通」と思っているから話題にしない&#xa;→ 二重の障壁で「知らない」は成立するが、&#xa;  その障壁を読者に見せる描写が必要。&#xa;&#xa;【クリティカルヒット候補】&#xa;B子が家庭の話を「楽しそうに」する描写。&#xa;主人公はASDで違和感に気づけない。&#xa;読者だけが気づく → ドラマティック・アイロニー" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="w5" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="w6" value="BUG-09：A男の嫉妬を「参観日」で&#xa;目撃する状況の不自然さ" style="swimlane;startSize=32;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="610" width="390" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="w6a" value="【問題】&#xa;父は入院中で月1回の面会。参観日に車いすで来る&#xa;設定だが、A男がその台詞を聞く状況が不自然。&#xa;&#xa;エピソードメモでは「それを横で聞いてたこうすけ」&#xa;とあるが、病院面会を横で聞くのは無理がある。&#xa;&#xa;【推奨】&#xa;場面を学校に統一する。例えば：&#xa;・参観日に車いすの父が来る（最後の機会）&#xa;・テスト返却時、主人公が「1問できなかった」と言う&#xa;・父が「できない問題があるからテストに意味がある」&#xa;  と優しく答える&#xa;・A男はそれを教室の隅で聞いている&#xa;→ 帰宅後に100点を母に報告する対比シーンへ" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="w6" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="opp_header" value="OPPORTUNITY — 深掘りでクリティカルヒットに化ける候補" style="rounded=0;fillColor=#2E86C1;strokeColor=#1B4F72;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="830" width="1180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="o1" value="OPP-01：B子の母の知的障害＝&#xa;テーマの鏡像" style="swimlane;startSize=32;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="870" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="o1a" value="B子の母も知的障害気味（望まぬ出産）。&#xa;自分に似て「馬鹿な」娘をお荷物扱い。&#xa;&#xa;→ これは「理解できない他者を愛せない」&#xa;  の具体例そのもの。&#xa;&#xa;母はB子を「理解できない」から愛せなかった。&#xa;主人公は最終的に「理解できなくても愛する」を選ぶ。&#xa;→ B子の母 = 主人公が選ばなかった未来の鏡像&#xa;&#xa;この並行構造を意識的に描けば、&#xa;テーマが言葉でなく構造で語られる。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="o1" vertex="1">
                    <mxGeometry x="5" y="34" width="370" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="o2" value="OPP-02：A男の母と主人公の母の&#xa;鏡像関係が未活用" style="swimlane;startSize=32;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="870" width="390" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="o2a" value="主人公の母：「鈍臭いあんたが勉強できなかったら&#xa;いじめられる」と刷り込む（努力の強要）&#xa;A男の母：「100点取って。おかあさんのために」&#xa;と泣きすがる（成果の強要）&#xa;&#xa;→ 両方とも「子どもの能力で自分を守ろうとする母」&#xa;→ 同じ構造の異なる表現&#xa;&#xa;主人公は母に刷り込まれた「努力」をA男に強要し、&#xa;A男は母に刷り込まれた「成果」を主人公に求める。&#xa;→ 母の呪いが子を通じて互いを傷つける構造" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="o2" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="o3" value="OPP-03：「善意が人を殺す」の&#xa;三重構造が未設計" style="swimlane;startSize=32;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="870" width="390" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="o3a" value="物語には「善意が人を殺す」が3回出現する：&#xa;&#xa;① ACT2：主人公のデート → B子の死&#xa;② ACT4：主人公の教育 → A男の崩壊&#xa;③ ACT1：A男の母の「愛」→ A男の破壊&#xa;&#xa;①②は意識されているが、③との並行が未活用。&#xa;A男の母は「息子のために」頑張らせている＝善意。&#xa;&#xa;→ 主人公がACT5で気づくべきは&#xa;  「善意が暴力になる」だけでなく、&#xa;  「善意を暴力に変えてしまう構造は&#xa;   誰の中にもある」という普遍性。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="o3" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="o4" value="OPP-04：B子の交際相手の「偽の優しさ」と&#xa;主人公の父の「本当の優しさ」の対比" style="swimlane;startSize=32;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1060" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="o4a" value="主人公の父：無条件の愛。「100点でなくてもいい子」&#xa;B子の交際相手：条件付きの偽愛。性的搾取のための優しさ&#xa;&#xa;→ 主人公が受けた愛と、B子が受けた偽愛は正反対&#xa;→ しかし主人公は父の愛を「厳密さの起源」としてしか&#xa;  解釈していない（本当は「無条件の受容」が本質）&#xa;&#xa;ACT5で主人公がA男を抱きしめるとき、&#xa;それは父がしてくれたことの再現。&#xa;「厳密さ」ではなく「無条件の受容」こそが&#xa;父から受け継いだ本当の遺産だと気づく瞬間。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="o4" vertex="1">
                    <mxGeometry x="5" y="34" width="370" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="o5" value="OPP-05：B子の真実がACT5で判明すれば&#xa;クライマックスが二段構えになる" style="swimlane;startSize=32;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="430" y="1060" width="390" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="o5a" value="現状：主人公はB子の真実を知らないまま物語が終わる。&#xa;&#xa;【もしACT5で真実が判明したら】&#xa;① A男の自殺未遂 → トラウマ呼び起こし&#xa;② B子の真実判明 → 「自分の善意が殺した」と知る&#xa;③ それでもA男に手を伸ばす&#xa;&#xa;→ ②が入ることで、主人公は&#xa;  「厳密さが足りなかった」どころか&#xa;  「自分の優しさそのものが人を殺した」と突きつけられる。&#xa;  それでも愛する選択をする＝究極の試練&#xa;&#xa;判明の経路：警察記録？ B子の母との再会？" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="o5" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="o6" value="OPP-06：視点ポリシーが未定義&#xa;（story-compiler: compile_error）" style="swimlane;startSize=32;fillColor=#D6EAF8;strokeColor=#2E86C1;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="830" y="1060" width="390" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="o6a" value="【story-compiler基準：必須未定義】&#xa;一人称？三人称限定？全知？が未宣言。&#xa;&#xa;【この物語での影響が大きい】&#xa;・一人称（主人公視点）：&#xa;  B子の虐待は読者も知らない → ACT5で衝撃&#xa;  しかしB子の内面が一切描けない&#xa;・三人称限定（主人公カメラ）：&#xa;  同上だがやや柔軟&#xa;・三人称で視点移動あり：&#xa;  B子パートで読者だけが虐待を知る&#xa;  → ドラマティック・アイロニーが可能&#xa;&#xa;B子の「性的に誘うシーン」のカメラ位置が&#xa;特に重要。主人公視点だと意味が変わる。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="o6" vertex="1">
                    <mxGeometry x="5" y="34" width="380" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
