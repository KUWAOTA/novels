<mxGraphModel dx="2200" dy="3000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="3000" math="0" shadow="0">
    <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style='font-size:20px'&gt;PROLOGUE シーン分析マップ&lt;/b&gt;&lt;br&gt;&lt;br&gt;「日記形式 : 大人の樹が幼少期の日記を読み返す」&lt;br&gt;子供の頃「僕は人間じゃないかもしれない」と書いた日記。シュモクバエの内的独白。&lt;br&gt;&lt;i&gt;一人の独白。孤独。内省的。&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1B3A5C;fillColor=none;strokeColor=none;" parent="1" vertex="1">
            <mxGeometry x="350" y="30" width="1500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sec1_title" value="&lt;b&gt;SECTION 1: このシーンが達成すべきこと&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;fontColor=#1B4332;fontStyle=1;" parent="1" vertex="1">
            <mxGeometry x="30" y="160" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="must1" value="&lt;b&gt;① 物語全体の「問い」を提示&lt;/b&gt;&lt;br&gt;&lt;br&gt;「もし自分がいる場所を変えたら？」&lt;br&gt;= Frame the entire story&lt;br&gt;&lt;br&gt;読者が最初に受け取る問い:&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;「人間じゃないかもしれない」&lt;/b&gt;&lt;/font&gt;&lt;br&gt;と感じる子供は、どこへ行くのか？&lt;br&gt;&lt;br&gt;EPILOGUEで回答される:&lt;br&gt;→ ケニアで笑っている" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontColor=#1B4332;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="30" y="200" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="must2" value="&lt;b&gt;② 樹のASD傾向を体感させる&lt;/b&gt;&lt;br&gt;&lt;br&gt;説明ではなく、日記の文体自体で&lt;br&gt;読者に「この子は違う」と伝える&lt;br&gt;&lt;br&gt;• 異常に精密な観察&lt;br&gt;• 感情ではなく分類で世界を記述&lt;br&gt;• 「人間じゃないかも」= 分類不能の恐怖&lt;br&gt;&lt;br&gt;&lt;font color='#4A7FB5'&gt;&lt;b&gt;読者体験: 共感ではなく驚嘆&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ 徐々に共感へ変わるのが全5ACT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="340" y="200" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="must3" value="&lt;b&gt;③ シュモクバエの導入&lt;/b&gt;&lt;br&gt;&lt;br&gt;中心イメージの初出。&lt;br&gt;子供の樹がシュモクバエに&lt;br&gt;強烈に惹かれる理由:&lt;br&gt;&lt;br&gt;• 目が離れている = 「普通」と違う&lt;br&gt;• でも生きている = 存在の肯定&lt;br&gt;• 恣意的なルール = 世界の不条理&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;「すべてを理解しようとする」&lt;/b&gt;&lt;/font&gt;&lt;br&gt;衝動の起源がここにある" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontColor=#1B4332;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="650" y="200" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="must4" value="&lt;b&gt;④ 読者のフック / 牽引力&lt;/b&gt;&lt;br&gt;&lt;br&gt;プロローグは読者を引き留める&lt;br&gt;最初で最後のチャンス&lt;br&gt;&lt;br&gt;フック要素:&lt;br&gt;• 「僕は人間じゃないかも」→ 衝撃&lt;br&gt;• 大人の樹の声 → 時間軸の謎&lt;br&gt;• シュモクバエ → 異質な美しさ&lt;br&gt;&lt;br&gt;&lt;font color='#4A7FB5'&gt;&lt;b&gt;Question planted:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;この子はどうなるのか？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="960" y="200" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="must5" value="&lt;b&gt;⑤ EPILOGUE対構造の「A面」設定&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;PROLOGUE = 一人の独白&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#28A745'&gt;&lt;b&gt;EPILOGUE = 二人で笑う&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;この対比が物語の根幹構造。&lt;br&gt;PROLOGUEで「孤独」を&lt;br&gt;刻印しておくことで、&lt;br&gt;EPILOGUEの「笑い」が響く。&lt;br&gt;&lt;br&gt;トーン: 静謐、内省、孤立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontColor=#5C1B1B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="1270" y="200" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="sec2_title" value="&lt;b&gt;SECTION 2: 現在の課題 / 不足しているもの&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;fontColor=#C0392B;fontStyle=1;" parent="1" vertex="1">
            <mxGeometry x="30" y="460" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="issue1" value="&lt;b&gt;❌ 複数バージョンが未統合&lt;/b&gt;&lt;br&gt;&lt;br&gt;omote.mdに複数バージョンが存在&lt;br&gt;→ どれが正式版か未確定&lt;br&gt;&lt;br&gt;必要な判断:&lt;br&gt;• 大人の樹の声を入れるか？&lt;br&gt;• 純粋な子供の日記のみか？&lt;br&gt;• 二重構造（日記＋大人の注釈）か？&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;ステータス: ほぼ完成だが&lt;br&gt;最終形が未決定&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontColor=#5C1B1B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="30" y="500" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="issue2" value="&lt;b&gt;❓ 大人の樹の声の扱い&lt;/b&gt;&lt;br&gt;&lt;br&gt;選択肢:&lt;br&gt;&lt;br&gt;&lt;b&gt;A) フレーム型&lt;/b&gt;&lt;br&gt;大人の樹が日記を開く → 日記本文&lt;br&gt;→ 日記を閉じる（短い内省）&lt;br&gt;&lt;br&gt;&lt;b&gt;B) 純粋日記型&lt;/b&gt;&lt;br&gt;子供の声のみ。大人の存在は暗示&lt;br&gt;&lt;br&gt;&lt;b&gt;C) 二重声型&lt;/b&gt;&lt;br&gt;日記＋大人の注釈が交互&lt;br&gt;&lt;br&gt;&lt;font color='#4A7FB5'&gt;&lt;b&gt;推奨: A) or B)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;C)は情報過多になるリスク" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontColor=#6E3B0A;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="340" y="500" width="280" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="issue3" value="&lt;b&gt;❓ 情報開示量の問題&lt;/b&gt;&lt;br&gt;&lt;br&gt;PROLOGUEでどこまで見せるか？&lt;br&gt;&lt;br&gt;見せすぎリスク:&lt;br&gt;• ASD傾向を明示 → 読者がラベル貼り&lt;br&gt;• シュモクバエの意味を説明 → 謎が消失&lt;br&gt;• 結末を暗示しすぎ → 予測可能に&lt;br&gt;&lt;br&gt;見せなさすぎリスク:&lt;br&gt;• 読者がフックを感じない&lt;br&gt;• 「何の話？」で離脱&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;黄金比: 感覚は伝える、&lt;br&gt;説明はしない&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontColor=#5C1B1B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="650" y="500" width="280" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="issue4" value="&lt;b&gt;❓ トーン統一の課題&lt;/b&gt;&lt;br&gt;&lt;br&gt;子供の日記 → 素朴、断片的&lt;br&gt;シュモクバエの独白 → 詩的、抽象的&lt;br&gt;&lt;br&gt;この二つの声のトーンが&lt;br&gt;矛盾なく共存できるか？&lt;br&gt;&lt;br&gt;案: 子供の精密さが&lt;br&gt;独白の詩的さの&lt;b&gt;源泉&lt;/b&gt;として&lt;br&gt;機能するようにする&lt;br&gt;&lt;br&gt;「観察が精密すぎるから詩になる」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="960" y="500" width="280" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="e_i1_m5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" parent="1" source="issue1" target="must5" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_i2_m4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E67E22;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="issue2" target="must4" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_i3_m3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="issue3" target="must3" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sec3_title" value="&lt;b&gt;SECTION 3: ビート構造案 / シーンフロー&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;fontColor=#4A7FB5;fontStyle=1;" parent="1" vertex="1">
            <mxGeometry x="30" y="820" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="beat1" value="&lt;b&gt;Beat 1: 導入&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;（大人の樹の声 / フレーム型の場合）&lt;br&gt;古い段ボール箱。小学生の頃のノート。&lt;br&gt;開くと丸い字。&lt;br&gt;&lt;br&gt;あるいは:&lt;br&gt;いきなり日記の文体で始まる。&lt;br&gt;読者は子供の声だと気づく。&lt;br&gt;&lt;br&gt;&lt;font color='#4A7FB5'&gt;&lt;b&gt;★ 冒頭1文が全てを決める&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="30" y="870" width="300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="beat2" value="&lt;b&gt;Beat 2:「僕は人間じゃないかも」&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;子供の樹の観察記録:&lt;br&gt;• クラスメイトの行動パターン分析&lt;br&gt;• 「みんなは知ってるルールがある。&lt;br&gt;   僕だけ教えてもらえなかった」&lt;br&gt;• 自分が「違う種類」かもしれない恐怖&lt;br&gt;&lt;br&gt;文体: 精密だが幼い。&lt;br&gt;感情語が少ない。&lt;br&gt;代わりに観察データが並ぶ。&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;核心:「人間じゃないかもしれない」&lt;/b&gt;&lt;/font&gt;&lt;br&gt;= 分類から溢れる自分への恐怖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="370" y="870" width="320" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="beat3" value="&lt;b&gt;Beat 3: シュモクバエの発見&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;図鑑で見つけた異形の虫。&lt;br&gt;目が体の外に飛び出している。&lt;br&gt;&lt;br&gt;子供の樹:&lt;br&gt;「こんな変な形なのに、ちゃんと&lt;br&gt;生きてる。飛べるし、仲間もいる」&lt;br&gt;&lt;br&gt;暗黙のメッセージ:&lt;br&gt;&lt;font color='#28A745'&gt;&lt;b&gt;「変」でも存在していい&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;ただし子供はまだこの意味を&lt;br&gt;言語化できない → ACT5で回収" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontColor=#1B4332;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="730" y="870" width="300" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="beat4" value="&lt;b&gt;Beat 4: シュモクバエの内的独白&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;日記から逸脱して詩的な内的独白へ。&lt;br&gt;シュモクバエの視点（幻想的）:&lt;br&gt;&lt;br&gt;• 目が離れているから世界が広い&lt;br&gt;• 理解の外側にある美しさ&lt;br&gt;• 恣意的なルールの中で生きること&lt;br&gt;&lt;br&gt;読者へ:&lt;br&gt;この独白は&lt;b&gt;樹の無意識の声&lt;/b&gt;。&lt;br&gt;子供が言語化できないものを&lt;br&gt;シュモクバエが代弁している。&lt;br&gt;&lt;br&gt;&lt;font color='#7B4F9E'&gt;&lt;b&gt;EPILOGUEで実物に会った時、&lt;br&gt;「意外と目は離れてない」&lt;br&gt;→ 幻想と現実の乖離が完結する&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAF0;strokeColor=#7B4F9E;fontColor=#3D1F5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="1070" y="870" width="320" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="beat5" value="&lt;b&gt;Beat 5: 閉じ / 余韻&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;日記の最後の一文。&lt;br&gt;問いを残して終わる:&lt;br&gt;&lt;br&gt;「もし僕が別の場所にいたら、&lt;br&gt;  人間になれるかな」&lt;br&gt;&lt;br&gt;（大人のフレームがある場合）&lt;br&gt;日記を閉じる。沈黙。&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;この問いの答え = 物語全体&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="1430" y="870" width="300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="e_b1b2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4A7FB5;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="beat1" target="beat2" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_b2b3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4A7FB5;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="beat2" target="beat3" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_b3b4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7B4F9E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="beat3" target="beat4" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_b4b5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4A7FB5;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="beat4" target="beat5" edge="1">
            <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sec4_title" value="&lt;b&gt;SECTION 4: 他シーンとの接続&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;fontColor=#7B4F9E;fontStyle=1;" parent="1" vertex="1">
            <mxGeometry x="30" y="1240" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="conn_epi" value="&lt;b&gt;↔ EPILOGUE（根幹の対構造）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;PROLOGUE: 一人の独白&lt;/font&gt;&lt;br&gt;&lt;font color='#28A745'&gt;EPILOGUE: 二人で笑う&lt;/font&gt;&lt;br&gt;&lt;br&gt;PROLOGUE:「人間じゃないかも」&lt;br&gt;EPILOGUE: 人間かどうかはもうどうでもいい&lt;br&gt;&lt;br&gt;PROLOGUE: シュモクバエ = 幻想の救い&lt;br&gt;EPILOGUE: シュモクバエ = 現実は地味&lt;br&gt;   → でもそれでいい&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;★ 物語の最も重要な対称軸&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontColor=#5C1B1B;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="30" y="1290" width="340" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="conn_act1" value="&lt;b&gt;→ ACT1（日記の時代）&lt;/b&gt;&lt;br&gt;&lt;br&gt;PROLOGUEの日記 = ACT1の時代&lt;br&gt;&lt;br&gt;ACT1-S1: ASD傾向で孤立&lt;br&gt;→ 日記に書かれた「ルールがわからない」&lt;br&gt;&lt;br&gt;ACT1-S4: 父から仮説を学ぶ&lt;br&gt;→ 日記に書かれた精密な観察力の源泉&lt;br&gt;&lt;br&gt;PROLOGUEの「僕は人間じゃない」&lt;br&gt;が ACT1の具体エピソードで&lt;br&gt;肉付けされる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontColor=#1B3A5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="410" y="1290" width="300" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="conn_act2" value="&lt;b&gt;→ ACT2（あんずとの出会い）&lt;/b&gt;&lt;br&gt;&lt;br&gt;PROLOGUEで「変でも存在していい」&lt;br&gt;を暗示するシュモクバエ&lt;br&gt;&lt;br&gt;ACT2であんずが&lt;b&gt;言葉なしで&lt;/b&gt;&lt;br&gt;これを体現する:&lt;br&gt;保健室で黙って隣にいる&lt;br&gt;&lt;br&gt;&lt;font color='#7B4F9E'&gt;&lt;b&gt;PROLOGUEの問い（変でもいい？）&lt;br&gt;→ ACT2の暫定回答（いいよ）&lt;br&gt;→ ACT2の喪失（でも失われる）&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAF0;strokeColor=#7B4F9E;fontColor=#3D1F5C;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="750" y="1290" width="300" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="conn_act5" value="&lt;b&gt;→ ACT5（シュモクバエの解決）&lt;/b&gt;&lt;br&gt;&lt;br&gt;PROLOGUEで植えたシュモクバエの種:&lt;br&gt;&lt;br&gt;ACT5-S2:「シュモクバエ、見に行かん？」&lt;br&gt;= PROLOGUEの幻想を現実にする決断&lt;br&gt;= 「理解できなくても行動する」初めて&lt;br&gt;&lt;br&gt;子供の頃の「いつか見たい」が&lt;br&gt;大人になって「見に行こう」に変わる&lt;br&gt;= 成長ではなく&lt;font color='#C0392B'&gt;&lt;b&gt;回帰&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;子供の直感 → 大人の論理 → 子供の直感&lt;br&gt;螺旋構造で元の場所に戻るが高さが違う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontColor=#1B4332;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="1090" y="1290" width="340" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="e_conn_epi_act5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#C0392B;strokeWidth=2;dashed=1;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" parent="1" source="conn_epi" target="conn_act5" edge="1">
            <mxGeometry relative="1" as="geometry">
