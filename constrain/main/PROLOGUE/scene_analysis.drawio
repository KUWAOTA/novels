        <mxCell id="sec5_title" value="&lt;b&gt;SECTION 5: ステータス / 制作メモ&lt;/b&gt;" style="text;html=1;align=left;fontSize=15;fontColor=#856404;fontStyle=1;" parent="1" vertex="1">
            <mxGeometry x="30" y="1610" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;執筆ステータス&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ 複数バージョン存在（omote.md）&lt;br&gt;✅ 日記形式は確定&lt;br&gt;✅ シュモクバエの内的独白あり&lt;br&gt;❌ 最終バージョン未確定&lt;br&gt;❓ 大人の樹の声の有無・分量&lt;br&gt;❓ 情報開示量の最終調整" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;fontColor=#856404;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="30" y="1660" width="300" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="memo" value="&lt;b&gt;制作メモ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 1000字以内を目指す（プロローグは短く）&lt;br&gt;• EPILOGUE執筆後にPROLOGUEを最終調整するのが理想&lt;br&gt;  → 対構造の呼応を確認してから&lt;br&gt;• シュモクバエの描写は「子供の図鑑体験」に留める&lt;br&gt;  → 学術的になりすぎない&lt;br&gt;• 関西弁は使わない（まだ東京在住の時期）&lt;br&gt;• 「人間じゃないかもしれない」= この物語の最初の1音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;fontColor=#856404;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
            <mxGeometry x="370" y="1660" width="400" height="180" as="geometry"/>
        </mxCell>
