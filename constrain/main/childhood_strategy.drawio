                    <mxGeometry x="40" y="300" width="380" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="p8_phase1_title" value="▶ 父がいる時代 — 安全基地（Secure Base）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#28A745;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="305" width="360" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev1" value="クラスメイトに&lt;br&gt;ノートを破られる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="55" y="335" width="130" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev2" value="&lt;b&gt;混乱&lt;/b&gt;&lt;br&gt;「なんで？」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#999;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="55" y="390" width="130" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev3" value="&lt;b&gt;父に話す&lt;/b&gt;&lt;br&gt;「あの子はね、お父さんに&lt;br&gt;怒られてて辛いんだよ」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="55" y="440" width="160" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev4" value="&lt;b&gt;「わかった！」&lt;/b&gt;&lt;br&gt;世界が整理される&lt;br&gt;安心が戻る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=10;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="55" y="510" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev5" value="→ 翌日学校に行ける" style="text;html=1;fontSize=10;fontColor=#28A745;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="55" y="565" width="160" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p8_key_insight" value="&lt;b style=&#39;font-size:12px;color:#4A7FB5&#39;&gt;ここで子どもが学習すること&lt;/b&gt;&lt;hr&gt;&lt;span style=&#39;font-size:11px&#39;&gt;言葉にしてもらうと → 安心する&lt;br&gt;説明されると → 怖くなくなる&lt;br&gt;わかると → 大丈夫になる&lt;br&gt;&lt;br&gt;&lt;b style=&#39;font-size:13px;color:#2980B9&#39;&gt;「わかれば、大丈夫」&lt;/b&gt;&lt;br&gt;&lt;br&gt;これは知的活動ではない。&lt;br&gt;&lt;b&gt;恐怖を鎮める方法&lt;/b&gt;として&lt;br&gt;身体に刻まれた反応。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=11;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="235" y="335" width="175" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a1" style="endArrow=classic;strokeColor=#999;strokeWidth=1;endSize=4;" parent="1" source="p8_ev1" target="p8_ev2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a2" style="endArrow=classic;strokeColor=#999;strokeWidth=1;endSize=4;" parent="1" source="p8_ev2" target="p8_ev3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a3" style="endArrow=classic;strokeColor=#999;strokeWidth=1;endSize=4;" parent="1" source="p8_ev3" target="p8_ev4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_phase2_bg" value="" style="rounded=1;fillColor=#FFF3F3;strokeColor=#C0392B;strokeWidth=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="450" y="300" width="380" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="p8_phase2_title" value="▶ 父の死後 — 安全基地の喪失" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#C0392B;align=left;" parent="1" vertex="1">
                    <mxGeometry x="460" y="305" width="360" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev2_1" value="クラスメイトに&lt;br&gt;何かされる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="465" y="335" width="130" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev2_2" value="&lt;b&gt;混乱&lt;/b&gt;&lt;br&gt;「なんで？」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#999;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="465" y="390" width="130" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev2_3" value="&lt;b&gt;父がいない&lt;/b&gt;&lt;br&gt;説明してくれる人が&lt;br&gt;いない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="465" y="440" width="145" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p8_ev2_4" value="&lt;b style=&#39;color:#C0392B&#39;&gt;恐怖が鎮まらない&lt;/b&gt;&lt;br&gt;世界が意味不明のまま&lt;br&gt;安心が戻らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="465" y="505" width="155" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a2_1" style="endArrow=classic;strokeColor=#999;strokeWidth=1;endSize=4;" parent="1" source="p8_ev2_1" target="p8_ev2_2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a2_2" style="endArrow=classic;strokeColor=#999;strokeWidth=1;endSize=4;" parent="1" source="p8_ev2_2" target="p8_ev2_3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a2_3" style="endArrow=classic;strokeColor=#999;strokeWidth=1;endSize=4;" parent="1" source="p8_ev2_3" target="p8_ev2_4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_critical" value="&lt;b style=&#39;font-size:12px;color:#C0392B&#39;&gt;ここで子どもが選ぶこと&lt;/b&gt;&lt;hr&gt;&lt;span style=&#39;font-size:11px&#39;&gt;父がいないなら&lt;br&gt;&lt;b style=&#39;font-size:14px&#39;&gt;自分が父になる&lt;/b&gt;&lt;br&gt;&lt;br&gt;自分で説明する。&lt;br&gt;自分で言葉にする。&lt;br&gt;自分で「わかった」を作る。&lt;br&gt;&lt;br&gt;これは知的好奇心ではない。&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;パニックを止める&lt;br&gt;唯一の方法&lt;/b&gt;。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="340" width="175" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p8_death_arrow" value="父の死" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=5;endSize=10;fontColor=#C0392B;fontSize=13;fontStyle=1;" parent="1" edge="1">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint x="425" y="480" as="sourcePoint"/>
                        <mxPoint x="455" y="480" as="targetPoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p8_sec3" value="■ 欲求の再定式化 — 3つの層" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="870" y="260" width="600" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p8_layer1" value="&lt;b style=&#39;font-size:14px&#39;&gt;Layer 1: 身体感覚&lt;/b&gt;&lt;br&gt;（子どもが感じていること）&lt;hr&gt;&lt;span style=&#39;font-size:14px;color:#C0392B&#39;&gt;&lt;b&gt;怖い。わからない。&lt;br&gt;わかれば怖くなくなる。&lt;br&gt;だから言葉にする。&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#888&#39;&gt;これが欲求の&lt;b&gt;生の形&lt;/b&gt;。&lt;br&gt;McKeeフォーマットに入れる前の、&lt;br&gt;キャラクターの中にある感覚。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="870" y="295" width="310" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p8_layer2" value="&lt;b style=&#39;font-size:14px&#39;&gt;Layer 2: 誤信念&lt;/b&gt;&lt;br&gt;（身体感覚が固まった信念）&lt;hr&gt;&lt;span style=&#39;font-size:14px;color:#2980B9&#39;&gt;&lt;b&gt;「言葉にすれば&lt;br&gt;　世界は安全になる」&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#888&#39;&gt;Lisa Cron（Story Genius）の&lt;br&gt;&lt;b&gt;misbelief&lt;/b&gt; に相当。&lt;br&gt;元の文脈では正しかった（父の説明は&lt;br&gt;実際に世界を安全にした）。&lt;br&gt;それを&lt;b&gt;一般化した&lt;/b&gt;ところに歪みが生まれる。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=11;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="870" y="500" width="310" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p8_layer3" value="&lt;b style=&#39;font-size:14px&#39;&gt;Layer 3: McKee用語&lt;/b&gt;&lt;br&gt;（作者が構造分析するときの言語）&lt;hr&gt;&lt;b&gt;意識的欲求:&lt;/b&gt; 状況ごとに変わる&lt;br&gt;（友達がほしい、B子を助けたい、等）&lt;br&gt;&lt;br&gt;&lt;b&gt;無意識的欲求:&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#2980B9&#39;&gt;「理解＝安全」を証明し続けたい&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;隠れた信念:&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#C0392B&#39;&gt;「言葉にすれば世界は安全になる」&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#888&#39;&gt;A「理解可能にしたい」もB「言葉で救いたい」も&lt;br&gt;Layer 3 の言葉。間違ってはいないが&lt;br&gt;Layer 1 の手触りがないから納得できなかった。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#666;fontSize=11;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="295" width="340" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="p8_la1" value="固まると" style="endArrow=classic;strokeColor=#666;strokeWidth=2;endSize=5;fontColor=#666;fontSize=10;" parent="1" source="p8_layer1" target="p8_layer2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_la2" value="分析すると" style="endArrow=classic;strokeColor=#666;strokeWidth=2;endSize=5;fontColor=#666;fontSize=10;" parent="1" source="p8_layer2" target="p8_layer3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_sec4" value="■ 信念の成長弧 — childhood から ACT5 への接続" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="700" width="800" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc_bg" value="" style="rounded=1;fillColor=#F8F9FA;strokeColor=#CCC;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="735" width="1510" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc1" value="&lt;b style=&#39;font-size:11px&#39;&gt;childhood&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;父が説明→安心&lt;br&gt;父が死ぬ→恐怖&lt;br&gt;自分で言葉にする&lt;br&gt;→安心が戻る&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;「わかれば大丈夫」&lt;/b&gt;&lt;br&gt;の誕生&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="745" width="155" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc2" value="&lt;b style=&#39;font-size:11px&#39;&gt;ACT1 小学生&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;論理で虐めをかわす&lt;br&gt;「説明できれば&lt;br&gt;怖くない」の確認&lt;br&gt;&lt;br&gt;&lt;b&gt;信念の強化&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#F39C12;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="260" y="745" width="155" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc3" value="&lt;b style=&#39;font-size:11px&#39;&gt;ACT2 中学&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;B子に説明→通じる&lt;br&gt;「やっぱり言葉が&lt;br&gt;あれば救える」&lt;br&gt;B子の死→&lt;br&gt;「言葉が足りなかった」&lt;br&gt;&lt;br&gt;&lt;b&gt;信念の確信化&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#F39C12;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="460" y="745" width="170" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc4" value="&lt;b style=&#39;font-size:11px&#39;&gt;ACT3 灘〜東大&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;精密な人々の中で&lt;br&gt;初めて居場所を得る&lt;br&gt;「厳密さ＝正義」&lt;br&gt;&lt;br&gt;&lt;b&gt;信念の理論化&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="680" y="745" width="155" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc5" value="&lt;b style=&#39;font-size:11px&#39;&gt;ACT4 Google&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Aを「教育」する&lt;br&gt;善意の加害&lt;br&gt;「正しく説明した&lt;br&gt;のになぜ壊れる？」&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;信念のひび割れ&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAF0;strokeColor=#7B4F9E;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="885" y="745" width="155" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8_arc6" value="&lt;b style=&#39;font-size:11px&#39;&gt;ACT5 クライマックス&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Aの自殺未遂&lt;br&gt;信念の崩壊&lt;br&gt;&lt;br&gt;「わからなくても&lt;br&gt;　寄り添える」&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#28A745&#39;&gt;信念の書き換え&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="745" width="155" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8_val_line" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=3;endSize=8;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="137" y="920" as="sourcePoint"/>
                        <mxPoint x="1167" y="920" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p8_val_labels" value="&lt;span style=&#39;color:#C0392B&#39;&gt;わかれば大丈夫&lt;/span&gt;　→　&lt;span style=&#39;color:#F39C12&#39;&gt;理解すれば救える&lt;/span&gt;　→　&lt;span style=&#39;color:#2980B9&#39;&gt;厳密さ＝正義&lt;/span&gt;　→　&lt;span style=&#39;color:#7B4F9E&#39;&gt;正しいのになぜ？&lt;/span&gt;　→　&lt;span style=&#39;color:#28A745&#39;&gt;わからなくても愛せる&lt;/span&gt;" style="text;html=1;fontSize=10;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="935" width="1200" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="p8_aa1" style="endArrow=classic;strokeColor=#888;strokeWidth=2;endSize=5;" parent="1" source="p8_arc1" target="p8_arc2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_aa2" style="endArrow=classic;strokeColor=#888;strokeWidth=2;endSize=5;" parent="1" source="p8_arc2" target="p8_arc3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_aa3" style="endArrow=classic;strokeColor=#888;strokeWidth=2;endSize=5;" parent="1" source="p8_arc3" target="p8_arc4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_aa4" style="endArrow=classic;strokeColor=#888;strokeWidth=2;endSize=5;" parent="1" source="p8_arc4" target="p8_arc5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_aa5" style="endArrow=classic;strokeColor=#888;strokeWidth=2;endSize=5;" parent="1" source="p8_arc5" target="p8_arc6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_sec5" value="■ 同じパターンを持つキャラクターたち — 「方法が牢獄になる」型" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="960" width="800" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p8_para1" value="&lt;b&gt;Will Hunting&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;虐待→「俺は誰もいらない」&lt;br&gt;知性で武装→壁が牢獄に&lt;br&gt;解除:「It&#39;s not your fault」&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#999;fontSize=10;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="995" width="175" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p8_para2" value="&lt;b&gt;碇シンジ&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;母の喪失→「必要とされたい」&lt;br&gt;EVAに乗る＝存在証明&lt;br&gt;方法（EVA）が心身を蝕む&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#999;fontSize=10;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="235" y="995" width="175" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p8_para3" value="&lt;b&gt;Christopher&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;（夜中に犬に起きた〜事件）&lt;br&gt;ASD→論理で世界を航行&lt;br&gt;論理で解けない問題に直面&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#999;fontSize=10;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="430" y="995" width="175" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p8_para4" value="&lt;b&gt;Charlie&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;（アルジャーノンに花束を）&lt;br&gt;知能＝救済と信じる&lt;br&gt;知能を得ても孤立は終わらず&lt;br&gt;知能を失っても愛は残る&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#999;fontSize=10;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="625" y="995" width="175" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p8_para5" value="&lt;b style=&#39;color:#4A7FB5&#39;&gt;Constrain 主人公&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;父の喪失→「言葉にすれば大丈夫」&lt;br&gt;言語的精密さで武装&lt;br&gt;精密さが善意の加害になる&lt;br&gt;解除: わからなくても愛せる&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;fontSize=10;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="820" y="995" width="190" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p8_pattern_summary" value="共通パターン: &lt;b&gt;喪失 → 生存メカニズムの発見 → 成功体験で強化 → 方法自体が牢獄になる → 方法を手放す&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#333;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1100" width="1100" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p8_bottom_box" value="" style="rounded=1;fillColor=#D6E4F0;strokeColor=#4A7FB5;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1135" width="1510" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p8_bottom_text" value="&lt;b style=&#39;font-size:13px&#39;&gt;結論:&lt;/b&gt;  McKeeの「欲求」をいきなり書こうとしなくていい。&lt;br&gt;まず Layer 1（身体感覚）を書く:&lt;b&gt;「父がいなくて怖い。言葉にすると怖くなくなる。だから言葉にする。」&lt;/b&gt;&lt;br&gt;これが欲求の種。ここから Layer 2（信念）、Layer 3（McKee用語）は自動的に育つ。" style="text;html=1;fontSize=11;fontColor=#333;align=left;spacingLeft=20;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1140" width="1490" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>