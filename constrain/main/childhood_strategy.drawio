                <mxCell id="p5_cl_pick" value="より不可逆的で&lt;br&gt;価値変化が大きいほうを選ぶ" style="text;html=1;fontSize=10;fontColor=#C0392B;fontStyle=3;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="690" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p5_flow_ab" value="" style="endArrow=classic;strokeColor=#333;strokeWidth=3;endSize=8;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="410" y="92" as="sourcePoint"/>
                        <mxPoint x="490" y="92" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p5_flow_bc" value="" style="endArrow=classic;strokeColor=#333;strokeWidth=3;endSize=8;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="350" y="390" as="sourcePoint"/>
                        <mxPoint x="210" y="420" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p5_flow_cd" value="" style="endArrow=classic;strokeColor=#333;strokeWidth=3;endSize=8;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="225" y="570" as="sourcePoint"/>
                        <mxPoint x="225" y="600" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Page 6: 条件 vs 欲求 — なぜ裏返しでは駄目なのか" id="cond-vs-desire">
        <mxGraphModel dx="916" dy="607" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p6_title" value="条件（Condition） vs 欲求（Desire） — 構造的に何が違うのか" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="50" y="15" width="1300" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p6_sub" value="出典: McKee &quot;Character&quot; — 条件は原因ではない。欲求がエンジンである。" style="text;html=1;fontSize=11;fontColor=#888;align=center;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="50" y="48" width="1300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p6_sec1" value="■ モデル（Page 4 の拡大）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="400" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p6_cond" value="&lt;b style=&#39;font-size:14px&#39;&gt;条件 (Condition)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;外的環境・変えられない前提&lt;br&gt;&lt;i style=&#39;font-size:10px&#39;&gt;家庭 / 文化 / 時代 / 身体 / 過去の出来事&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;地面&lt;/b&gt;（キャラが立っている場所）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="115" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p6_desire" value="&lt;b style=&#39;font-size:14px&#39;&gt;欲求 (Desire)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;内的衝動・キャラが選ぶ方向&lt;br&gt;&lt;i style=&#39;font-size:10px&#39;&gt;「〜したい」「〜でありたい」「〜を証明したい」&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#2980B9&#39;&gt;ベクトル&lt;/b&gt;（キャラが押す方向）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2980B9;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="380" y="115" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p6_arrow_constrain" value="&lt;b&gt;制約するが&lt;br&gt;決定しない&lt;/b&gt;" style="endArrow=classic;strokeColor=#F39C12;strokeWidth=3;endSize=6;fontColor=#F39C12;fontSize=10;dashed=1;" parent="1" source="p6_cond" target="p6_desire" edge="1">
                    <mxGeometry x="1" y="50" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p6_choice" value="&lt;b&gt;選択&lt;/b&gt;&lt;br&gt;(Choice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#28A745;fontSize=12;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="720" y="145" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6_arrow_drive" value="&lt;b&gt;駆動する&lt;/b&gt;" style="endArrow=classic;strokeColor=#2980B9;strokeWidth=3;endSize=6;fontColor=#2980B9;fontSize=10;" parent="1" source="p6_desire" target="p6_choice" edge="1">
                    <mxGeometry x="0.0321" y="33" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p6_action" value="&lt;b&gt;行動&lt;/b&gt;&lt;br&gt;(Action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=12;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="880" y="145" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6_arrow_act" style="endArrow=classic;strokeColor=#666;strokeWidth=2;endSize=5;" parent="1" source="p6_choice" target="p6_action" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_scene" value="&lt;b&gt;次のシーン&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=12;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="145" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6_arrow_scene" style="endArrow=classic;strokeColor=#666;strokeWidth=2;endSize=5;" parent="1" source="p6_action" target="p6_scene" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_chain_label" value="条件 → 欲求 → 選択 → 行動 → 次のシーン … この鎖が物語を前に進める" style="text;html=1;fontSize=11;fontColor=#333;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="260" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p6_sec2" value="■ 条件の裏返しだとなぜ駄目か — 3つの理由" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="300" width="600" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r1_box" value="" style="rounded=1;fillColor=#FFF3F3;strokeColor=#C0392B;strokeWidth=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="340" width="420" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r1_title" value="&lt;b&gt;理由1: 方向がない（ベクトルにならない）&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#C0392B;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="345" width="400" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r1_ng" value="孤立している&lt;br&gt;↓ 裏返し&lt;br&gt;「つながりたい」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="55" y="375" width="130" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r1_ng_q" value="→ で、&lt;b&gt;どうやって？&lt;/b&gt;&lt;br&gt;→ 迎合？攻撃？理解？逃げる？&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;方向が決まらない&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="195" y="375" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r1_ok" value="「世界を理解可能に&lt;br&gt;したい」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="55" y="460" width="130" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r1_ok_q" value="→ 相手の立場を言語化して説明する&lt;br&gt;→ 父のメソッドを再現しようとする&lt;br&gt;&lt;b style=&#39;color:#28A745&#39;&gt;次の行動が見える&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="195" y="455" width="255" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_box" value="" style="rounded=1;fillColor=#FFF3F3;strokeColor=#C0392B;strokeWidth=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="490" y="340" width="420" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_title" value="&lt;b&gt;理由2: 性格が立たない（誰でも同じになる）&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#C0392B;align=left;" parent="1" vertex="1">
                    <mxGeometry x="500" y="345" width="400" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_ng" value="&lt;b&gt;条件:&lt;/b&gt; 父が死んで孤立&lt;br&gt;&lt;b&gt;裏返し:&lt;/b&gt; 「つながりたい」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="375" width="180" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_ng_note" value="→ この欲求は&lt;b&gt;誰でも持つ&lt;/b&gt;&lt;br&gt;→ キャラAもBもCも同じ&lt;br&gt;→ &lt;b style=&#39;color:#C0392B&#39;&gt;交換可能な主人公&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="695" y="370" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_ok_a" value="キャラA: 「理解で救いたい」→言語化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="435" width="190" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_ok_b" value="キャラB: 「傷つきたくない」→壁を作る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="472" width="190" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_ok_c" value="キャラC: 「復讐したい」→攻撃する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=9;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="453" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r2_ok_note" value="同じ条件 × 異なる欲求 = &lt;b style=&#39;color:#28A745&#39;&gt;異なるキャラクター&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666;align=center;" parent="1" vertex="1">
                    <mxGeometry x="500" y="505" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_box" value="" style="rounded=1;fillColor=#FFF3F3;strokeColor=#C0392B;strokeWidth=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="940" y="340" width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_title" value="&lt;b&gt;理由3: 試せない（クライマックスが導出不能）&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#C0392B;align=left;" parent="1" vertex="1">
                    <mxGeometry x="950" y="345" width="380" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_ng" value="「つながりたい」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=11;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="960" y="380" width="140" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_ng_test" value="最大限に試す瞬間 = ？&lt;br&gt;「つながれない」？→ 漠然&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;シーンが浮かばない&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1115" y="375" width="210" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_ok" value="「理解で人を救いたい」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=1;" parent="1" vertex="1">
                    <mxGeometry x="960" y="440" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_ok_test" value="最大限に試す瞬間 =&lt;br&gt;「理解したのに救えなかった」&lt;br&gt;or「理解が相手を傷つけた」&lt;br&gt;&lt;b style=&#39;color:#28A745&#39;&gt;具体的なシーンが見える&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#666;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1135" y="430" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_r3_formula" value="&lt;b&gt;公式:&lt;/b&gt; クライマックス = 欲求が最大限に試される瞬間&lt;br&gt;欲求が漠然 → クライマックスも漠然 → 物語が締まらない" style="text;html=1;fontSize=10;fontColor=#C0392B;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="950" y="495" width="380" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_sec3" value="■ 理想的な欲求の形 — 4つの条件" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="550" width="600" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ideal1" value="&lt;b style=&#39;font-size:12px&#39;&gt;① 方法を含む&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;「〜したい」の中に&lt;br&gt;&lt;b&gt;HOW&lt;/b&gt;が入っている&lt;br&gt;&lt;br&gt;✗ つながりたい&lt;br&gt;○ &lt;b&gt;理解することで&lt;/b&gt;つながりたい&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="590" width="220" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ideal2" value="&lt;b style=&#39;font-size:12px&#39;&gt;② キャラ固有&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;同じ条件の別キャラが&lt;br&gt;同じ欲求を持たない&lt;br&gt;&lt;br&gt;✗ 誰でも持つ欲求&lt;br&gt;○ &lt;b&gt;この子だけ&lt;/b&gt;の志向&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="290" y="590" width="220" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ideal3" value="&lt;b style=&#39;font-size:12px&#39;&gt;③ 反証可能&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;「それが間違いだった」&lt;br&gt;と判明する瞬間を&lt;br&gt;想像できる&lt;br&gt;&lt;br&gt;= クライマックスの種&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="540" y="590" width="220" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ideal4" value="&lt;b style=&#39;font-size:12px&#39;&gt;④ 次のシーンが書ける&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;この欲求を持つキャラが&lt;br&gt;次に何をするか&lt;br&gt;予測できる&lt;br&gt;&lt;br&gt;= 物語のエンジン&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="790" y="590" width="220" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p6_metaphor" value="&lt;b style=&#39;font-size:13px&#39;&gt;比喩で言うと&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;条件&lt;/b&gt; = 地面（立っている場所）&lt;br&gt;&lt;b&gt;欲求&lt;/b&gt; = ベクトル（押す方向）&lt;br&gt;&lt;br&gt;条件の裏返し = 「ここにいたくない」（地面を否定しただけ）&lt;br&gt;独立した欲求 = 「あっちに行きたい」（方向が決まる）&lt;br&gt;&lt;br&gt;&lt;b&gt;地面を否定しても方向は生まれない。&lt;br&gt;方向が決まって初めて物語が動く。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9EBEA;strokeColor=#C0392B;fontSize=11;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="780" width="500" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6_apply" value="&lt;b style=&#39;font-size:13px&#39;&gt;childhood への適用&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;条件:&lt;/b&gt; 父の死 → 孤立（地面）&lt;br&gt;&lt;b&gt;裏返し:&lt;/b&gt; 「つながりたい」（地面の否定 → 方向なし）&lt;br&gt;&lt;br&gt;&lt;b&gt;独立した欲求の候補:&lt;/b&gt;&lt;br&gt;A「世界を理解可能にしたい」→ &lt;b&gt;理解&lt;/b&gt;という方向&lt;br&gt;B「父のように言葉で人を救いたい」→ &lt;b&gt;救済&lt;/b&gt;という方向&lt;br&gt;&lt;br&gt;どちらも4条件を満たす:&lt;br&gt;① 方法を含む（言語化/理解）&lt;br&gt;② この子固有（父の教育が背景）&lt;br&gt;③ 反証可能（理解しても救えない/傷つける）&lt;br&gt;④ 次のシーンが書ける（B子を理解しようとする）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="780" width="450" height="200" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Page 7: childhood 現在の設計状況マップ" id="status-map">
        <mxGraphModel dx="1081" dy="464" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1050" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p7_title" value="childhood 設計状況マップ（Page 4 の各ボックス × 充足度）" style="text;html=1;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="50" y="15" width="1300" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p7_legend" value="🟢 確定済み　　🟡 素材あり・要修正　　🔴 未定義" style="text;html=1;fontSize=12;fontColor=#666;align=center;" parent="1" vertex="1">
                    <mxGeometry x="50" y="50" width="1300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p7_spine_line" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=4;endSize=8;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="160" as="sourcePoint"/>
                        <mxPoint x="1200" y="160" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p7_spine_label" value="Spine（背骨）" style="text;html=1;fontSize=12;fontStyle=5;fontColor=#C0392B;align=center;" parent="1" vertex="1">
                    <mxGeometry x="600" y="135" width="200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p7_ii" value="&lt;b style=&#39;font-size:13px&#39;&gt;🟢 契機事件&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;✅ 出来事: 父の死&lt;br&gt;✅ 均衡破壊: 成立&lt;br&gt;✅ 伏線: 病気進行の示唆&lt;br&gt;⚠️ 欲望生成: 条件の裏返し&lt;br&gt;⚠️ 直後のアクション: 未定義&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=3;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="90" width="220" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p7_climax" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔴 クライマックス&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 未定義&lt;br&gt;❌ 3案あるが要件未達&lt;br&gt;&lt;br&gt;原因: 欲求が未確定のため&lt;br&gt;自動導出できない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=3;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="90" width="220" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p7_balance" value="&lt;b&gt;🟢 均衡&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;✅ 父がいるから&lt;br&gt;翌日学校に行ける&lt;br&gt;（脆い均衡として成立）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="260" width="150" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e_bal" style="endArrow=classic;strokeColor=#28A745;strokeWidth=1;endSize=4;" parent="1" source="p7_balance" target="p7_ii" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_foreshadow" value="&lt;b&gt;🟢 伏線&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;✅ 父の病気進行&lt;br&gt;「面会も最後かな」&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="230" y="260" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e_fore" style="endArrow=classic;strokeColor=#28A745;strokeWidth=1;endSize=4;" parent="1" source="p7_foreshadow" target="p7_ii" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_protag_box" value="" style="rounded=1;fillColor=#F8F9FA;strokeColor=#2980B9;fontSize=12;strokeWidth=2;dashed=0;" parent="1" vertex="1">
                    <mxGeometry x="410" y="250" width="520" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="p7_protag_title" value="主人公モデル" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#2980B9;align=center;" parent="1" vertex="1">
                    <mxGeometry x="410" y="255" width="520" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p7_desire" value="&lt;b style=&#39;font-size:12px&#39;&gt;🔴 欲求 (Desire)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 「つながりたい」は条件の裏返し&lt;br&gt;&lt;br&gt;&lt;b&gt;候補A:&lt;/b&gt; 世界を理解可能にしたい&lt;br&gt;&lt;b&gt;候補B:&lt;/b&gt; 父のように言葉で人を救いたい&lt;br&gt;&lt;br&gt;→ &lt;b style=&#39;color:#C0392B&#39;&gt;ユーザーが選択する&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=3;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="425" y="285" width="230" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="p7_will" value="&lt;b&gt;🔴 意志 (Will)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 未定義&lt;br&gt;困難に直面して&lt;br&gt;どう行動するか&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="680" y="285" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7_disposition" value="&lt;b&gt;🟡 性向&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;⚠️ 断片的に存在&lt;br&gt;「認知が歪んでいる」&lt;br&gt;「父に依存的」&lt;br&gt;→ 一文にまとめる必要&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#F39C12;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="820" y="285" width="140" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="p7_condition" value="&lt;b&gt;🟢 条件&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;✅ 父の死で孤立&lt;br&gt;✅ ASD傾向&lt;br&gt;✅ いじめ環境&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="425" y="450" width="140" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e_cond" value="制約" style="endArrow=classic;strokeColor=#F39C12;strokeWidth=2;endSize=5;dashed=1;fontColor=#F39C12;fontSize=9;" parent="1" source="p7_condition" target="p7_desire" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_choice" value="&lt;b&gt;🔴 選択&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 未定義&lt;br&gt;欲求確定後に導出&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="600" y="460" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p7_layers" value="&lt;b&gt;🔴 4層構造&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 未設計&lt;br&gt;社会的/個人的/&lt;br&gt;中核/隠れた自己&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=10;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="770" y="420" width="130" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e_ii_desire" value="欲望生成" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=2;endSize=5;dashed=1;fontColor=#C0392B;fontSize=9;" parent="1" source="p7_ii" target="p7_desire" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_cc" value="&lt;b&gt;🟢 統制概念&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;✅ Constrain本編から継承&lt;br&gt;「精密さで守ろうとした人間が&lt;br&gt;完全な理解なしに愛せるように」&lt;br&gt;&lt;br&gt;⚠️ 短編固有の統制概念は&lt;br&gt;未定義（必要か要検討）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="270" width="210" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e_cc" style="endArrow=classic;strokeColor=#28A745;strokeWidth=1;endSize=4;" parent="1" source="p7_cc" target="p7_climax" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_opp" value="&lt;b&gt;🟡 対立概念&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;⚠️ 暗黙的に存在&lt;br&gt;「精密な理解こそ&lt;br&gt;唯一の救済」&lt;br&gt;→ 明文化するとよい&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#F39C12;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="450" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p7_value_title" value="🟡 価値軸" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#F39C12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="630" width="1000" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p7_val_line" style="endArrow=classic;startArrow=classic;strokeColor=#F39C12;strokeWidth=3;endSize=8;startSize=8;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="675" as="sourcePoint"/>
                        <mxPoint x="1200" y="675" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p7_val_neg" value="孤立 / 無理解" style="text;html=1;fontSize=11;fontColor=#C0392B;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="200" y="680" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p7_val_pos" value="つながり / 理解" style="text;html=1;fontSize=11;fontColor=#28A745;fontStyle=1;align=right;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="680" width="150" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p7_val_note" value="⚠️ 本編から推測可能だが、短編としての価値軸を明文化していない" style="text;html=1;fontSize=10;fontColor=#F39C12;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="400" y="680" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p7_causal" value="&lt;b&gt;🔴 因果鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 契機事件後の event → inner_exposure → choice → action → consequence が未設計&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="400" y="175" width="520" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p7_scale" value="&lt;b&gt;🔴 スケール&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;❌ 超短編 / 短編 / 中編のどれか未決定。クライマックスの置き場に直結する。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="630" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7_summary_box" value="" style="rounded=1;fillColor=#F8F9FA;strokeColor=#666;strokeWidth=1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="760" width="1280" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="p7_summary_title" value="■ 残タスク一覧（依存順）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="770" width="400" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t1" value="&lt;b&gt;❶ 欲求を確定&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;候補A or B を選ぶ&lt;br&gt;4条件でテスト&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#28A745;fontColor=#FFF;strokeColor=#922B21;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="810" width="140" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t2" value="&lt;b&gt;❷ クライマックス&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;信念の反証パターンから&lt;br&gt;自動導出&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#28A745;fontColor=#FFF;strokeColor=#922B21;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="260" y="810" width="150" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t3" value="&lt;b&gt;❸ スケール決定&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;超短編/短編/中編&lt;br&gt;クライマックス次第&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#28A745;fontColor=#FFF;strokeColor=#922B21;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="470" y="810" width="140" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t4" value="&lt;b&gt;❹ 主人公モデル補完&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;意志/性向を一文化&lt;br&gt;選択パターン定義&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#FFF;strokeColor=#E67E22;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="670" y="810" width="150" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t5" value="&lt;b&gt;❺ 因果鎖設計&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;契機事件→クライマックス&lt;br&gt;の最低3ノード&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F39C12;fontColor=#FFF;strokeColor=#E67E22;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="880" y="810" width="150" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t6" value="&lt;b&gt;❻ Sequence設計&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;因果鎖をSequenceに&lt;br&gt;グルーピング&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2980B9;fontColor=#FFF;strokeColor=#1A5276;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="810" width="150" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p7_tf1" style="endArrow=classic;strokeColor=#FFF;strokeWidth=3;endSize=6;" parent="1" source="p7_t1" target="p7_t2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_tf2" style="endArrow=classic;strokeColor=#FFF;strokeWidth=3;endSize=6;" parent="1" source="p7_t2" target="p7_t3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_tf3" style="endArrow=classic;strokeColor=#FFF;strokeWidth=3;endSize=6;" parent="1" source="p7_t3" target="p7_t4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_tf4" style="endArrow=classic;strokeColor=#FFF;strokeWidth=3;endSize=6;" parent="1" source="p7_t4" target="p7_t5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_tf5" style="endArrow=classic;strokeColor=#FFF;strokeWidth=3;endSize=6;" parent="1" source="p7_t5" target="p7_t6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_t_legend" value="🔴 = ブロッカー（これが決まらないと先に進めない）　　🟠 = 補完（並行可能）　　🔵 = 最終段階" style="text;html=1;fontSize=10;fontColor=#666;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="890" width="1200" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p7_you_are_here" value="⬇ 次回はここから" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#C0392B;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="920" width="180" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p7_you_arrow" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=3;endSize=8;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="130" y="945" as="sourcePoint"/>
                        <mxPoint x="130" y="880" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p7_note1" value="❶が決まれば❷は自動導出。❶❷❸がSpineの完成。❹❺は並行可能。❻でAct→Sequenceに降りる。" style="text;html=1;fontSize=11;fontColor=#333;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="960" width="1200" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p7_note2" value="Spine完成（❶❷❸）= rev.3。主人公モデル補完（❹）= rev.3.5。因果鎖＋Sequence（❺❻）= rev.4 → 執筆開始。" style="text;html=1;fontSize=11;fontColor=#333;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="985" width="1200" height="25" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Page 8: 欲求の正体 — 生存メカニズムとしての言語化" id="desire-origin">
        <mxGraphModel dx="1564" dy="580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p8_title" value="欲求の正体 — 「知的分析」ではなく「生存メカニズム」" style="text;html=1;fontSize=22;fontStyle=1;align=center;fontColor=#333;" parent="1" vertex="1">
                    <mxGeometry x="50" y="10" width="1500" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p8_subtitle" value="なぜ A も B も納得いかないか — そして本当のエンジンはどこにあるか" style="text;html=1;fontSize=13;fontColor=#888;align=center;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="50" y="45" width="1500" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p8_sec1" value="■ A も B も「外から貼ったラベル」" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="600" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p8_a_box" value="&lt;b&gt;候補A&lt;/b&gt;&lt;br&gt;「世界を理解可能にしたい」&lt;br&gt;&lt;br&gt;&lt;span style=&#39;color:#C0392B;font-size:10px&#39;&gt;→ 認識論の言葉&lt;br&gt;→ 子どもはこう思わない&lt;br&gt;→ 文芸評論家の言語&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#F39C12;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="115" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p8_b_box" value="&lt;b&gt;候補B&lt;/b&gt;&lt;br&gt;「父のように言葉で人を救いたい」&lt;br&gt;&lt;br&gt;&lt;span style=&#39;color:#C0392B;font-size:10px&#39;&gt;→ 利他的すぎる&lt;br&gt;→ 父を失った直後の子は&lt;br&gt;　 他者を救う余裕はない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#F39C12;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="260" y="115" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p8_problem" value="&lt;b style=&#39;color:#C0392B;font-size:13px&#39;&gt;共通の問題:&lt;/b&gt;&lt;br&gt;&lt;br&gt;どちらも&lt;b&gt;大人が振り返って言語化した&lt;/b&gt;もの。&lt;br&gt;子どもの内側から出てくる感覚ではない。&lt;br&gt;&lt;br&gt;McKeeフォーマットに当てはめようとして&lt;br&gt;&lt;b&gt;感情を殺してしまった&lt;/b&gt;。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=11;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="490" y="115" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p8_sec2" value="■ 子どもの内側で何が起きているか — 愛着理論（Bowlby）× 誤信念形成" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="260" width="800" height="25" as="geometry"/>
                </mxCell>
