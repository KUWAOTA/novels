                <mxCell id="p4_val_neg" value="&lt;b&gt;−&lt;/b&gt; 価値のマイナス極&lt;br&gt;&lt;i style=&#39;font-size:10px&#39;&gt;例: 孤立・誤解・暴力&lt;/i&gt;" style="text;html=1;fontSize=12;align=left;fontColor=#C0392B;" parent="1" vertex="1">
