                </mxCell>
                <mxCell id="p4_val_desc" value="各シーンで + か − に動く。横ばいは無効。全体で振幅が増大する。" style="text;html=1;fontSize=11;fontColor=#666;align=center;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="400" y="700" width="600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p4_causal" value="&lt;b&gt;因果鎖 (Causal Chain)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;event → inner_exposure → choice → action → consequence&lt;br&gt;（出来事 → 内面露出 → 選択 → 行為 → 結果）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
