                        <mxPoint x="200" y="170" as="sourcePoint"/>
                        <mxPoint x="1200" y="170" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4_ii" value="&lt;b style=&#39;font-size:14px&#39;&gt;契機事件&lt;/b&gt;&lt;br&gt;Inciting Incident&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;① 均衡を破壊する&lt;br&gt;② 欲望を生じさせる&lt;br&gt;③ 25%以内に配置&lt;br&gt;④ 伏線→回収を持つ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=12;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="80" y="110" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_climax" value="&lt;b style=&#39;font-size:14px&#39;&gt;クライマックス&lt;/b&gt;&lt;br&gt;Climax&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;① 不可逆の価値変化&lt;br&gt;② 統制概念が体現される&lt;br&gt;③ 因果鎖が完結する&lt;br&gt;④ 期待と結果の最大ギャップ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5C6CB;strokeColor=#C0392B;fontSize=12;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="110" width="210" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_balance" value="&lt;b&gt;均衡&lt;/b&gt;&lt;br&gt;Balance&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;主人公が&lt;br&gt;&quot;やっていける&quot;&lt;br&gt;主観的安定状態&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="80" y="280" width="120" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e_bal_ii" value="破壊される" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=1;endSize=5;fontColor=#C0392B;fontSize=9;" parent="1" source="p4_balance" target="p4_ii" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_foreshadow" value="&lt;b&gt;伏線&lt;/b&gt;&lt;br&gt;Foreshadowing&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;契機事件の&lt;br&gt;事前仕込み&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="220" y="280" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e_fore_ii" value="回収" style="endArrow=classic;strokeColor=#C0392B;strokeWidth=1;endSize=5;fontColor=#C0392B;fontSize=9;" parent="1" source="p4_foreshadow" target="p4_ii" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_protag_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=12;strokeWidth=2;dashed=0;" parent="1" vertex="1">
                    <mxGeometry x="370" y="270" width="540" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="p4_protag_title" value="主人公モデル（Protagonist Model）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#2980B9;align=center;" parent="1" vertex="1">
                    <mxGeometry x="370" y="275" width="540" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="p4_desire" value="&lt;b style=&#39;font-size:13px&#39;&gt;欲求 (Desire)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;意識的: 主人公が追い求めるもの&lt;br&gt;無意識的: 本人が気づいていない本当の欲求&lt;br&gt;&lt;b&gt;← 物語のエンジン&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2980B9;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="390" y="310" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_will" value="&lt;b&gt;意志 (Will)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;困難に直面して&lt;br&gt;行動を起こす力&lt;br&gt;弱い = 受動的主人公&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2980B9;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="660" y="310" width="130" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_disposition" value="&lt;b&gt;性向 (Disposition)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;世界との関わり方&lt;br&gt;例: 注意深いが臆病&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2980B9;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="810" y="310" width="130" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cond" value="&lt;b&gt;★ 条件 (Condition)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;家庭・文化・時代・圧力&lt;br&gt;= 外的環境&lt;br&gt;&lt;b style=&#39;color:#C0392B&#39;&gt;行動を決定しない&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="390" y="430" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cond_arrow" value="制約するが&lt;br&gt;決定しない" style="endArrow=classic;strokeColor=#F39C12;strokeWidth=2;endSize=5;dashed=1;fontColor=#F39C12;fontSize=9;" parent="1" source="p4_cond" target="p4_desire" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_choice" value="&lt;b&gt;★ 選択 (Choice)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;同じ条件でも選択が異なる&lt;br&gt;→ そこに性格が現れる&lt;br&gt;&lt;b style=&#39;color:#2980B9&#39;&gt;欲求が選択を駆動する&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="600" y="430" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4_desire_choice" value="駆動する" style="endArrow=classic;strokeColor=#2980B9;strokeWidth=2;endSize=5;fontColor=#2980B9;fontSize=9;" parent="1" source="p4_desire" target="p4_choice" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_layers" value="&lt;b&gt;★ 自己の4層構造&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:9px&#39;&gt;① 社会的自己（最外層）&lt;br&gt;② 個人的自己&lt;br&gt;③ 中核の自己&lt;br&gt;④ 隠れた自己（最深層）&lt;br&gt;&lt;br&gt;圧力で外から剥がれ&lt;br&gt;最深層が露出する&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#7D3C98;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="810" y="420" width="140" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e_ii_desire" value="欲望を生じさせる" style="endArrow=classic;strokeColor=#2980B9;strokeWidth=2;endSize=6;fontColor=#2980B9;fontSize=10;" parent="1" source="p4_ii" target="p4_desire" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cc" value="&lt;b style=&#39;font-size:13px&#39;&gt;統制概念&lt;/b&gt;&lt;br&gt;Controlling Idea&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;物語が最終的に&lt;br&gt;「証明」する命題&lt;br&gt;&lt;br&gt;クライマックスで&lt;br&gt;&lt;b&gt;体現&lt;/b&gt;される&lt;br&gt;（言語化ではなく体験）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=11;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="280" width="170" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e_cc_climax" value="体現される" style="endArrow=classic;strokeColor=#28A745;strokeWidth=2;endSize=5;fontColor=#28A745;fontSize=9;" parent="1" source="p4_cc" target="p4_climax" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_opp" value="&lt;b&gt;対立概念&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;span style=&#39;font-size:10px&#39;&gt;統制概念に対立する命題&lt;br&gt;交互に優勢になることで&lt;br&gt;教条主義を回避&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;strokeWidth=1;verticalAlign=top;" parent="1" vertex="1">
