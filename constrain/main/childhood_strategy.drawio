                <mxCell id="p4_val_pos" value="&lt;b&gt;+&lt;/b&gt; 価値のプラス極&lt;br&gt;&lt;i style=&#39;font-size:10px&#39;&gt;例: つながり・理解・愛&lt;/i&gt;" style="text;html=1;fontSize=12;align=right;fontColor=#28A745;" parent="1" vertex="1">
