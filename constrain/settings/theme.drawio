<mxfile host="65bd71144e">
    <diagram id="wjclCQA-mw7N3x6G5hsB" name="Page-1">
        <mxGraphModel dx="1227" dy="491" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="3200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="① テーマ文 — v3（エピソードメモ統合・情報密度強化版）" style="text;html=1;align=center;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="theme_box" value="テーマ文（統制概念）" style="swimlane;startSize=24;fillColor=#dae8fc;strokeColor=#4A7FB5;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="70" width="1100" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="theme_text" value="「厳密に定義された言葉」こそが人を救うと考えた主人公が、&#xa;曖昧さとディスコミュニケーションだらけの人間社会を、愛せるようになる話" style="rounded=1;fillColor=#ffffff;strokeColor=#4A7FB5;fontSize=14;fontStyle=1;align=center;" parent="theme_box" vertex="1">
                    <mxGeometry x="15" y="32" width="1070" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="1" source="theme_box" target="explain_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="explain_box" value="テーマの3要素 — 分解" style="swimlane;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="230" width="1100" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="ex1" value="「厳密さ」とは" style="swimlane;startSize=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="explain_box" vertex="1">
                    <mxGeometry x="10" y="35" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="ex1a" value="言語を正確に・再現可能に定義することで人を理解し救えると信じること。&#xa;&#xa;「決まりだから」「空気を読め」では納得できない。&#xa;「なぜそうなるか」まで言葉で明快に説明できれば&#xa;誰でも理解できる――という信仰。&#xa;&#xa;起源：父の教え（仮説を立て検証する方法）&#xa;強化：灘・東大で「論理が通じる集団」を体験&#xa;誤用：B子の死を「言語の欠如」のせいと解釈&#xa;暴走：A男への「善意の厳密な指導」" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="ex1" vertex="1">
                    <mxGeometry x="5" y="25" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="ex2" value="「曖昧さとディスコミュニケーション」とは" style="swimlane;startSize=22;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="explain_box" vertex="1">
                    <mxGeometry x="365" y="35" width="370" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="ex2a" value="言葉の解釈は話者の間で必ずズレる。&#xa;それを補うのが感情・空気読みだが、読めない人は置いてけぼり。&#xa;この「ズレ」こそが争いや迫害を生むと主人公は思っている。&#xa;&#xa;しかし物語が示す真実：&#xa;・B子と主人公は「通じ合っている」と思っていたが根本的にズレていた&#xa;　（主人公：論理が通じる / B子：性的に搾取しない＝安全）&#xa;・A男と主人公も完全にズレている&#xa;　（主人公：教育 / A男：仕返し・虐待の再演）&#xa;・曖昧さは危険だが、曖昧さの中にしかない救済もある" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="ex2" vertex="1">
                    <mxGeometry x="5" y="25" width="360" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="ex3" value="「愛せるようになる」とは" style="swimlane;startSize=22;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="explain_box" vertex="1">
                    <mxGeometry x="750" y="35" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="ex3a" value="理解できなくても、それでも関わり続けることを選ぶこと。&#xa;&#xa;「正しく説明できれば救える」から&#xa;「説明できなくても受け入れる・そこにいる」へ。&#xa;&#xa;厳密さを「捨てる」のではない。&#xa;「理解の外にある他者を、それでも受け入れる」という選択。&#xa;" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="ex3" vertex="1">
                    <mxGeometry x="5" y="25" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="arr1b" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="1" source="explain_box" target="rescue_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="rescue_box" value="「救う」とは何か — 主人公の定義と変化（テーマの核心）" style="swimlane;startSize=26;fillColor=#f8cecc;strokeColor=#C0392B;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="510" width="1100" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="resc1" value="主人公にとっての「救う」（誤信念）" style="swimlane;startSize=22;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;" parent="rescue_box" vertex="1">
                    <mxGeometry x="10" y="38" width="340" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="resc1a" value="「救う」＝「正しく・厳密に理解させること」&#xa;&#xa;「相手が正確に理解できれば、生きられる。&#xa;言葉が届かないのは言語が不正確だから。&#xa;だから厳密な言語が人を救う」&#xa;&#xa;根拠：B子を「救えなかった」のは空気読み社会が&#xa;彼女に正確な言語を与えなかったから、という誤解。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="resc1" vertex="1">
                    <mxGeometry x="5" y="26" width="330" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="resc2" value="B子の死の真実（読者だけが知る）" style="swimlane;startSize=22;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" parent="rescue_box" vertex="1">
                    <mxGeometry x="365" y="38" width="370" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="resc2a" value="B子の死は「苦しみの果て」ではない。&#xa;&#xa;主人公とのデートで初めて「本当の優しさ」を知った。&#xa;帰宅後、おじさんの虐待が再開した時に初めて&#xa;「これは優しさじゃない」と認識してしまった。&#xa;しかし知的障害のため助けを求める言葉を持たない。&#xa;逃げ方もわからない。できることは一つだけ。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="resc2" vertex="1">
                    <mxGeometry x="5" y="26" width="360" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="resc3" value="ACT5での「救う」の再定義" style="swimlane;startSize=22;fillColor=#d5e8d4;strokeColor=#28A745;fontStyle=1;fontSize=11;" parent="rescue_box" vertex="1">
                    <mxGeometry x="750" y="38" width="340" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="resc3a" value="旧：「救う」＝理解させること（完全に正確に説明し、わからせる）&#xa;新：「救う」＝理解できなくても共にいること&#xa;&#xa;第三の選択：&#xa;厳密さを捨てるのでも、諦めるのでもない。&#xa;理解できなくても関わり続けるという選択。&#xa;&#xa;【穴】この再定義が具体的にどんな行動で体現されるか未設計&#xa;【穴】ACT5で主人公が発する言葉（もしあれば）は未定" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="resc3" vertex="1">
                    <mxGeometry x="5" y="26" width="330" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="1" source="rescue_box" target="gray_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="gray_box" value="テーマの弁証法 — 「白黒」から「灰色」へ" style="swimlane;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="850" width="1100" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="gray1" value="主人公の出発点：白黒思考" style="swimlane;startSize=22;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;" parent="gray_box" vertex="1">
                    <mxGeometry x="10" y="35" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="gray1a" value="白黒はっきりさせる → どっちかが黒になる → それは攻撃。&#xa;意見の衝突は対立になりうる。&#xa;主人公は「正しいか間違いか」でしか世界を切れない。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="gray1" vertex="1">
                    <mxGeometry x="5" y="25" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="gray2" value="到達点①：灰色の発見" style="swimlane;startSize=22;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="gray_box" vertex="1">
                    <mxGeometry x="365" y="35" width="370" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="gray2a" value="灰色＝どっちも傷つけない、どっちつかずの結論で平和的解決を導ける。&#xa;曖昧さの方が平和的になりうる。&#xa;&#xa;ただし主人公は「濁すことを知る」のではなく、&#xa;「そういう方法もあると理解する」。← 主人公の言葉としてはこれが近い。&#xa;白黒の世界に灰色を「追加」する感覚。厳密さを捨てるのではない。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="gray2" vertex="1">
                    <mxGeometry x="5" y="25" width="360" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="gray3" value="到達点②：わからないまま動く" style="swimlane;startSize=22;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="gray_box" vertex="1">
                    <mxGeometry x="750" y="35" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="gray3a" value="「わからないけど、とりあえずそうする」&#xa;← 主人公にはこれが最も抵抗感がある行動。&#xa;論理的根拠なしに行動すること。理解の外にある他者に、&#xa;説明できないままそれでも手を伸ばすこと。" style="text;strokeColor=none;fillColor=none;fontSize=9;align=left;spacingLeft=6;" parent="gray3" vertex="1">
                    <mxGeometry x="5" y="25" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="arr3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="1" source="gray_box" target="pattern_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pattern_box" value="テーマの構造的パターン — 「善意が人を殺す」三重構造" style="swimlane;startSize=26;fillColor=#f8cecc;strokeColor=#C0392B;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1130" width="1100" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="pat1" value="① ACT2：主人公のデート → B子の死&#xa;&#xa;主人公はB子に性欲のない好意を向けた。&#xa;B子はそれを「本物の愛情」と感じた。&#xa;初めて知った本当の優しさが、&#xa;帰宅後の性的虐待を「異常」と認識させた。" style="rounded=1;fillColor=#E8DAEF;strokeColor=#7B4F9E;fontSize=9;align=left;spacingLeft=8;spacingTop=6;" parent="pattern_box" vertex="1">
                    <mxGeometry x="10" y="35" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pat2" value="② ACT4：主人公の教育 → A男の崩壊&#xa;&#xa;主人公は父の教え②③（翻訳・提案）で指導。&#xa;しかし①（感情の受容）を省略。&#xa;客観的には正しい。ハラスメントに見えない。&#xa;しかしA男の傷を通じて父の暴力がリプレイされる。" style="rounded=1;fillColor=#FDEBD0;strokeColor=#E67E22;fontSize=9;align=left;spacingLeft=8;spacingTop=6;" parent="pattern_box" vertex="1">
                    <mxGeometry x="365" y="35" width="370" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pat3" value="③ ACT1：A男の母の「愛」→ A男の破壊&#xa;&#xa;母は「あなたのために」勉強を強要する。&#xa;主観的には善意＝息子の将来を思っている。&#xa;しかしその善意が教育虐待になっている。" style="rounded=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=9;align=left;spacingLeft=8;spacingTop=6;" parent="pattern_box" vertex="1">
                    <mxGeometry x="750" y="35" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="arr4" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="1" source="pattern_box" target="arc_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arc_box" value="価値変化弧（確定）— 主人公の内的変化" style="swimlane;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1390" width="1100" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="arc1" value="理解すれば救える&#xa;（ACT1-3）" style="rounded=1;fillColor=#f8cecc;strokeColor=#C0392B;fontSize=11;" parent="arc_box" vertex="1">
                    <mxGeometry x="30" y="35" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="arc2" value="理解しても救えない&#xa;（ACT4：A男崩壊）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="arc_box" vertex="1">
                    <mxGeometry x="410" y="35" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="arc3" value="理解できなくても寄り添える&#xa;（ACT5：第三の選択）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="arc_box" vertex="1">
                    <mxGeometry x="790" y="35" width="280" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="arc12" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="arc_box" source="arc1" target="arc2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arc23" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" parent="arc_box" source="arc2" target="arc3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="hole_title" value="【穴】テーマ関連の未設計箇所" style="text;html=1;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1540" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="hole1" value="・ACT5「理解できなくても愛する」の具体的行動が未設計（最重要課題）&#xa;・主人公がA男に言う「曖昧な一言」の内容&#xa;・視点ポリシーが未定義（一人称？三人称限定？視点移動あり？）&#xa;・ACT3の外的イベントがなく物語が止まって見える問題" style="rounded=1;fillColor=#FEF9E7;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1570" width="800" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>