                <mxCell id="h3" value="ACT 3 — 灘〜東大（高校〜大学）&#xa;場所：灘高校 / 東京大学" style="rounded=0;fillColor=#1B3A5C;strokeColor=#1B3A5C;fontColor=#ffffff;fontStyle=1;fontSize=10;" parent="1" vertex="1">
