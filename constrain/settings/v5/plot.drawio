                <mxCell id="h1" value="ACT 1 — 小学生（1997年生・6年春〜）&#xa;場所：三碓小学校 / 京大病院" style="rounded=0;fillColor=#1B3A5C;strokeColor=#1B3A5C;fontColor=#ffffff;fontStyle=1;fontSize=10;" parent="1" vertex="1">
