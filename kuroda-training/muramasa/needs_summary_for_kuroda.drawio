<mxGraphModel adaptiveColors="auto" dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="520">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- ===== 2ゾーン: 自走 vs 黒田 ===== -->

    <!-- 自走ゾーン（左） -->
    <mxCell id="zone_self" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;strokeWidth=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
      <mxGeometry x="30" y="50" width="350" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="zone_self_label" value="おさかな（自走）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#9E9E9E;align=center;" vertex="1" parent="1">
      <mxGeometry x="100" y="55" width="200" height="22" as="geometry"/>
    </mxCell>

    <!-- 黒田ゾーン（右） -->
    <mxCell id="zone_kuroda" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#AED581;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="470" y="50" width="380" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="zone_kuroda_label" value="黒田に頼むこと" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#2E7D32;align=center;" vertex="1" parent="1">
      <mxGeometry x="560" y="55" width="200" height="22" as="geometry"/>
    </mxCell>

    <!-- ===== 自走ゾーン内のノード ===== -->

    <mxCell id="s_write" value="書く" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#9E9E9E;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="120" y="95" width="130" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="s_learn" value="学ぶ・直す" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#9E9E9E;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="120" y="250" width="130" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="s_tools" value="AI・書籍で&lt;br&gt;知識は自分で入れる" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#BDBDBD;align=center;" vertex="1" parent="1">
      <mxGeometry x="80" y="185" width="160" height="30" as="geometry"/>
    </mxCell>

    <!-- ===== 黒田ゾーン内のノード ===== -->

    <mxCell id="k_fb" value="「なぜダメか」&lt;br&gt;を言語化" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1">
      <mxGeometry x="560" y="90" width="180" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="k_book" value="書籍処方" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="610" y="240" width="120" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="k_safe" value="壁打ち&lt;br&gt;心理的安全性" style="text;html=1;fontSize=9;fontColor=#66BB6A;align=center;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="500" y="195" width="100" height="30" as="geometry"/>
    </mxCell>

    <!-- FB→書籍処方 -->
    <mxCell id="e_fb_book" style="rounded=1;strokeColor=#66BB6A;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="k_fb" target="k_book" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== ゾーン間の矢印（交換の流れ） ===== -->

    <!-- 提出: 自走→黒田（上） -->
    <mxCell id="e_submit" value="&lt;b&gt;提出（週1）&lt;/b&gt;" style="rounded=1;strokeColor=#C62828;strokeWidth=3;fontSize=11;fontColor=#C62828;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s_write" target="k_fb" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="punish_label" value="破ったら課金" style="text;html=1;fontSize=8;fontColor=#C62828;fontStyle=2;align=center;" vertex="1" parent="1">
      <mxGeometry x="330" y="108" width="100" height="14" as="geometry"/>
    </mxCell>

    <!-- FB返却: 黒田→自走（下） -->
    <mxCell id="e_return" value="&lt;b&gt;FB + 本&lt;/b&gt;" style="rounded=1;strokeColor=#2E7D32;strokeWidth=3;fontSize=11;fontColor=#2E7D32;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="k_book" target="s_learn" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 学ぶ→書く（左辺の上向き矢印） -->
    <mxCell id="e_loop" style="rounded=1;strokeColor=#9E9E9E;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;curved=1;" edge="1" source="s_learn" target="s_write" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="70" y="260"/>
          <mxPoint x="70" y="140"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ===== ゴール ===== -->
    <mxCell id="goal" value="ゴール: 正しいFBで自走して、正しい努力ができる状態" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;fontSize=12;fontStyle=1;align=center;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="180" y="400" width="480" height="35" as="geometry"/>
    </mxCell>

    <!-- 料金メモ（小さく） -->
    <mxCell id="terms" value="料金: 月2万台まで ／ 通信: 通話対面が理想・柔軟に ／ 詳細は要相談" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#CCCCCC;align=center;" vertex="1" parent="1">
      <mxGeometry x="180" y="440" width="480" height="16" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>