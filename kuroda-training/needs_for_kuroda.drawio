    <mxCell id="submit_examples" value="プロット・構成案 ｜ サンプルシーン ｜ 修正稿 ｜ McKee理論の適用確認 ｜ 「この技法がわからない」という質問" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;fontSize=11;align=center;fontColor=#757575;" vertex="1" parent="1">
      <mxGeometry x="30" y="722" width="800" height="35" as="geometry"/>
    </mxCell>

    <!-- 不要なもの -->
    <mxCell id="not_needed" value="&lt;b&gt;✕ 不要&lt;/b&gt;: 講義・知識インプット（本で足りる）／ 汎用課題 ／ デビュー支援" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E0E0E0;fontSize=10;align=center;fontColor=#BDBDBD;" vertex="1" parent="1">
      <mxGeometry x="30" y="765" width="800" height="28" as="geometry"/>
    </mxCell>

    <!-- ゴール -->
    <mxCell id="goal" value="&lt;b style='font-size:13px'&gt;ゴール&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;正しいFBをもとに自走して&lt;br&gt;正しい努力ができる状態になること&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;fontSize=12;align=center;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="900" y="710" width="330" height="70" as="geometry"/>
